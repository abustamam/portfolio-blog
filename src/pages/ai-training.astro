---
// Public sign-up page for every track. Each track is reserved with a $25 deposit
// and launches at TRAINING.launchAt deposits; the first to launch takes the next
// slot. Counters come from TRACKS_ENDPOINT and stay hidden if it doesn't answer.
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Rosette from '../components/ai/Rosette.astro';
import WorkedExample from '../components/ai/WorkedExample.astro';
import profilePic from '../assets/profile-pic.jpeg';
import { COHORT, INCLUDED, TRACKS, TRACKS_ENDPOINT, TRAINING } from '../consts/aiCohort';
import '../styles/ai.css';

---

<BaseLayout
  title="Get AI doing real work for you — Hands-on AI cohort"
  description="Hands-on AI training in small online cohorts: Everyday AI, Connect (AI in your email and calendar) and Build (coding with AI and agents). Reserve with a refundable $25 deposit."
  chromePath="/ai-training/"
  chrome="letterhead"
>
  <main class="training">
    <!-- Hero -->
    <section class="training-hero">
      <div class="ai-wide training-hero__grid">
        <div>
          <p class="ai-kicker" data-rise style="--i:0">Hands-on AI training · online · {TRAINING.maxSeats} people at most</p>
          <h1 class="ai-title" data-rise style="--i:1">Get AI doing <em>real work</em> for you</h1>
          <p class="ai-lead" data-rise style="--i:2">
            Small, live cohorts where you bring a task from your own week and leave with AI doing it, checked and
            repeatable. Taught by a software engineer who uses AI every day.
          </p>
          <p class="training-actions" data-rise style="--i:3">
            <a class="cohort-cta" href="#tracks">See the tracks</a>
            <a class="ai-link" href="/ai-quiz/">Not sure? Take the 4-minute quiz →</a>
            <a class="ai-link" href="/ai-guides/">Free guides →</a>
          </p>
          <ul class="training-assure" data-rise style="--i:4">
            <li>{TRAINING.deposit} deposit, fully refundable</li>
            <li>4 live sessions on Google Meet</li>
            <li>Your own task, every session</li>
          </ul>
        </div>
        <div class="training-hero__piece" data-rise style="--i:3">
          <WorkedExample />
        </div>
      </div>
    </section>

    <!-- A note from the teacher -->
    <section class="training-band" id="who-teaches" aria-labelledby="who-heading">
      <div class="ai-wide training-note">
        <Image src={profilePic} alt="Rasheed Bustamam" width={176} height={176} class="training-note__photo" loading="eager" />
        <div>
          <h2 class="ai-label" id="who-heading">Who teaches it</h2>
          <p class="training-note__text">
            I'm Rasheed. I build software for a living and run AI tools every day, so I know where they help and where
            they confidently make things up. Every session is built around your work, not a textbook example.
          </p>
          <p class="training-note__text training-note__text--small">
            I spent four years as a startup's founding engineer, and I've been on two teams that were acquired. I keep
            each cohort to {TRAINING.maxSeats} people so that I can look at everyone's work myself.
          </p>
          <p class="training-note__sign">
            <span>Rasheed Bustamam</span>
            <a class="ai-link" href="/writing/hands-on-ai-cohort/">Why I'm running this →</a>
            <a class="ai-link" href="/about">More about me →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- Included -->
    <section class="ai-wide training-section" aria-labelledby="included" data-reveal>
      <p class="ai-kicker">In every track</p>
      <h2 class="ai-h2" id="included">Every track includes</h2>
      <ul class="training-included">
        {INCLUDED.map((item) => (
          <li>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4.5 10.5l3.5 3.5 7.5-8.5" /></svg>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- Tracks -->
    <section class="ai-wide training-section" aria-labelledby="tracks">
      <p class="ai-kicker">Three tracks</p>
      <h2 class="ai-h2" id="tracks">Pick your track</h2>
      <p class="ai-sub">
        Each is four sessions of {TRAINING.sessionLength}. Not sure which is yours?
        <a class="training-inline" href="/ai-quiz/">The quiz takes four minutes.</a>
      </p>
      <div class="training-tracks" id="training-tracks" data-endpoint={TRACKS_ENDPOINT} data-launch-at={TRAINING.launchAt} data-max={TRAINING.maxSeats}>
        {TRACKS.map((t) => (
          <section class="training-track ai-card" id={t.id} data-reveal>
            <header class="track-head">
              <div class="track-kicker"><span class="track-price">{t.price}</span><span class="track-meta"> · 4 sessions</span></div>
              <h3 class="track-name">{t.name}</h3>
              <p class="track-tagline">{t.tagline}</p>
              <p class="track-count" data-track={t.id} hidden></p>
            </header>

            <h4 class="ai-label">It's for you if</h4>
            <ul class="track-for">{t.forYou.map((f) => <li>{f}</li>)}</ul>

            <h4 class="ai-label">What you'll learn</h4>
            <ol class="track-sessions">
              {t.sessions.map((s, i) => (
                <li>
                  <span class="track-n" aria-hidden="true">{i + 1}</span>
                  <span class="sr-only">Session {i + 1}: </span>
                  <span><strong>{s.title}.</strong> {s.outcome}</span>
                </li>
              ))}
            </ol>

            <div class="track-leave">
              <span class="ai-label">You leave with</span>
              <p>{t.end}</p>
            </div>
            <p class="track-needs"><strong>You'll need:</strong> {t.needs}</p>

            <footer class="track-foot">
              <a class="cohort-cta" href={t.depositUrl} data-track={t.id}>Reserve {t.name} · {TRAINING.deposit}</a>
              <p class="track-small">{TRAINING.deposit} now, counted toward the {t.price} price. Fully refundable.</p>
            </footer>
          </section>
        ))}
      </div>
    </section>

    <!-- How it launches -->
    <section class="ai-wide training-section" aria-labelledby="how" data-reveal>
      <p class="ai-kicker">How it works</p>
      <h2 class="ai-h2" id="how">How a track launches</h2>
      <ol class="training-steps">
        <li>
          <span class="training-steps__n" aria-hidden="true">1</span>
          <h3>Reserve</h3>
          <p>Hold your seat with a <strong>{TRAINING.deposit} deposit</strong>. It counts toward the price.</p>
        </li>
        <li>
          <span class="training-steps__n" aria-hidden="true">2</span>
          <h3>Launch</h3>
          <p>A track launches once <strong>{TRAINING.launchAt} people</strong> reserve it. Each is capped at {TRAINING.maxSeats}.</p>
        </li>
        <li>
          <span class="training-steps__n" aria-hidden="true">3</span>
          <h3>Dates</h3>
          <p>The first track to launch takes the next open slot. Tracks run back to back, never at the same time.</p>
        </li>
        <li>
          <span class="training-steps__n" aria-hidden="true">4</span>
          <h3>Begin</h3>
          <p>When your track launches, I message you with the dates and a link for the rest of the price.</p>
        </li>
      </ol>
      <ul class="training-slots">
        {TRAINING.slots.map((s, i) => (
          <li>
            <span class="ai-label">Slot {i + 1}</span>
            <strong>{s.when}</strong>
            <span class="training-slots__note">{s.note}.</span>
          </li>
        ))}
      </ul>
      <div class="ai-seal training-guarantee">
        <Rosette draw="scroll" size={80} />
        <div>
          <h3>No risk to reserve</h3>
          <p>
            If your track doesn't launch, or the dates don't work for you, <strong>your {TRAINING.deposit} comes back in
            full</strong>. Just message me.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ai-wide training-section training-faq-wrap" aria-labelledby="faq" data-reveal>
      <div>
        <p class="ai-kicker">Before you decide</p>
        <h2 class="ai-h2" id="faq">Questions</h2>
        <p class="ai-sub">Something else? Message me. I answer every one myself.</p>
      </div>
      <div class="training-faq">
        <details>
          <summary>Is it in person?</summary>
          <p>Online, on Google Meet, in the evening ({COHORT.time}). You need a laptop or desktop, not a phone.</p>
        </details>
        <details>
          <summary>What if I miss a session?</summary>
          <p>Watch the recording, then bring your questions to office hours. Recordings go only to your cohort.</p>
        </details>
        <details>
          <summary>I'm job hunting. Is this for me?</summary>
          <p>
            Yes: take <a href="#everyday">Everyday AI</a>. Your job search becomes your weekly task: tailoring your
            résumé to a posting, cover letters, tracking applications and interview practice.
          </p>
        </details>
        <details>
          <summary>What about privacy?</summary>
          <p>
            Every track starts with what never to paste into an AI tool. We work on files with private details
            removed, and I never record the part where we work on your files.
          </p>
        </details>
        <details>
          <summary>How do I pay the rest?</summary>
          <p>When your track launches, I send you a link for the balance. Nothing else is charged until then.</p>
        </details>
        <details>
          <summary>Which track is right for me?</summary>
          <p>
            <a href="/ai-quiz/">Take the 4-minute quiz.</a> It looks at what you do with AI now, not how confident you
            feel about it. Still unsure? Message me.
          </p>
        </details>
      </div>
    </section>

    <!-- Close -->
    <section class="training-close" data-reveal>
      <div class="ai-wide">
        <Rosette draw="scroll" size={56} />
        <h2 class="ai-h2">Bring one task. Leave with it handled.</h2>
        <p class="training-actions">
          <a class="cohort-cta" href="#tracks">Pick your track</a>
          <a class="ai-link" href="/ai-quiz/">Or take the quiz first →</a>
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Fills each "N of 5 reserved" line from the live counts. Any failure leaves them hidden.
  const box = document.getElementById('training-tracks');
  const endpoint = box?.dataset.endpoint;
  const launchAt = Number(box?.dataset.launchAt ?? 5);
  const max = Number(box?.dataset.max ?? 8);
  if (box && endpoint) {
    fetch(endpoint)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((body: { counts?: Record<string, number> }) => {
        for (const el of box.querySelectorAll<HTMLElement>('.track-count')) {
          const n = body.counts?.[el.dataset.track ?? ''];
          if (typeof n !== 'number') continue;
          el.textContent =
            n >= max
              ? 'Full. Join the waitlist.'
              : n >= launchAt
                ? `Launching · ${n} of ${max} seats taken`
                : `${n} of ${launchAt} reserved to launch`;
          el.hidden = false;
          el.style.setProperty('--fill', `${Math.min(100, (n / launchAt) * 100)}%`);
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .training { scroll-behavior: smooth; }
  .training :global([id]) { scroll-margin-top: 1.5rem; }
  .training-hero {
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(60rem 28rem at 85% -10%, color-mix(in srgb, var(--color-accent) 9%, transparent), transparent 70%),
      var(--color-bg);
  }
  .training-hero__grid {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: center;
    padding-top: clamp(2.5rem, 7vw, 5.5rem); padding-bottom: clamp(2.5rem, 7vw, 5.5rem);
  }
  @media (min-width: 1024px) { .training-hero__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 30rem); gap: 4rem; } }
  .training-hero__piece { min-width: 0; }
  .training-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin: 2rem 0 0; }
  .training-assure {
    list-style: none; padding: 0; margin: 2rem 0 0; display: flex; flex-wrap: wrap; gap: .5rem 1.5rem;
    font-family: var(--font-mono); font-size: var(--text-13); color: var(--color-mute);
  }
  .training-assure li { display: inline-flex; align-items: center; gap: .5rem; }
  .training-assure li::before { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--color-accent); }

  .training-band { background: var(--color-surface); border-bottom: 1px solid var(--color-line); }
  .training-note {
    display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.5rem 2.5rem; align-items: start;
    padding-top: clamp(2rem, 5vw, 3.5rem); padding-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .training-note :global(.training-note__photo) {
    width: clamp(4.5rem, 12vw, 8rem); height: auto; aspect-ratio: 1; border-radius: 50%; object-fit: cover;
    border: 1px solid var(--color-line); box-shadow: 0 0 0 6px var(--color-bg), 0 0 0 7px var(--color-line);
  }
  .training-note__text {
    font-family: var(--font-serif); font-size: clamp(1.25rem, 2.6vw, 1.625rem); line-height: 1.4; letter-spacing: -.012em;
    color: var(--color-ink); margin: .75rem 0 0; max-width: 46rem; text-wrap: pretty;
  }
  .training-note__text--small { font-size: 1.125rem; line-height: 1.55; color: var(--color-mute); letter-spacing: 0; margin-top: 1rem; }
  .training-note__sign { display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.5rem; margin: 1.5rem 0 0; }
  .training-note__sign span { font-family: var(--font-serif); font-style: italic; font-size: 1.375rem; color: var(--color-ink); }
  @media (max-width: 560px) { .training-note { grid-template-columns: 1fr; } }

  .training-section { padding-top: clamp(3.5rem, 8vw, 6.5rem); }
  .training-inline { color: var(--color-accent); text-underline-offset: 3px; }

  .training-included {
    list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.45; color: var(--color-ink);
  }
  .training-included li { display: flex; gap: .875rem; align-items: flex-start; padding: 1rem 0; border-top: 1px solid var(--color-line-soft); }
  .training-included svg { width: 1.125rem; height: 1.125rem; flex: none; margin-top: .2rem; fill: none; stroke: var(--color-accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

  .training-tracks { display: grid; gap: 1.25rem; margin: 2.25rem 0 0; grid-template-columns: minmax(0, 1fr); align-items: stretch; }
  @media (min-width: 1080px) {
    .training-tracks { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .training-track {
    display: flex; flex-direction: column; padding: clamp(1.25rem, 2.4vw, 1.75rem); font-family: var(--font-serif); color: var(--color-ink);
    transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
  }
  .training-track:hover, .training-track:target { border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line)); }
  .training-track:hover { transform: translateY(-3px); }
  /* Subgrid: the eight parts of each card share rows, so the three cards line up part for part. */
  @media (min-width: 1080px) {
    @supports (grid-template-rows: subgrid) {
      .training-track { display: grid; grid-template-rows: subgrid; grid-row: span 8; row-gap: 0; }
    }
  }
  .track-head { padding-bottom: 1.25rem; margin-bottom: 1.25rem; border-bottom: 1px solid var(--color-line-soft); }
  .track-kicker { display: flex; align-items: baseline; gap: .25rem; }
  .track-price { font-family: var(--font-serif); font-size: clamp(2.25rem, 5vw, 2.75rem); font-weight: 500; letter-spacing: -.03em; line-height: 1; color: var(--color-ink); }
  .track-meta { font-family: var(--font-mono); font-size: var(--text-12); letter-spacing: var(--tracking-loose); text-transform: uppercase; color: var(--color-faint); }
  .track-name { font-size: 1.625rem; font-weight: 500; letter-spacing: -.015em; line-height: 1.15; margin: 1rem 0 .375rem; color: var(--color-accent); }
  .track-tagline { font-size: 1.125rem; line-height: 1.4; color: var(--color-mute); margin: 0; }
  .track-count {
    position: relative; font-family: var(--font-mono); font-size: var(--text-13); color: var(--color-ink);
    margin: 1rem 0 0; padding-bottom: .625rem;
  }
  .track-count::before, .track-count::after { content: ''; position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 2px; }
  .track-count::before { width: 100%; background: var(--color-line-soft); }
  .track-count::after { width: var(--fill, 0%); background: var(--color-accent); transition: width .9s cubic-bezier(.2, .7, .2, 1); }
  .training-track h4 { margin: 0 0 .625rem; }
  .track-for { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: .5rem; font-size: 1.0625rem; line-height: 1.45; }
  .track-for li { padding-left: 1.125rem; position: relative; }
  .track-for li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 1px; background: var(--color-accent); }
  .track-sessions { list-style: none; padding: 0; margin: 0 0 1.5rem; display: grid; gap: .875rem; font-size: 1rem; line-height: 1.45; position: relative; }
  .track-sessions::before { content: ''; position: absolute; left: .6875rem; top: .75rem; bottom: .75rem; width: 1px; background: var(--color-line); }
  .track-sessions li { display: grid; grid-template-columns: 1.375rem minmax(0, 1fr); gap: .75rem; position: relative; }
  .track-sessions strong { font-weight: 600; }
  .track-n {
    display: grid; place-items: center; width: 1.375rem; height: 1.375rem; border-radius: 50%; background: var(--color-surface);
    border: 1px solid var(--color-accent); font-family: var(--font-mono); font-size: 11px; color: var(--color-accent);
  }
  .track-leave { background: var(--color-accent-bg); border-radius: 6px; padding: .875rem 1rem; margin: 0 0 1rem; }
  .track-leave p { margin: .375rem 0 0; font-size: 1.0625rem; line-height: 1.45; color: var(--color-accent-ink); }
  .track-leave .ai-label { color: var(--color-accent-ink); opacity: .8; }
  .track-needs { font-size: .9375rem; line-height: 1.5; color: var(--color-mute); margin: 0 0 1.5rem; }
  .track-needs strong { color: var(--color-ink); font-weight: 600; }
  .track-foot { margin-top: auto; }
  .track-foot .cohort-cta { width: 100%; }
  .track-small { font-family: var(--font-mono); font-size: var(--text-12); line-height: 1.5; color: var(--color-faint); margin: .75rem 0 0; text-align: center; }

  .training-steps { list-style: none; padding: 0; margin: 2.25rem 0 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr)); counter-reset: none; }
  .training-steps li { position: relative; padding-top: 1.25rem; border-top: 1px solid var(--color-line); }
  .training-steps__n { position: absolute; top: -.8125rem; left: 0; padding-right: .75rem; background: var(--color-bg); font-family: var(--font-serif); font-style: italic; font-size: 1.375rem; line-height: 1.2; color: var(--color-accent); }
  .training-steps h3 { font-family: var(--font-serif); font-weight: 500; font-size: 1.375rem; letter-spacing: -.012em; margin: .25rem 0 .375rem; color: var(--color-ink); }
  .training-steps p { font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.5; color: var(--color-mute); margin: 0; }
  .training-steps p strong { color: var(--color-ink); font-weight: 500; }
  .training-slots { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 1px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); background: var(--color-line); border: 1px solid var(--color-line); border-radius: 8px; overflow: hidden; }
  .training-slots li { display: flex; flex-direction: column; gap: .375rem; padding: 1.125rem 1.25rem; background: var(--color-surface); font-family: var(--font-serif); }
  .training-slots strong { font-weight: 500; font-size: 1.125rem; line-height: 1.3; color: var(--color-ink); }
  .training-slots__note { font-size: .9375rem; line-height: 1.45; color: var(--color-mute); }
  .training-guarantee { margin-top: 1.5rem; }

  .training-faq-wrap { display: grid; gap: 2rem 4rem; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 900px) { .training-faq-wrap { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); } }
  .training-faq { border-top: 1px solid var(--color-line); }
  .training-faq details { border-bottom: 1px solid var(--color-line); }
  .training-faq summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; cursor: pointer; list-style: none;
    padding: 1.125rem 0; font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.3; color: var(--color-ink);
    transition: color .15s ease;
  }
  .training-faq summary::-webkit-details-marker { display: none; }
  .training-faq summary:hover { color: var(--color-accent); }
  .training-faq summary::after {
    content: ''; flex: none; width: .625rem; height: .625rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translate(-2px, -2px); transition: transform .25s ease;
  }
  .training-faq details[open] summary::after { transform: rotate(-135deg) translate(-2px, -2px); }
  .training-faq p { font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.6; color: var(--color-mute); margin: 0 0 1.25rem; max-width: 40rem; }
  .training-faq a { color: var(--color-accent); text-underline-offset: 3px; }
  @media screen and (prefers-reduced-motion: no-preference) {
    .training-faq details[open] p { animation: ai-rise .35s ease both; }
  }

  .training-close { margin-top: clamp(3.5rem, 8vw, 6.5rem); padding: clamp(3rem, 7vw, 5rem) 0; background: var(--color-surface); border-top: 1px solid var(--color-line); text-align: center; }
  .training-close :global(.ai-rosette) { margin: 0 auto 1.5rem; }
  .training-close .ai-h2 { margin-inline: auto; }
  .training-close .training-actions { justify-content: center; }
</style>
