---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Rasheed Bustamam is an applications consultant specializing in web and mobile, learning distributed systems in public."
  chromePath="/about"
>
  <div class="page-shell about-page">
    <div style="margin-bottom:28px; font-family:var(--font-mono); font-size:11px; color:var(--mute); letter-spacing:.04em;">
      <a href="/writing" style="color:var(--mute); text-decoration:none;">← /writing</a>
      <span style="margin:0 10px; color:var(--faint);">/</span>
      <span>Aug 08 2021</span>
    </div>

    <h1 style="font-family:var(--font-serif); font-size:clamp(2.5rem,6vw,4rem); font-weight:500; letter-spacing:-.028em; color:var(--ink); margin:0 0 40px;">
      About.
    </h1>

    <div class="about-grid">
      <!-- Author strip -->
      <div style="display:flex; align-items:center; gap:14px; padding-bottom:28px; border-bottom:1px solid var(--line-soft); margin-bottom:32px; grid-column:1/-1;">
        <div style="width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--ink)); display:flex; align-items:center; justify-content:center; color:var(--bg); font-family:var(--font-mono); font-weight:600; font-size:14px; flex-shrink:0;">
          RB
        </div>
        <div>
          <div style="font-family:var(--font-mono); font-size:12px; color:var(--ink); font-weight:500;">Rasheed Bustamam</div>
          <div style="font-family:var(--font-mono); font-size:11px; color:var(--faint); margin-top:2px;">independent consultant · writing since 2019</div>
        </div>
      </div>

      <!-- Prose -->
      <div class="about-prose">
        <p>
          I'm <strong>Rasheed Bustamam</strong>, an applications consultant specializing in web and mobile
          development. I run <strong>Bustamam Technology</strong>, where I help teams design and build
          web and mobile applications.
        </p>

        <p>
          This blog is where I learn distributed systems in public. I'm particularly interested in how
          the concepts behind distributed architecture—consistency models, service boundaries, failure
          modes—apply to the kinds of applications I build every day.
        </p>

        <p>
          Posts are notes from that learning process: things I've worked through, patterns that clicked,
          and trade-offs worth thinking about. If something is wrong or could be clearer, I'd genuinely
          like to know.
        </p>

        <p>
          For web and mobile consulting, visit
          <a href="https://bustamam.tech" target="_blank" rel="noreferrer">bustamam.tech</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding-top: 48px;
    padding-bottom: 80px;
    max-width: 720px;
  }

  .about-prose {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink);
  }

  .about-prose p {
    margin: 0 0 22px;
  }

  .about-prose p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: .85;
    font-weight: 500;
    padding: 6px 10px 0 0;
    color: var(--accent);
  }

  .about-prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .about-prose a {
    color: var(--accent);
  }
</style>
