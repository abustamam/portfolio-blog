---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Rasheed Bustamam is an independent software consultant based in California, specializing in web and mobile applications."
  chromePath="/about"
>
  <div class="page-shell pt-12 pb-20 max-w-2xl">
    <div class="mb-7 font-mono text-11 text-mute tracking-[.04em]">
      <a href="/" class="text-mute no-underline">← home</a>
    </div>

    <h1 class="font-serif text-[clamp(2.5rem,6vw,4rem)] font-medium tracking-[-0.028em] text-ink m-0 mb-10">
      About.
    </h1>

    <div class="flex flex-col">
      <!-- Author strip -->
      <div class="flex items-center gap-3.5 pb-7 border-b border-line-soft mb-8 col-[1/-1]">
        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-accent to-ink flex items-center justify-center text-bg font-mono font-semibold text-sm shrink-0">
          RB
        </div>
        <div>
          <div class="font-mono text-xs text-ink font-medium">Rasheed Bustamam</div>
          <div class="font-mono text-11 text-faint mt-0.5">independent consultant · writing since 2019</div>
        </div>
      </div>

      <!-- Prose -->
      <div class="about-prose font-serif text-lg leading-relaxed text-ink">
        <p>
          I'm <strong>Rasheed Bustamam</strong>, an applications consultant specializing in web and mobile
          development. I run <strong>Bustamam Technology</strong>, where I help teams design and build
          web and mobile applications.
        </p>

        <p>
          This site is where I share what I'm building and learning as an independent consultant.
          I'm particularly interested in how distributed systems concepts—consistency models,
          service boundaries, failure modes—apply to the kinds of applications I build every day.
        </p>

        <p>
          Posts are notes from that learning process: things I've worked through, patterns that clicked,
          and trade-offs worth thinking about. If something is wrong or could be clearer, I'd genuinely
          like to know.
        </p>

        <p>
          For consulting inquiries, reach out via <a href="mailto:admin@bustamam.tech">email</a> or
          through the <a href="/contact">contact page</a>.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .about-prose {
    color: var(--color-ink);
  }

  .about-prose p {
    margin: 0 0 22px;
  }

  .about-prose p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-size: 64px;
    line-height: .85;
    font-weight: 500;
    padding: 6px 10px 0 0;
    color: var(--color-accent);
  }

  .about-prose strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .about-prose a {
    color: var(--color-accent);
  }
</style>
