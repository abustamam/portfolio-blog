---
// Pre-session form for people who have paid for cohort 1. Unlisted: noindex,
// kept out of the sitemap (astro.config.mjs), and not linked from the nav.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AI_QUIZ_ENDPOINT } from '../../consts/aiQuiz';
import { INTAKE_LIMITS, INTAKE_OPTIONS } from '../../../services/ai-quiz-intake/src/intake';

// Same service and Caddy route as the quiz: POST /api/ai-quiz/intake.
const endpoint = AI_QUIZ_ENDPOINT ? `${AI_QUIZ_ENDPOINT.replace(/\/$/, '')}/intake` : '';

const sessions = ['Jan 11', 'Jan 18', 'Jan 25', 'Feb 1'];
---

<BaseLayout
  title="Cohort 1 intake — Rasheed Bustamam"
  description="Pre-session form for the hands-on AI cohort."
  chromePath="/ai-cohort/intake"
  noindex
>
  <div class="page-shell pt-10 pb-20 max-w-2xl">
    <header id="intake-intro" class="mb-8">
      <div class="font-mono text-12 text-faint tracking-caps uppercase mb-3">§ cohort 1 · before we start</div>
      <h1 class="font-serif text-[clamp(2rem,7vw,3.25rem)] font-medium tracking-[-0.028em] leading-[1.1] text-ink m-0 mb-4">
        Tell me about the task you'll bring
      </h1>
      <p class="font-serif text-lg text-mute m-0 mb-4 leading-[1.5]">
        Thanks for joining. This takes about five minutes and lets me plan each session around your real work.
        Please send it by <strong class="text-ink">Monday, January 4, 2027</strong>.
      </p>
      <p class="font-mono text-13 text-faint m-0 leading-[1.6]" id="intake-schedule">
        4 Mondays on Google Meet: {sessions.join(', ')}, 2027 · 6:30–8:00pm Pacific
      </p>
    </header>

    <noscript>
      <p class="quiz-status" data-state="warn">This form needs JavaScript. If you can't turn it on, message Rasheed on WhatsApp and he'll send you the questions.</p>
    </noscript>

    <form id="cohort-intake" class="quiz" novalidate data-endpoint={endpoint}>
      <fieldset class="quiz-step">
        <legend class="quiz-legend">Your name</legend>
        <input type="text" name="name" autocomplete="name" required maxlength={INTAKE_LIMITS.name} class="quiz-input" />
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">How should I reach you?</legend>
        <p class="quiz-hint">Your email or WhatsApp number.</p>
        <input type="text" name="contact" autocomplete="email" required maxlength={INTAKE_LIMITS.contact} class="quiz-input" />
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">The weekly task you want to work on</legend>
        <p class="quiz-hint">2–3 sentences: "Every week I do X using Y, it takes Z, and done means W."</p>
        <textarea
          name="weeklyTask"
          rows="5"
          required
          maxlength={INTAKE_LIMITS.weeklyTask}
          class="quiz-input"
          placeholder="e.g. Every week I turn the volunteer sign-up sheet into a schedule using Google Sheets and WhatsApp, it takes about an hour, and done means everyone has their slot and a reminder."
        ></textarea>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">How long does it take you now?</legend>
        <div class="quiz-options">
          {INTAKE_OPTIONS.timeTaken.map((o) => (
            <label class="quiz-option">
              <input type="radio" name="timeTaken" value={o.value} required />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">What does the task start from?</legend>
        <p class="quiz-hint">Pick all that apply.</p>
        <div class="quiz-options">
          {INTAKE_OPTIONS.inputs.map((o) => (
            <label class="quiz-option">
              <input type="checkbox" name="inputs" value={o.value} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">Which AI tools can you use, and on which plan?</legend>
        <p class="quiz-hint">Pick all that apply.</p>
        <div class="quiz-options">
          {INTAKE_OPTIONS.tools.map((o) => (
            <label class="quiz-option">
              <input type="checkbox" name="tools" value={o.value} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
        <div class="quiz-group mt-6">
          <div class="quiz-sublabel">Does your work restrict which AI tools you may use?</div>
          <div class="quiz-options">
            {INTAKE_OPTIONS.workRestricts.map((o) => (
              <label class="quiz-option">
                <input type="radio" name="workRestricts" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))}
          </div>
        </div>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">Which track feels right?</legend>
        <p class="quiz-hint">Your own pick. You can change your mind in the first session.</p>
        <div class="quiz-options">
          {INTAKE_OPTIONS.track.map((o) => (
            <label class="quiz-option">
              <input type="radio" name="track" value={o.value} required />
              <span><strong class="font-medium">{o.label}</strong>: {o.hint}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">Anything private in your files you're worried about? <span class="text-faint">(optional)</span></legend>
        <p class="quiz-hint">For example names, phone numbers or money. We'll plan around it.</p>
        <textarea name="privateConcerns" rows="3" maxlength={INTAKE_LIMITS.privateConcerns} class="quiz-input"></textarea>
      </fieldset>

      <fieldset class="quiz-step">
        <legend class="quiz-legend">Recording</legend>
        <label class="quiz-option">
          <input type="checkbox" name="recordingConsent" value="yes" required />
          <span>
            I record the teaching part of each session so you can catch up if you miss one. I stop recording before we
            work on your own files. Recordings are shared only with this group.
          </span>
        </label>
      </fieldset>

      <!-- Spam trap: hidden from people, filled by bots. -->
      <input type="text" name="website" tabindex="-1" autocomplete="off" class="quiz-trap" aria-hidden="true" />

      <p id="intake-error" class="quiz-error" role="alert" hidden></p>
      <p id="intake-status" class="quiz-status" role="status"></p>

      <div class="quiz-nav">
        <button type="submit" id="intake-submit" class="quiz-btn">Send</button>
      </div>
    </form>

    <section id="intake-thanks" class="quiz-result" hidden aria-live="polite">
      <div class="font-mono text-12 text-faint tracking-caps uppercase mb-3">§ got it</div>
      <h2 class="font-serif text-[clamp(2rem,7vw,3rem)] font-medium tracking-[-0.02em] text-ink m-0 mb-4">
        Thank you, see you January 11.
      </h2>
      <p class="font-serif text-lg leading-[1.55] text-ink m-0 mb-4">
        One more step: send Rasheed one sample file for this task on WhatsApp, in the participants' group or directly.
      </p>
      <p class="font-serif text-lg leading-[1.55] text-ink m-0">
        Remove private details first: swap real names, phone numbers, addresses and amounts for made-up ones. A few
        rows or a page is enough.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('cohort-intake') as HTMLFormElement;
  const error = document.getElementById('intake-error')!;
  const status = document.getElementById('intake-status')!;
  const submit = document.getElementById('intake-submit') as HTMLButtonElement;

  form.classList.add('js');

  const REQUIRED: [string, string][] = [
    ['name', 'your name'],
    ['contact', 'how to reach you'],
    ['weeklyTask', 'the weekly task'],
    ['timeTaken', 'how long it takes'],
    ['track', 'a track'],
  ];

  function payload() {
    const fd = new FormData(form);
    const one = (k: string) => ((fd.get(k) as string | null) ?? '').trim();
    return {
      name: one('name'),
      contact: one('contact'),
      weeklyTask: one('weeklyTask'),
      timeTaken: one('timeTaken'),
      inputs: fd.getAll('inputs') as string[],
      tools: fd.getAll('tools') as string[],
      workRestricts: one('workRestricts'),
      track: one('track'),
      privateConcerns: one('privateConcerns'),
      recordingConsent: fd.get('recordingConsent') === 'yes',
      website: (fd.get('website') as string | null) ?? '',
    };
  }

  function missing(p: ReturnType<typeof payload>): string[] {
    const out = REQUIRED.filter(([k]) => !(p as Record<string, unknown>)[k]).map(([, label]) => label);
    if (!p.recordingConsent) out.push('the recording consent');
    return out;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const p = payload();
    const gaps = missing(p);
    if (gaps.length) {
      error.textContent = `Please add ${gaps.join(', ')}.`;
      error.hidden = false;
      return;
    }
    error.hidden = true;

    const endpoint = (form.dataset.endpoint ?? '').trim();
    if (!endpoint) {
      status.textContent = "Heads up: this form isn't collecting answers here, so nothing was sent.";
      status.dataset.state = 'warn';
      return;
    }

    submit.disabled = true;
    status.textContent = 'Sending…';
    status.dataset.state = 'pending';
    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(p),
      });
      const body = await res.json().catch(() => null);
      if (!res.ok || !body?.ok) throw new Error(body?.error ?? `HTTP ${res.status}`);
      form.hidden = true;
      document.getElementById('intake-intro')!.hidden = true;
      document.getElementById('intake-thanks')!.hidden = false;
      window.scrollTo({ top: 0, behavior: 'smooth' });
    } catch (err) {
      console.error('cohort intake submit failed', err);
      status.textContent = "Your answers didn't send. Check your connection and press Send again, or message Rasheed on WhatsApp.";
      status.dataset.state = 'error';
      submit.textContent = 'Send again';
    } finally {
      submit.disabled = false;
    }
  });

  // "None yet" is exclusive with the other tools.
  form.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name !== 'tools' || !el.checked) return;
    form.querySelectorAll<HTMLInputElement>('input[name="tools"]').forEach((box) => {
      if (el.value === 'none' ? box.value !== 'none' : box.value === 'none') box.checked = false;
    });
  });
</script>

<style>
  /* Same look as /ai-quiz (its styles are scoped to that page). */
  .quiz-step {
    border: 0;
    padding: 0;
    margin: 0 0 2rem;
    min-width: 0;
  }
  .quiz-legend {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 4.5vw, 1.5rem);
    line-height: 1.3;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
    padding: 0;
  }
  .quiz-hint {
    font-family: var(--font-mono);
    font-size: var(--text-13);
    color: var(--color-faint);
    margin: 0 0 1rem;
  }
  .quiz-options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .quiz-option {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    min-height: 48px;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--color-ink);
    cursor: pointer;
  }
  .quiz-option:has(input:checked) {
    border-color: var(--color-accent);
    background: var(--color-accent-bg);
  }
  .quiz-option:has(input:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .quiz-option input {
    accent-color: var(--color-accent);
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2rem;
    flex-shrink: 0;
  }
  .quiz-group {
    margin-bottom: 1.5rem;
  }
  .quiz-sublabel {
    font-family: var(--font-mono);
    font-size: var(--text-13);
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }
  .quiz-input {
    display: block;
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 1.0625rem; /* ≥16px stops iOS zooming on focus */
    line-height: 1.45;
  }
  .quiz-input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .quiz-trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  /* One page, not steps: the button sits at the end instead of sticking over the fields. */
  .quiz-nav {
    display: flex;
    gap: 0.75rem;
    padding: 0.75rem 0 calc(0.75rem + env(safe-area-inset-bottom));
  }
  .quiz-btn {
    flex: 1;
    min-height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-13);
    letter-spacing: var(--tracking-snug);
    cursor: pointer;
  }
  .quiz-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .quiz-error {
    font-family: var(--font-mono);
    font-size: var(--text-13);
    color: var(--color-danger);
    margin: 0 0 0.75rem;
  }
  .quiz-status {
    font-family: var(--font-mono);
    font-size: var(--text-13);
    line-height: 1.5;
    padding: 0.875rem 1rem;
    border-radius: 6px;
    border: 1px solid var(--color-line);
    margin: 0 0 1rem;
  }
  .quiz-status:empty {
    display: none;
  }
  .quiz-status[data-state='warn'],
  .quiz-status[data-state='error'] {
    border-color: var(--color-danger);
    color: var(--color-danger);
  }
</style>
