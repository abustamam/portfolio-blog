---
// Cohort home: the welcome pack and the week-by-week hub on one page.
// Unlisted (noindex via CohortPage, out of the sitemap via astro.config.mjs).
import CohortPage from '../../layouts/CohortPage.astro';
import Rosette from '../../components/ai/Rosette.astro';
import { COHORT, COHORT_LINKS, SESSIONS } from '../../consts/aiCohort';

// Every date on this page comes from aiCohort.ts. Until COHORT.datesConfirmed
// is true, the page shows none of them.
const confirmed = COHORT.datesConfirmed;
const year = COHORT.intakeDue.match(/\d{4}$/)![0];
/** 'Monday, January 11' or 'Monday, January 4, 2027' -> 'January 11' */
const monthDay = (d: string) => d.replace(/^\w+, /, '').replace(/, \d{4}$/, '');
/** 'January 11' -> 'jan 11' */
const short = (d: string) => { const [m, day] = monthDay(d).split(' '); return `${m.slice(0, 3).toLowerCase()} ${day}`; };
const ordinal = (n: number) => `${n}${n % 10 === 1 && n % 100 !== 11 ? 'st' : n % 10 === 2 && n % 100 !== 12 ? 'nd' : n % 10 === 3 && n % 100 !== 13 ? 'rd' : 'th'}`;
const first = SESSIONS[0].date;
const last = SESSIONS[SESSIONS.length - 1].date;
const weekday = first.split(',')[0];
const firstDay = Number(monthDay(first).split(' ')[1]);
---

<CohortPage
  title="Welcome to the cohort"
  kicker={confirmed ? `cohort 1 · ${short(first)} – ${short(last)}, ${year}` : 'cohort 1 · dates to be confirmed'}
  lead="Assalamu alaikum, and welcome. Everything you need is on this page, and it's where each week's recording and next step will go."
>
  <div class="ai-seal cohort-confirmed">
    <Rosette draw size={80} />
    <div>
      <h2>Your seat is confirmed</h2>
      <p>I'm glad you're here. There are two small things to do before we start.</p>
      {!confirmed && <p>I'll message you the dates as soon as they're settled. Your seat is held either way.</p>}
    </div>
    <dl class="cohort-facts">
      <div><dt>When</dt><dd>{SESSIONS.length} {weekday}s, {confirmed ? `from ${monthDay(first)}` : 'dates to be confirmed'}</dd></div>
      <div><dt>Time</dt><dd>{COHORT.time}</dd></div>
      <div><dt>Where</dt><dd>{COHORT.platform}</dd></div>
      <div><dt>Group</dt><dd>Up to 8 people</dd></div>
    </dl>
  </div>

  <h2 id="before-jan-4">{confirmed ? `Before ${monthDay(COHORT.intakeDue)}` : 'Before we start'}</h2>
  <ol class="cohort-checklist" id="cohort-checklist">
    <li>
      <label>
        <input type="checkbox" data-check="pre-1" />
        <span>
      <strong>Fill in the <a href={COHORT_LINKS.intake}>intake form</a>.</strong> It takes about five minutes. Describe
      the weekly task you want to work on; I read every answer before session 1.
        </span>
      </label>
    </li>
    <li>
      <label>
        <input type="checkbox" data-check="pre-2" />
        <span>
      <strong>Send me one sample file on WhatsApp</strong> that your task uses (a spreadsheet, document, email or log),
      <strong>with private details removed first</strong>: swap real names for PERSON-1, PERSON-2 and take out account
      numbers. Not sure how? Send a description of the file instead and we'll do it together in session 2. The
      <a href={COHORT_LINKS.neverPaste}>never-paste guide</a> shows the steps.
        </span>
      </label>
    </li>
  </ol>
  <p class="cohort-checknote font-mono">Tick these off as you go. The ticks are saved on this device only.</p>


  <h2 id="what-to-have-ready">{confirmed ? `What to have ready on ${monthDay(first)}` : 'What to have ready for session 1'}</h2>
  <ul>
    <li>A laptop or desktop, not a phone. You'll be working in the tool while we talk.</li>
    <li>
      One AI tool you can log in to: Gemini, ChatGPT, Copilot or Claude. <strong>A free account is enough.</strong>
      If your employer limits which tools you may use for work files, bring that one.
    </li>
    <li>The task you described in the intake form.</li>
  </ul>
  <p>
    {confirmed
      ? "The Meet link is the same every week. It's in your calendar invite and pinned in the participants' WhatsApp group."
      : "The Meet link will be the same every week. I'll send it with the calendar invite once the dates are set."}
  </p>

  <h2 id="sessions">The four sessions</h2>
  <p>
    Every session has the same shape: 10 minutes of check-in, 25 minutes of teaching, 40 minutes of hands-on work on
    <strong>your own task</strong> while I go round the group, and 15 minutes to show what worked.
  </p>

  <ol class="cohort-sessions">
    {SESSIONS.map((s) => (
      <li id={`session-${s.n}`} data-date={confirmed ? `${monthDay(s.date)}, ${year}` : undefined}>
        <div class="font-mono session-date">Session {s.n}{confirmed && <> · {s.date}{' '}<span class="session-next" hidden>Next</span></>}</div>
        <h3>{s.title}</h3>
        <p><strong>You leave with:</strong> {s.outcome}</p>
        <p><strong>Try this week:</strong> {s.tryThis}</p>
        <p class="font-mono session-links">
          {s.handouts.map((h) => <a href={h.href}>{h.label}</a>)}
          {s.recordingUrl
            ? <a href={s.recordingUrl}>Recording</a>
            : <span class="session-pending">Recording: posted after the session</span>}
        </p>
      </li>
    ))}
  </ol>

  <h2 id="recordings">Recordings</h2>
  <p>
    I record the teaching part of each session so you can catch up if you miss one. I stop recording before we work on
    your own files. Recordings are shared only with this group, in a
    <a href={COHORT.recordingsUrl}>Google Drive folder</a> shared with your email address. If you miss a session, watch
    the recording and come to office hours for 15 minutes on your own task.
  </p>

  <h2 id="between-sessions">Between sessions</h2>
  <ul>
    <li><strong>The participants' WhatsApp group</strong>: questions between sessions, and what worked for you.</li>
    <li><strong>Office hours</strong>: an optional 30 minutes each week on the same Meet link, for anything you're stuck on.</li>
    <li>Message me directly on WhatsApp for anything private.</li>
  </ul>

  <h2 id="refunds">Refunds</h2>
  <p>
    Full refund up to {COHORT.refundUntil} if the cohort isn't for you; just message me. No refunds after that.
  </p>
  <p>JazakAllahu khair, and {confirmed ? `see you on the ${ordinal(firstDay)}.` : 'see you soon.'}<br />Rasheed</p>
</CohortPage>

<script>
  // Pre-work ticks: remembered on this device only, never sent anywhere.
  const KEY = 'cohort-1-prework';
  let saved: Record<string, boolean> = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { /* private mode: ticks just don't persist */ }
  for (const box of document.querySelectorAll<HTMLInputElement>('#cohort-checklist input[data-check]')) {
    box.checked = !!saved[box.dataset.check!];
    box.addEventListener('change', () => {
      saved[box.dataset.check!] = box.checked;
      try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch { /* ignore */ }
    });
  }

  // Mark the next session: the first whose evening hasn't passed yet.
  // Sessions carry data-date only once the dates are confirmed.
  const now = Date.now();
  const sessions = Array.from(document.querySelectorAll<HTMLElement>('.cohort-sessions > li[data-date]'));
  const next = sessions.find((li) => new Date(`${li.dataset.date} 23:59:00`).getTime() >= now);
  for (const li of sessions) {
    if (li === next) break;
    li.dataset.state = 'done';
  }
  if (next) {
    next.dataset.state = 'next';
    next.querySelector<HTMLElement>('.session-next')!.hidden = false;
  }
</script>

<style>
  .cohort-confirmed { margin: 0 0 2.5rem; }
  .cohort-confirmed h2 { margin: 0 0 .35rem; }
  .cohort-facts {
    grid-column: 1 / -1; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem;
    margin: 0; padding-top: 1.25rem; border-top: 1px solid var(--color-line);
  }
  .cohort-facts dt { font-family: var(--font-mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-faint); }
  .cohort-facts dd { margin: .25rem 0 0; font-size: 17px; line-height: 1.35; color: var(--color-ink); }

  .cohort-checklist { list-style: none; padding: 0; margin: 0 0 12px; display: grid; gap: 10px; }
  .cohort-checklist > li { margin: 0; }
  .cohort-checklist label {
    display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; padding: 16px 18px; cursor: pointer;
    border: 1px solid var(--color-line); border-radius: 8px; background: var(--color-surface); font-size: 17px; line-height: 1.55;
    transition: border-color .15s ease, background-color .15s ease;
  }
  .cohort-checklist label:hover { border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-line)); }
  .cohort-checklist label:has(input:checked) { background: var(--color-accent-bg); border-color: var(--color-accent); }
  .cohort-checklist input { width: 20px; height: 20px; margin: 4px 0 0; accent-color: var(--color-accent); }
  .cohort-checknote { font-size: 12px; color: var(--color-faint); margin: 0 0 20px; }

  .cohort-sessions { list-style: none; padding: 0; margin: 0 0 20px; }
  .cohort-sessions > li { border-top: 1px solid var(--color-line-soft); padding: 22px 0 6px; margin: 0; transition: opacity .2s ease; }
  .cohort-sessions > li[data-state='done'] { opacity: .62; }
  .cohort-sessions > li[data-state='next'] {
    border: 1px solid var(--color-accent); border-radius: 8px; padding: 20px 20px 6px; margin: 8px 0 14px; background: var(--color-surface);
  }
  .cohort-sessions > li[data-state='next'] + li { border-top: 0; }
  .cohort-sessions h3 { margin: 4px 0 10px; }
  .cohort-sessions p { margin: 0 0 10px; font-size: 17px; }
  .session-date { font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--color-accent); }
  .session-next { margin-left: 8px; padding: 2px 8px; border-radius: 999px; background: var(--color-accent); color: var(--color-bg); letter-spacing: .06em; }
  .session-links { display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 13px; }
  .session-links a { text-decoration: underline; text-underline-offset: 3px; }
  .session-pending { color: var(--color-faint); }
</style>
