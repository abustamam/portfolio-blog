---
import { getCollection } from 'astro:content';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => isPublished(data));
	return posts.map((post) => ({
		params: { slug: post.id },
	}));
}

const slug = Astro.params.slug;

const target = slug ? `/writing/${slug}/` : '/writing/';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Redirecting…</title>
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={target} />
	</head>
	<body>
		<script is:inline define:vars={{ target }}>
			location.replace(target + location.search + location.hash);
		</script>
		<noscript>
			<p>
				This page has moved to <a href={target}>{target}</a>.
			</p>
		</noscript>
	</body>
</html>
