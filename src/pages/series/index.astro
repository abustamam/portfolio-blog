---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesPosts } from '../../utils/series';
import { isPublished } from '../../utils/content';

const seriesList = (await getCollection('series', ({ data }) => isPublished(data))).sort(
	(a, b) => a.data.title.localeCompare(b.data.title),
);

const seriesWithCounts = await Promise.all(
	seriesList.map(async (s) => {
		const { posts } = await getSeriesPosts(s.id);
		return { series: s, postCount: posts.length };
	}),
);
---

<BaseLayout title="Series" description="Multi-part deep dives into distributed systems topics." chromePath="/series">
	<main>
    <div class="mb-7 font-mono text-11 text-mute tracking-[.04em]">
      <a href="/" class="text-mute no-underline">← home</a>
    </div>
		<h1>Series</h1>
		<ul class="m-0 flex list-none flex-col gap-8 p-0">
			{seriesWithCounts.map(({ series, postCount }) => (
				<li class="border-b border-line pb-8 last:border-b-0 last:pb-0">
					<a href={`/series/${series.id}/`} class="group flex gap-6 text-inherit no-underline max-sm:flex-col max-sm:gap-3">
						{series.data.heroImage && (
							<Image
								width={320}
								height={180}
								src={series.data.heroImage}
								alt=""
								class="h-[90px] w-40 shrink-0 rounded-lg object-cover max-sm:h-auto max-sm:w-full max-sm:aspect-video"
							/>
						)}
						<div class="flex-1">
							<h2 class="m-0 mb-[0.4em] text-[1.25em] leading-[1.2] text-ink transition-colors group-hover:text-accent">
								{series.data.title}
							</h2>
							<p class="m-0 mb-[0.5em] text-[0.95em] leading-[1.5] text-mute">{series.data.description}</p>
							<span class="text-[0.85em] text-faint">{postCount} {postCount === 1 ? 'post' : 'posts'}</span>
						</div>
					</a>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>
