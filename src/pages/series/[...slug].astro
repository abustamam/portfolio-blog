---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import DraftBadge from '../../components/DraftBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesPosts } from '../../utils/series';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
	const seriesList = await getCollection('series', ({ data }) => isPublished(data));
	return seriesList.map((s) => ({
		params: { slug: s.id },
		props: { series: s },
	}));
}

const { series } = Astro.props;
const { Content } = await render(series);
const { posts } = await getSeriesPosts(series.id);
---

<BaseLayout title={series.data.title} description={series.data.description} chromePath={`/series/${series.id}`}>
	<main>
		<style>
			main {
				width: 960px;
				max-width: min(960px, 100% - 2 * var(--gutter-x, 16px));
				margin: 0 auto;
				padding: 1rem var(--gutter-x, 16px);
				box-sizing: border-box;
			}
			.hero-image {
				width: 100%;
				margin-bottom: 1.5rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.series-header {
				margin-bottom: 2rem;
			}
			.series-header h1 {
				margin: 0 0 0.5em 0;
			}
			.series-description {
				color: var(--color-text);
				line-height: 1.6;
			}
			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.posts-list li {
				margin-bottom: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid rgba(var(--gray), 0.2);
			}
			.posts-list li:last-child {
				border-bottom: none;
			}
			.posts-list a {
				text-decoration: none;
				color: var(--color-heading);
			}
			.posts-list a:hover {
				color: rgb(var(--accent));
			}
			.posts-list .date {
				color: var(--color-muted);
				font-size: 0.9em;
			}
			.series-body {
				margin-bottom: 2.5rem;
				line-height: 1.7;
			}
		</style>
		{series.data.heroImage && (
			<div class="hero-image">
				<Image width={1020} height={510} src={series.data.heroImage} alt="" />
			</div>
		)}
		<section class="series-header">
			<h1>{series.data.title}</h1>
			<div class="series-description">
				{series.data.description}
			</div>
		</section>
		<div class="series-body">
			<Content />
		</div>
		<section>
			<h2>Posts in this series</h2>
			<ol class="posts-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<strong>
								<DraftBadge draft={post.data.draft} />
								{post.data.title}
							</strong>
							<p class="date">
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</p>
						</a>
					</li>
				))}
			</ol>
		</section>
	</main>
</BaseLayout>
