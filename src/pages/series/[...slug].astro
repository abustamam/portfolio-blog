---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import DraftBadge from '../../components/DraftBadge.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeriesPosts } from '../../utils/series';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
	const seriesList = await getCollection('series', ({ data }) => isPublished(data));
	return seriesList.map((s) => ({
		params: { slug: s.id },
		props: { series: s },
	}));
}

const { series } = Astro.props;
const { Content } = await render(series);
const { posts } = await getSeriesPosts(series.id);
---

<BaseLayout
	title={series.data.title}
	description={series.data.description}
	chromePath={`/series/${series.id}`}
	image={series.data.heroImage}
>
	<main class="mx-auto box-border w-[960px] max-w-[min(960px,calc(100%_-_2_*_var(--gutter-x,16px)))] px-gutter py-4">
		{series.data.heroImage && (
			<div class="mb-6 w-full">
				<Image width={1020} height={510} src={series.data.heroImage} alt="" class="mx-auto block rounded-xl shadow-soft" />
			</div>
		)}
		<section class="mb-8">
			<h1 class="m-0 mb-[0.5em]">{series.data.title}</h1>
			<div class="leading-[1.6] text-mute">
				{series.data.description}
			</div>
		</section>
		<div class="mb-10 leading-[1.7]">
			<Content />
		</div>
		<section>
			<h2>Posts in this series</h2>
			<ol class="m-0 list-none p-0">
				{posts.map((post) => (
					<li class="mb-4 border-b border-line pb-4 last:border-b-0">
						<a href={`/blog/${post.id}/`} class="text-ink no-underline hover:text-accent">
							<strong>
								<DraftBadge draft={post.data.draft} />
								{post.data.title}
							</strong>
							<p class="text-[0.9em] text-faint">
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</p>
						</a>
					</li>
				))}
			</ol>
		</section>
	</main>
</BaseLayout>
