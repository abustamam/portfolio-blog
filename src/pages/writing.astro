---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function fmtDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = new Date(date);
  return `${months[d.getMonth()]} ${String(d.getDate()).padStart(2,'0')} ${d.getFullYear()}`;
}

const rawTags = allPosts.map(p => p.data.tag).filter((t): t is string => Boolean(t));
const uniqueTags = Array.from(new Set(rawTags));
const tags = ['All', ...uniqueTags];
---

<BaseLayout
  title="Writing — Rasheed Bustamam"
  description="Long-form writing on software craft, distributed systems, and independent consulting."
  chromePath="/writing"
>
  <div class="page-shell writing-page">
    <div class="writing-header">
      <h1 style="font-family:var(--font-serif); font-size:clamp(2rem,5vw,3.5rem); font-weight:500; letter-spacing:-.028em; color:var(--ink); margin:0 0 10px;">
        Writing.
      </h1>
      <p style="font-family:var(--font-serif); font-size:18px; color:var(--mute); margin:0; line-height:1.5;">
        Notes on distributed systems, software craft, and independent consulting.
      </p>
    </div>

    <!-- Filter bar -->
    <div class="home-filter">
      <div style="display:flex; align-items:center; gap:8px; padding:6px 10px; border:1px solid var(--line); border-radius:2px; background:var(--surface); min-width:280px; flex:1; max-width:360px;">
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" style="color:var(--mute); flex-shrink:0;" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input id="search-input" placeholder="grep titles, tags, years..." style="border:none; outline:none; background:transparent; flex:1; font-family:var(--font-mono); font-size:12px; color:var(--ink); width:100%;" />
        <span style="font-family:var(--font-mono); font-size:10px; padding:2px 6px; background:var(--kbd); color:var(--mute); border-radius:2px; flex-shrink:0;">/</span>
      </div>
      <div style="height:18px; width:1px; background:var(--line);"></div>
      <div id="tag-filters" style="display:flex; gap:6px; flex-wrap:wrap;">
        {tags.map((tag, i) => (
          <button
            data-tag={tag}
            class="tag-pill"
            style={`font-family:var(--font-mono); font-size:11px; letter-spacing:.02em; padding:5px 10px; border-radius:2px; cursor:pointer; border:1px solid ${i === 0 ? 'var(--ink)' : 'var(--line)'}; background:${i === 0 ? 'var(--ink)' : 'transparent'}; color:${i === 0 ? 'var(--bg)' : 'var(--mute)'};`}
          >
            {tag.toLowerCase()}
          </button>
        ))}
      </div>
      <div class="home-filter__sort">
        sort: <span style="color:var(--ink);">recent ↓</span>
      </div>
    </div>

    <!-- Column headers -->
    <div class="post-list-header">
      <div>№</div><div>date</div><div>title · dek</div><div>tag</div><div style="text-align:right;">length</div><div></div>
    </div>

    <!-- Post list -->
    <div id="post-list">
      {allPosts.map((post, i) => (
        <a
          href={`/blog/${post.id}/`}
          class="post-row"
          data-title={post.data.title.toLowerCase()}
          data-tag={post.data.tag ?? ''}
          data-kind={post.data.kind ?? ''}
          style={`background:${i === 0 ? 'var(--surface)' : 'transparent'};`}
        >
          <div class="post-row__idx" style="font-family:var(--font-mono); font-size:11px; color:var(--faint); letter-spacing:.05em; font-variant-numeric:tabular-nums;">
            {String(i + 1).padStart(3, '0')}
          </div>
          <div class="post-row__date" style="font-family:var(--font-mono); font-size:11px; color:var(--mute); font-variant-numeric:tabular-nums;">
            {fmtDate(post.data.pubDate)}
          </div>
          <div class="post-row__main">
            <div class="post-row__title" style="margin:0; font-family:var(--font-serif); font-size:23px; line-height:1.15; font-weight:500; color:var(--ink); letter-spacing:-.012em;">
              {post.data.title}
            </div>
            <div class="post-row__dek">
              {post.data.dek ?? post.data.description}
            </div>
            <div class="post-row__compact-meta">
              {fmtDate(post.data.pubDate)}
              {post.data.tag && ` · ${post.data.tag}`}
              {post.data.readMin != null && ` · ${post.data.readMin} min`}
              {post.data.words != null && (
                <span class="post-row__words"> · {post.data.words.toLocaleString()} w</span>
              )}
            </div>
          </div>
          <div class="post-row__tag" style="font-family:var(--font-mono); font-size:11px; color:var(--mute);">
            {post.data.tag && (
              <span style="padding:2px 7px; border:1px solid var(--line); color:var(--ink); border-radius:2px; letter-spacing:.04em; font-size:10px; text-transform:uppercase;">
                {post.data.tag}
              </span>
            )}
          </div>
          <div class="post-row__len" style="font-family:var(--font-mono); font-size:11px; display:flex; flex-direction:column; align-items:flex-end; gap:2px; text-align:right; font-variant-numeric:tabular-nums;">
            {post.data.readMin && <span style="color:var(--ink);">{post.data.readMin} min</span>}
            {post.data.words && <span style="color:var(--faint);">{post.data.words.toLocaleString()} w</span>}
          </div>
          <div class="post-row__arrow post-arrow" style="color:var(--faint); font-family:var(--font-mono); font-size:14px; align-self:center; text-align:right;">→</div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .writing-page {
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .writing-header {
    margin-bottom: 40px;
  }
</style>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const tagPills = document.querySelectorAll<HTMLButtonElement>('.tag-pill');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.post-row');
  const mqRows = window.matchMedia('(min-width: 1024px)');

  let activeTag = 'All';

  function rowLayoutDisplay() {
    return mqRows.matches ? 'grid' : 'flex';
  }

  function filterPosts() {
    const q = searchInput ? searchInput.value.toLowerCase() : '';
    rows.forEach(row => {
      const titleMatch = !q || (row.dataset.title ?? '').includes(q);
      const tagMatch = activeTag === 'All'
        || row.dataset.tag === activeTag
        || row.dataset.kind === activeTag;
      (row as HTMLElement).style.display = (titleMatch && tagMatch) ? rowLayoutDisplay() : 'none';
    });
  }

  mqRows.addEventListener('change', filterPosts);

  try {
    if (sessionStorage.getItem('journal:focus-search')) {
      sessionStorage.removeItem('journal:focus-search');
      queueMicrotask(() => searchInput?.focus());
    }
  } catch {
    /* private mode */
  }

  tagPills.forEach(pill => {
    pill.addEventListener('click', () => {
      activeTag = pill.dataset.tag ?? 'All';
      tagPills.forEach(p => {
        const on = p.dataset.tag === activeTag;
        p.style.border = `1px solid ${on ? 'var(--ink)' : 'var(--line)'}`;
        p.style.background = on ? 'var(--ink)' : 'transparent';
        p.style.color = on ? 'var(--bg)' : 'var(--mute)';
      });
      filterPosts();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', filterPosts);
  }

  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (!searchInput) return;
    const focused = document.activeElement;
    if (e.key === '/' && focused !== searchInput) {
      e.preventDefault();
      searchInput.focus();
    }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      searchInput.focus();
    }
  });
</script>
