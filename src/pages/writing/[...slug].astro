---
import { type CollectionEntry, getEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { getSeriesPosts } from '../../utils/series';
import { isPublished } from '../../utils/content';

export async function getStaticPaths() {
	const posts = await getCollection('writing', ({ data }) => isPublished(data));
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'writing'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Compute word count and reading time from markdown body
// Simple approach: strip frontmatter, count everything else (code is still content)
const bodyText = post.body ?? '';
const contentWithoutFrontmatter = bodyText.replace(/^---[\s\S]*?---/, '').trim();
const computedWords = contentWithoutFrontmatter.split(/\s+/).length;
const computedReadMin = Math.max(1, Math.ceil(computedWords / 200));

// This route intentionally has no page-scoped styles; BlogPost handles presentation.
let series: { id: string; title: string } | undefined;
let prevPost: { id: string; title: string } | null = null;
let nextPost: { id: string; title: string } | null = null;

if (post.data.series) {
	const seriesEntry = await getEntry('series', post.data.series);
	if (seriesEntry) {
		series = { id: seriesEntry.id, title: seriesEntry.data.title };
		const { getPrevNext } = await getSeriesPosts(post.data.series);
		const nav = getPrevNext(post.id);
		prevPost = nav.prev;
		nextPost = nav.next;
	}
}
---

<BlogPost
	{...post.data}
	readMin={computedReadMin}
	words={computedWords}
	slug={post.id}
	headings={headings}
	{series}
	prevPost={prevPost}
	nextPost={nextPost}
>
	<Content />
</BlogPost>
