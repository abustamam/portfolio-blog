---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkSection from '../../components/WorkSection.astro';

const allWork = await getCollection('work', ({ data }) => !data.draft);

// Sort by startDate descending, with order as tiebreaker
allWork.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});

const employment = allWork.filter((e) => e.data.type === 'employment');
const consulting = allWork.filter((e) => e.data.type === 'consulting');
---

<BaseLayout title="Work" description="A record of consulting engagements and employment — what I built, where, and with whom." chromePath="/work">
  <main class="page-shell pt-12 pb-20">
    <div class="mb-7 font-mono text-11 text-mute tracking-[.04em]">
      <a href="/" class="text-mute no-underline">← home</a>
    </div>
    <header class="mb-12">
      <h1 class="font-serif text-[clamp(2rem,5vw,3rem)] font-medium tracking-tight text-ink m-0 mb-3">Work</h1>
      <p class="font-serif text-lg text-mute leading-relaxed m-0 max-w-md">
        A record of consulting engagements and employment — what I built, where, and with whom.
      </p>
    </header>

    {employment.length > 0 && (
      <WorkSection
        title="§ Employment"
        entries={employment}
        indexOffset={0}
      />
    )}

    {consulting.length > 0 && (
      <WorkSection
        title="§ Consulting"
        entries={consulting}
        indexOffset={employment.length}
      />
    )}
  </main>
</BaseLayout>
