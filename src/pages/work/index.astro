---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkSection from '../../components/WorkSection.astro';

const allWork = await getCollection('work', ({ data }) => !data.draft);

// Sort by startDate descending, with order as tiebreaker
allWork.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  return b.data.startDate.getTime() - a.data.startDate.getTime();
});

const employment = allWork.filter((e) => e.data.type === 'employment');
const consulting = allWork.filter((e) => e.data.type === 'consulting');
---

<BaseLayout title="Work" description="A record of consulting engagements and employment — what I built, where, and with whom." chromePath="/work">
  <main class="work-index">
    <header class="work-index__header animate-fade-up" style="--delay:0">
      <h1 class="work-index__title">Work</h1>
      <p class="work-index__dek">
        A record of consulting engagements and employment — what I built, where, and with whom.
      </p>
    </header>

    {employment.length > 0 && (
      <WorkSection
        title="§ Employment"
        entries={employment}
        animated={true}
        indexOffset={0}
      />
    )}

    {consulting.length > 0 && (
      <WorkSection
        title="§ Consulting"
        entries={consulting}
        animated={true}
        indexOffset={employment.length}
      />
    )}
  </main>
</BaseLayout>

<style>
  .work-index {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem 4rem;
  }
  .work-index__header {
    margin-bottom: 3rem;
  }
  .work-index__title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }
  .work-index__dek {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--mute);
    line-height: 1.6;
    margin: 0;
    max-width: 520px;
  }
  @media (max-width: 639px) {
    .work-index {
      padding: 2rem 1.25rem 3rem;
    }
  }
</style>
