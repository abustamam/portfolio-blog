---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: entry,
  }));
}

type Props = CollectionEntry<'work'>;

const entry = Astro.props;
const { Content } = await render(entry);

const {
  company, projectName, role, type, period, location,
  companyMission, skills, logo, darkLogo, badges, additionalRoles,
} = entry.data;

const badgeLabels: Record<string, string> = {
  acquired: 'acquired',
  zeroToOne: '0→1',
};
---

<BaseLayout
  title={`${company}${projectName ? ` · ${projectName}` : ''} — Work`}
  description={`${role} at ${company}. ${period}.`}
  chromePath="/work"
  image={logo}
>
  <main class="max-w-4xl mx-auto px-8 pt-10 pb-16 max-[700px]:px-5 max-[700px]:pt-6 max-[700px]:pb-12">
    <!-- Back link -->
    <nav>
      <a href="/work/" class="font-mono text-11 text-mute no-underline tracking-snug inline-block mb-8 hover:text-ink">← Work</a>
    </nav>

    <div class="grid grid-cols-[1fr_220px] gap-12 items-start max-[700px]:grid-cols-1 max-[700px]:gap-8">
      <!-- Main content -->
      <article>
        <header class="flex items-center gap-4 mb-6 animate-fade-up" style="--delay:0">
          {logo && (
            <div class="shrink-0">
              <Image
                src={logo}
                alt={`${company} logo`}
                width={56}
                height={56}
                class:list={['w-14 h-14 object-contain rounded-md', darkLogo && 'dark:invert dark:brightness-200']}
              />
            </div>
          )}
          <div>
            <h1 class="font-serif text-[clamp(1.5rem,4vw,2rem)] font-medium tracking-tight text-ink m-0 mb-1">
              {company}
              {projectName && <span class="font-normal text-mute"> · {projectName}</span>}
            </h1>
            <div class="font-mono text-xs text-mute tracking-snug">{role}</div>
          </div>
        </header>

        {companyMission && (
          <blockquote class="font-serif text-base italic text-mute border-l-3 border-accent m-0 mb-6 py-2 pl-4 leading-relaxed animate-fade-up" style="--delay:80">
            {companyMission}
          </blockquote>
        )}

        <div class="font-serif text-base leading-[1.7] text-ink animate-fade-up [&_p]:m-0 [&_p]:mb-4" style="--delay:160">
          <Content />
        </div>

        {additionalRoles && additionalRoles.length > 0 && (
          <section class="mt-8 border-t border-line pt-6 animate-fade-up" style="--delay:240">
            <h2 class="font-mono text-11 font-normal text-faint tracking-caps uppercase m-0 mb-4">Additional Roles</h2>
            {additionalRoles.map((r) => (
              <div class="mb-5">
                <div class="flex items-baseline gap-3 mb-1">
                  <span class="font-sans text-sm font-semibold text-ink">{r.role}</span>
                  <span class="font-mono text-11 text-faint">{r.period}</span>
                </div>
                <p class="font-serif text-sm text-mute leading-relaxed m-0">{r.description}</p>
              </div>
            ))}
          </section>
        )}
      </article>

      <!-- Sidebar -->
      <aside class="sticky top-8 animate-fade-up max-[700px]:static max-[700px]:order-[-1]" style="--delay:80">
        <dl class="border border-line rounded-[3px] py-4 px-[18px] bg-surface">
          <div class="py-2 border-b border-line-soft first:pt-0 last:border-b-0 last:pb-0">
            <dt class="font-mono text-10 tracking-[0.1em] uppercase text-faint mb-1">Period</dt>
            <dd class="font-mono text-xs text-ink m-0">{period}</dd>
          </div>

          {location && (
            <div class="py-2 border-b border-line-soft first:pt-0 last:border-b-0 last:pb-0">
              <dt class="font-mono text-10 tracking-[0.1em] uppercase text-faint mb-1">Location</dt>
              <dd class="font-mono text-xs text-ink m-0">{location}</dd>
            </div>
          )}

          <div class="py-2 border-b border-line-soft first:pt-0 last:border-b-0 last:pb-0">
            <dt class="font-mono text-10 tracking-[0.1em] uppercase text-faint mb-1">Type</dt>
            <dd class="font-mono text-xs text-ink m-0 capitalize">{type}</dd>
          </div>

          {badges.length > 0 && (
            <div class="py-2 border-b border-line-soft first:pt-0 last:border-b-0 last:pb-0">
              <dt class="font-mono text-10 tracking-[0.1em] uppercase text-faint mb-1">Badges</dt>
              <dd class="flex flex-wrap gap-1.25 mt-1 m-0">
                {badges.map((b) => (
                  <span class="font-mono text-10 tracking-loose uppercase py-0.5 px-1.75 rounded-sm bg-accent-bg text-accent-ink border border-accent">{badgeLabels[b] ?? b}</span>
                ))}
              </dd>
            </div>
          )}

          {skills.length > 0 && (
            <div class="py-2 border-b border-line-soft first:pt-0 last:border-b-0 last:pb-0">
              <dt class="font-mono text-10 tracking-[0.1em] uppercase text-faint mb-1">Skills</dt>
              <dd class="flex flex-wrap gap-1.25 mt-1 m-0">
                {skills.map((s) => (
                  <span class="font-mono text-10 text-mute bg-bg border border-line rounded-sm py-0.5 px-1.75 tracking-snug">{s}</span>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </aside>
    </div>
  </main>
</BaseLayout>
