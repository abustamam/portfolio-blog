---
// Outcome figures. Underscore prefix keeps this out of routing.
// A figure with a `source` always shows its source link beside it.
import type { CollectionEntry } from 'astro:content';

interface Props {
  metrics: NonNullable<CollectionEntry<'work'>['data']['metrics']>;
  size?: 'lg' | 'md';
}

const { metrics, size = 'lg' } = Astro.props;
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---

<dl class:list={[
  'grid gap-px bg-line border border-line rounded-[3px] overflow-hidden m-0',
  metrics.length >= 3 ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-1 sm:grid-cols-2',
]} data-metrics>
  {metrics.map((m) => (
    <div class="bg-surface py-4 px-5 flex flex-col" data-metric>
      <dt class="order-2 mt-2 font-mono text-11 text-mute tracking-snug leading-snug">{m.label}</dt>
      <dd class:list={[
        'order-1 m-0 font-serif font-medium tracking-tight text-ink leading-none tabular-nums',
        size === 'lg' ? 'text-[clamp(2.25rem,6vw,3.25rem)]' : 'text-[2rem]',
      ]}>{m.value}</dd>
      {m.source && (
        <dd class="order-3 m-0 mt-2">
          <a
            href={m.source}
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-10 tracking-loose uppercase text-accent-ink underline decoration-accent underline-offset-2"
            data-metric-source
          >
            source: {m.sourceLabel ?? hostOf(m.source)} ↗
          </a>
        </dd>
      )}
    </div>
  ))}
</dl>
