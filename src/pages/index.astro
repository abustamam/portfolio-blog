---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import AvailabilityCard from '../components/AvailabilityCard.astro';
import TerminalWidget from '../components/TerminalWidget.astro';
import profilePic from '../assets/profile-pic.jpeg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredWork = (await getCollection('work', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return b.data.startDate.getTime() - a.data.startDate.getTime();
  });

const benchmarkPost = '/writing/six-ways-i-fooled-myself-benchmarking/';

// The hero terminal replays these commands. Each one is a real command, so a
// visitor who types it gets the same output.
const heroScript = ['whoami', 'offers', 'capacity', 'start-here'];

const proof = [
  {
    label: 'zero to one',
    body: 'Founding engineer at Edvo for four years: web app, browser extension and Electron, from nothing to shipped.',
  },
  {
    label: 'acquired · cdk global',
    body: 'At Salty through its acquisition by CDK Global (about $150M), then promoted to Staff Engineer, leading three automation engineers.',
    note: 'Deal value: S&P Capital IQ, via MarketScreener.',
  },
  {
    label: 'acquired · xyo',
    body: 'Part of the four-person LayerOne team that XYO acquired in 2018.',
  },
  {
    label: 'measured ai',
    body: 'I write about measuring AI tooling, including the six ways I nearly fooled myself benchmarking one.',
    href: benchmarkPost,
  },
];

const offers = [
  {
    title: 'Fractional founding engineer',
    body: 'A set number of hours each week inside your team. I make the early technical calls, write the code that sets the patterns, and leave a codebase your next hires can pick up.',
  },
  {
    title: 'Technical advisory',
    body: 'Architecture, hiring and roadmap. A standing call plus async review for the founder or CTO who wants a second senior opinion before the expensive decisions.',
  },
  {
    title: 'Scoped zero-to-one builds',
    body: 'A first version with a fixed scope and a clear end: a prototype, an MVP, or one hard subsystem. I build it, document it, and hand it over.',
  },
  {
    title: 'AI-assisted delivery, measured',
    body: 'I set up AI coding tools in your workflow and measure whether they help, against your own history, before anyone calls it a win.',
    href: benchmarkPost,
    linkText: 'how I measure →',
  },
];
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  chromePath="/"
>

  <!-- Hero -->
  <section class="px-gutter pt-10 pb-12 md:pt-16 md:pb-16 border-b border-line" aria-labelledby="hero-heading">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,29rem)] gap-10 lg:gap-14 items-center">
      <div class="min-w-0">
        <div class="flex items-center gap-4 mb-8">
          <img
            src={profilePic.src}
            alt="Rasheed Bustamam"
            width="56"
            height="56"
            class="w-14 h-14 rounded-full object-cover border border-line"
            loading="eager"
          />
          <div>
            <div class="font-serif text-xl font-medium text-ink tracking-tight">Rasheed Bustamam</div>
            <div class="inline-flex items-center gap-2 mt-1.5 py-1 px-2.5 bg-accent-bg text-accent-ink rounded-sm font-mono text-10 tracking-loose uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              a few engagements at a time
            </div>
          </div>
        </div>
        <p class="font-mono text-10 text-faint tracking-caps uppercase m-0 mb-4">§ for founders &amp; CTOs of funded startups</p>
        <h1 id="hero-heading" class="display-hero font-serif font-medium m-0 text-ink tracking-tight max-w-2xl [text-wrap:balance]">
          Founding-engineer judgment, <em class="italic text-accent font-medium">a few hours a week.</em>
        </h1>
        <p class="mt-6.5 max-w-[560px] font-serif text-lg leading-[1.55] text-mute">
          I'm a fractional founding engineer and technical advisor. I help funded startups make
          the early technical calls (architecture, hiring, roadmap) and build the first versions
          the rest of the company stands on. I keep a full-time role, so I take on a few
          engagements at a time.
        </p>
        <div class="flex flex-wrap gap-3.5 mt-8">
          <a
            href="mailto:admin@bustamam.tech"
            class="bg-black text-white border border-black dark:bg-white dark:text-black dark:border-white py-2.25 px-4 rounded-sm font-mono text-xs tracking-snug no-underline"
          >
            $ start a conversation →
          </a>
          <a
            href="/work"
            class="bg-transparent text-ink border border-line py-2.25 px-4 rounded-sm font-mono text-xs tracking-snug no-underline"
          >
            $ see my work →
          </a>
        </div>
      </div>

      <div class="min-w-0">
        <TerminalWidget
          script={heroScript}
          outputClass="h-[22rem]"
          label="Terminal: a short introduction you can also type into"
        />
        <p class="mt-2.5 font-mono text-10 text-faint tracking-snug m-0">
          simulated shell · tap it and type <span class="text-mute">help</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="px-gutter py-10 border-b border-line bg-surface" aria-label="Track record">
    <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7">
      {proof.map((item) => (
        <li class="min-w-0">
          <div class="font-mono text-10 text-accent-ink tracking-caps uppercase mb-2">{item.label}</div>
          <p class="font-serif text-base text-ink leading-snug m-0">
            {item.href
              ? <a href={item.href} class="text-ink underline decoration-line underline-offset-3 hover:decoration-accent">{item.body}</a>
              : item.body}
          </p>
          {item.note && <p class="font-mono text-10 text-faint mt-1.5 m-0">{item.note}</p>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Offers -->
  <section class="px-gutter py-12 border-b border-line" aria-labelledby="offers-heading">
    <h2 id="offers-heading" class="font-mono text-10 text-faint tracking-caps uppercase font-normal m-0 mb-8">§ how i can help</h2>
    <ol class="list-none m-0 p-0 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-9">
      {offers.map((offer, i) => (
        <li class="min-w-0 border-t border-line-soft pt-4">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-lg font-medium text-ink m-0">{offer.title}</h3>
          </div>
          <p class="font-serif text-base text-mute leading-relaxed m-0 max-w-[34rem]">
            {offer.body}
          </p>
          {offer.href && (
            <a href={offer.href} class="inline-block mt-2.5 font-mono text-11 text-mute no-underline hover:text-ink">{offer.linkText}</a>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- Selected Work -->
  {featuredWork.length > 0 && (
    <section class="px-gutter py-12 border-b border-line">
      <div class="flex items-center justify-between mb-6">
        <div class="font-mono text-10 text-faint tracking-caps uppercase">§ selected work</div>
        <a href="/work" class="font-mono text-11 text-mute no-underline">view all work →</a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:[grid-template-columns:repeat(auto-fill,minmax(300px,1fr))]">
        {featuredWork.map((entry, i) => (
          <WorkCard entry={entry} index={i} />
        ))}
      </div>
    </section>
  )}

  <!-- Availability CTA -->
  <AvailabilityCard />

</BaseLayout>
