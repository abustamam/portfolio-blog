---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import AvailabilityCard from '../components/AvailabilityCard.astro';
import TerminalWidget from '../components/TerminalWidget.astro';
import profilePic from '../assets/profile-pic.jpeg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const featuredWork = (await getCollection('work', ({ data }) => data.featured && !data.draft))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return b.data.startDate.getTime() - a.data.startDate.getTime();
  });

const benchmarkPost = '/writing/six-ways-i-fooled-myself-benchmarking/';

// The hero terminal replays these commands. Each one is a real command, so a
// visitor who types it gets the same output.
const heroScript = ['whoami', 'offers', 'capacity', 'start-here'];

const proof = [
  {
    label: '2020–24',
    body: 'Founding engineer at Edvo. I built the web app, the browser extension and the desktop app.',
  },
  {
    label: '2021–23',
    body: 'I joined Salty right before CDK Global bought it for about $150M. I stayed, made Staff, and ran a team of three.',
    note: 'Deal value: S&P Capital IQ, via MarketScreener.',
  },
  {
    label: '2018',
    body: 'One of four people at LayerOne. XYO bought the company that July.',
  },
  {
    label: 'writing',
    body: 'Six ways I nearly fooled myself benchmarking an AI tool.',
    href: benchmarkPost,
  },
];

const offers = [
  {
    title: 'Fractional founding engineer',
    body: 'A fixed number of hours a week on your team. I make the early architecture calls and write the first version of the hard parts.',
  },
  {
    title: 'Technical advisory',
    body: 'A regular call, plus review in between. Good for a technical founder who wants a second opinion before committing to something expensive.',
  },
  {
    title: 'Scoped zero-to-one builds',
    body: 'One prototype, MVP or subsystem, with an end date. You keep the code and the docs.',
  },
  {
    title: 'AI coding tools that earn their keep',
    body: "I set up AI coding tools for your team, then check whether they're helping. I've been wrong about that before, and wrote it up.",
    href: benchmarkPost,
    linkText: 'the write-up →',
  },
];
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_DESCRIPTION}
  chromePath="/"
>

  <!-- Hero -->
  <section class="px-gutter pt-10 pb-12 md:pt-16 md:pb-16 border-b border-line" aria-labelledby="hero-heading">
    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,29rem)] gap-10 lg:gap-14 items-center">
      <div class="min-w-0">
        <div class="flex items-center gap-4 mb-8">
          <img
            src={profilePic.src}
            alt="Rasheed Bustamam"
            width="56"
            height="56"
            class="w-14 h-14 rounded-full object-cover border border-line"
            loading="eager"
          />
          <div>
            <div class="font-serif text-xl font-medium text-ink tracking-tight">Rasheed Bustamam</div>
            <div class="inline-flex items-center gap-2 mt-1.5 py-1 px-2.5 bg-accent-bg text-accent-ink rounded-sm font-mono text-12 tracking-loose uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              California · remote
            </div>
          </div>
        </div>
        <h1 id="hero-heading" class="display-hero font-serif font-medium m-0 text-ink tracking-tight max-w-2xl [text-wrap:balance]">
          I've been the first engineer. <em class="italic text-accent font-medium">Now I do it part-time.</em>
        </h1>
        <p class="mt-6.5 max-w-[560px] font-serif text-lg leading-[1.55] text-mute">
          I spent four years as a startup's founding engineer, and I've been on two teams that
          got acquired. I have a day job now, so I work with a few startups at a time, a few
          hours a week each: making the early architecture calls, reviewing code, and building
          the parts nobody on the team has built before.
        </p>
        <div class="flex flex-wrap gap-3.5 mt-8">
          <a
            href="mailto:admin@bustamam.tech"
            class="bg-ink text-bg border border-ink transition-colors duration-150 hover:bg-accent hover:border-accent py-2.25 px-4 rounded-sm font-mono text-xs tracking-snug no-underline"
          >
            $ start a conversation →
          </a>
          <a
            href="/work"
            class="bg-transparent text-ink border border-line transition-colors duration-150 hover:border-ink py-2.25 px-4 rounded-sm font-mono text-xs tracking-snug no-underline"
          >
            $ see my work →
          </a>
        </div>
      </div>

      <div class="min-w-0">
        <TerminalWidget
          script={heroScript}
          outputClass="h-[22rem]"
          label="Terminal: a short introduction you can also type into"
        />
        <p class="mt-2.5 font-mono text-12 text-faint tracking-snug m-0">
          simulated shell · tap it and type <span class="text-mute">help</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="px-gutter py-10 border-b border-line bg-surface" aria-label="Track record">
    <ul class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-7">
      {proof.map((item) => (
        <li class="min-w-0">
          <div class="font-mono text-12 text-accent-ink tracking-caps uppercase mb-2">{item.label}</div>
          <p class="font-serif text-base text-ink leading-snug m-0">
            {item.href
              ? <a href={item.href} class="text-ink underline decoration-line underline-offset-3 hover:decoration-accent">{item.body}</a>
              : item.body}
          </p>
          {item.note && <p class="font-mono text-12 text-faint mt-1.5 m-0">{item.note}</p>}
        </li>
      ))}
    </ul>
  </section>

  <!-- Offers -->
  <section class="px-gutter py-12 border-b border-line" aria-labelledby="offers-heading">
    <h2 id="offers-heading" class="font-mono text-12 text-faint tracking-caps uppercase font-normal m-0 mb-8">§ what you can hire me for</h2>
    <ol class="list-none m-0 p-0 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-9">
      {offers.map((offer, i) => (
        <li class="min-w-0 border-t border-line-soft pt-4">
          <div class="flex items-baseline gap-3 mb-2">
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-serif text-lg font-medium text-ink m-0">{offer.title}</h3>
          </div>
          <p class="font-serif text-base text-mute leading-relaxed m-0 max-w-[34rem]">
            {offer.body}
          </p>
          {offer.href && (
            <a href={offer.href} class="inline-block mt-2.5 font-mono text-13 text-mute no-underline hover:text-ink">{offer.linkText}</a>
          )}
        </li>
      ))}
    </ol>
    <p class="mt-10 pt-5 border-t border-line-soft font-serif text-base text-mute m-0">
      Not hiring an engineer? I also teach small, hands-on AI cohorts for people who don't code.
      <a href="/ai-training/" class="font-mono text-13 text-accent no-underline hover:underline whitespace-nowrap">see the training →</a>
    </p>
  </section>

  <!-- Selected Work -->
  {featuredWork.length > 0 && (
    <section class="px-gutter py-12 border-b border-line">
      <div class="flex items-center justify-between mb-6">
        <div class="font-mono text-12 text-faint tracking-caps uppercase">§ selected work</div>
        <a href="/work" class="font-mono text-13 text-mute no-underline">view all work →</a>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:[grid-template-columns:repeat(auto-fill,minmax(300px,1fr))]">
        {featuredWork.map((entry, i) => (
          <WorkCard entry={entry} index={i} />
        ))}
      </div>
    </section>
  )}

  <!-- Availability CTA -->
  <AvailabilityCard />

</BaseLayout>
