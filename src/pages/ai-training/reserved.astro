---
// Where the three $25 deposit payment links send people after they pay. Unlisted:
// noindex, out of the sitemap, not in the nav. Works with no ?track= and with
// JavaScript off (generic content, true for every track); the script below fits it to
// ?track=everyday|connect|build. Everyday AI is confirmed; Connect and Build launch at 5 deposits.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Rosette from '../../components/ai/Rosette.astro';
import { COHORT, COHORT_LINKS, TRACKS, TRACKS_ENDPOINT, TRAINING } from '../../consts/aiCohort';
import { GENERIC_GUIDES, RESERVED_CONTACT, SHARE_URL, TRACK_GUIDES } from '../../consts/aiReserved';
import { WHATSAPP_HREF } from '../../consts/aiQuiz';
import '../../styles/ai.css';

const names = TRACKS.map((t) => t.name);
const trackList = `${names.slice(0, -1).join(', ')} and ${names[names.length - 1]}`;
const everyday = TRACKS.find((t) => t.id === 'everyday')!.confirmed!;
const shareText = `I reserved a seat in a small hands-on AI course, up to ${TRAINING.maxSeats} people a track. Come along: ${SHARE_URL}`;
// "Message me" opens WhatsApp through the intake service's redirect; email in dev builds.
const messageMe = WHATSAPP_HREF
  ? { href: WHATSAPP_HREF, target: '_blank', rel: 'noopener nofollow' }
  : { href: RESERVED_CONTACT.mailto };
const shareHref = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<BaseLayout
  title="Your seat is reserved — Rasheed Bustamam"
  description="Thank you for reserving a seat in the hands-on AI cohort."
  chromePath="/ai-training/reserved"
  noindex
  chrome="letterhead"
>
  <main class="ai-shell reserved" id="reserved" data-endpoint={TRACKS_ENDPOINT} data-confirmed={TRACKS.find((t) => t.confirmed)?.id} data-launch-at={TRAINING.launchAt} data-max={TRAINING.maxSeats} data-waitlist={COHORT_LINKS.waitlist}>
    <header class="mb-8">
      <div class="ai-kicker" data-rise style="--i:0">hands-on AI cohort · deposit received</div>
      <h1 class="ai-title ai-title--page" data-rise style="--i:1">
        <span data-only="generic">Your seat is reserved</span>
        {TRACKS.map((t) => <span data-only={t.id} hidden>Your seat in {t.name} is reserved</span>)}
      </h1>
      <p class="ai-lead" data-rise style="--i:2">
        Salaam, and thank you. Your {TRAINING.deposit} deposit is in.
        <span data-only="generic">That holds a place in one of the three tracks: {trackList}.</span>
        {TRACKS.map((t) => <span data-only={t.id} hidden>That holds a place in {t.name}.</span>)}
      </p>
      <p class="reserved-count" id="reserved-count" hidden></p>
    </header>

    <section aria-labelledby="next" class="reserved-section">
      <h2 class="ai-h2" id="next">What happens next</h2>
      <ol class="reserved-steps">
        <li data-only="generic">
          <strong>Your track has dates before it starts.</strong>
          <span>
            Everyday AI is confirmed for {everyday.when}. Connect and Build launch at {TRAINING.launchAt} deposits, and the
            first to get there by {TRAINING.launchBy} takes the slot after Ramadan. Up to {TRAINING.maxSeats} can join each.
          </span>
        </li>
        <li data-only="everyday" hidden>
          <strong>Everyday AI is confirmed.</strong>
          <span>It runs {everyday.when}, {COHORT.time}, however many people join. Up to {TRAINING.maxSeats} can join.</span>
        </li>
        {TRACKS.filter((t) => !t.confirmed).map((t) => (
          <li data-only={t.id} hidden>
            <strong>{t.name} launches at {TRAINING.launchAt} deposits.</strong>
            <span>
              The first of Connect or Build to reach {TRAINING.launchAt} by {TRAINING.launchBy} takes the slot after Ramadan
              (late March 2027). If both do, the other takes May 2027. Up to {TRAINING.maxSeats} can join.
            </span>
          </li>
        ))}
        <li data-only="generic">
          <strong>I message you on WhatsApp.</strong>
          <span>I send you the dates and a link to pay the rest of the price. For Everyday AI that is by {everyday.balanceBy}.</span>
        </li>
        <li data-only="everyday" hidden>
          <strong>I message you on WhatsApp.</strong>
          <span>I send you a link to pay the rest of the price by {everyday.balanceBy}, with the intake form.</span>
        </li>
        {TRACKS.filter((t) => !t.confirmed).map((t) => (
          <li data-only={t.id} hidden>
            <strong>I message you on WhatsApp.</strong>
            <span>When {t.name} launches, I send you the dates and a link to pay the rest of the price.</span>
          </li>
        ))}
        <li data-only="generic">
          <strong>Your deposit is refundable.</strong>
          <span>
            Everyday AI: a full refund until {COHORT.refundUntil}. Connect and Build: if the track doesn't launch, or the dates
            don't work for you, your {TRAINING.deposit} comes back in full. Just <a {...messageMe}>message me</a>.
          </span>
        </li>
        <li data-only="everyday" hidden>
          <strong>Your deposit is refundable.</strong>
          <span>
            You get a full refund until {COHORT.refundUntil}. Just <a {...messageMe}>message me</a>.
          </span>
        </li>
        {TRACKS.filter((t) => !t.confirmed).map((t) => (
          <li data-only={t.id} hidden>
            <strong>Your deposit is refundable.</strong>
            <span>
              If {t.name} doesn't launch, or the dates don't work for you, your {TRAINING.deposit} comes back in full.
              Just <a {...messageMe}>message me</a>.
            </span>
          </li>
        ))}
      </ol>
      <p class="reserved-note" data-only="generic">Nothing else is charged until you have the dates and the link.</p>
      <p class="reserved-note" data-only="everyday" hidden>Nothing else is charged until I send the link for the rest.</p>
      {TRACKS.filter((t) => !t.confirmed).map((t) => <p class="reserved-note" data-only={t.id} hidden>Nothing else is charged until {t.name} launches.</p>)}
    </section>

    <section aria-labelledby="wait" class="reserved-section">
      <h2 class="ai-h2" id="wait">While you wait</h2>
      <p class="ai-sub">A few free guides to read before we start. Each is a short read.</p>
      <ul class="reserved-guides" data-only="generic">
        {GENERIC_GUIDES.map((g) => <li><a href={g.href}>{g.title}</a><span>{g.why}</span></li>)}
      </ul>
      {TRACKS.map((t) => (
        <ul class="reserved-guides" data-only={t.id} hidden>
          {TRACK_GUIDES[t.id].map((g) => <li><a href={g.href}>{g.title}</a><span>{g.why}</span></li>)}
        </ul>
      ))}
    </section>

    <section aria-labelledby="share" class="reserved-section">
      <h2 class="ai-h2" id="share">Know someone who'd like it?</h2>
      <p class="ai-sub">
        Each track is up to {TRAINING.maxSeats} people, and a friend in the room makes it better. Send them
        <a href="/ai-training/">bustamam.tech/ai-training</a>.
      </p>
      <p class="mt-5"><a class="cohort-cta" href={shareHref} target="_blank" rel="noopener">Share on WhatsApp</a></p>
    </section>

    <section aria-labelledby="reach" class="reserved-section">
      <h2 class="ai-h2" id="reach">Reach me</h2>
      <p class="ai-sub">
        Haven't heard from me, didn't leave a WhatsApp number, or have a question? Email
        <a href={RESERVED_CONTACT.mailto} class="text-accent">{RESERVED_CONTACT.email}</a>. I answer every one myself.
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  // Fits the page to ?track=. Anything unknown leaves the generic content as it is.
  const root = document.getElementById('reserved');
  const id = new URLSearchParams(location.search).get('track') ?? '';
  const ids = Array.from(root?.querySelectorAll<HTMLElement>('[data-only]') ?? []).map((el) => el.dataset.only);
  if (root && id !== 'generic' && ids.includes(id)) {
    for (const el of root.querySelectorAll<HTMLElement>('[data-only]')) el.hidden = el.dataset.only !== id;

    const endpoint = root.dataset.endpoint;
    const launchAt = Number(root.dataset.launchAt ?? 5);
    const max = Number(root.dataset.max ?? 8);
    const line = document.getElementById('reserved-count');
    const confirmed = root.dataset.confirmed === id;
    if (endpoint && line) {
      fetch(endpoint)
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((body: { counts?: Record<string, number> }) => {
          const n = body.counts?.[id];
          if (typeof n !== 'number') return;
          if (n >= max) {
            const a = document.createElement('a');
            a.href = root.dataset.waitlist ?? '/ai-cohort/waitlist/';
            a.textContent = 'Join the waitlist.';
            line.replaceChildren('This track is full. ', a);
          } else {
            line.textContent =
              confirmed || n >= launchAt
                ? `${confirmed ? '' : 'Launching · '}${n} of ${max} seats taken`
                : `${n} of ${launchAt} reserved to launch`;
          }
          line.hidden = false;
        })
        .catch(() => {});
    }
  }
</script>

<style>
  [data-only][hidden], .reserved-count[hidden] { display: none !important; }
  .reserved-section { margin-top: 2.5rem; }
  .reserved-count { font-family: var(--font-mono); font-size: var(--text-13); color: var(--color-accent); margin: 1rem 0 0; }
  .reserved-steps { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 1rem; counter-reset: step; }
  .reserved-steps li {
    counter-increment: step; display: grid; gap: .25rem; padding: 1rem 0 0 2.5rem; position: relative;
    border-top: 1px solid var(--color-line); font-family: var(--font-serif); font-size: 1.0625rem; line-height: 1.5; color: var(--color-mute);
  }
  .reserved-steps li::before {
    content: counter(step); position: absolute; left: 0; top: .875rem; font-style: italic; font-size: 1.375rem; color: var(--color-accent);
  }
  .reserved-steps strong { color: var(--color-ink); font-weight: 500; font-size: 1.125rem; }
  .reserved-note { font-family: var(--font-mono); font-size: var(--text-13); color: var(--color-faint); margin: 1rem 0 0; }
  .reserved-guides { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: .75rem; }
  .reserved-guides[hidden] { display: none; }
  .reserved-guides li { display: grid; gap: .125rem; font-family: var(--font-serif); }
  .reserved-guides a, .reserved a:not(.cohort-cta) { color: var(--color-accent); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .reserved-guides span { font-size: .9375rem; color: var(--color-mute); }
</style>
