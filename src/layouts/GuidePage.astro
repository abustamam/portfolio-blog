---
// Layout for one free AI guide (/ai-guides/<id>/). Indexed and in the sitemap.
// It looks like the `listed` cohort pages: the same shell, header and prose
// classes from src/styles/ai.css, composed here rather than copied.
// Below the article: one call to action, then the other guides.
import BaseLayout from './BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import GuideCta from '../components/guides/GuideCta.astro';
import { guidePath, type Guide } from '../pages/ai-guides/_guides';
import { nextGuide } from '../utils/startHere';
import '../styles/ai.css';

interface Props {
  guide: Guide;
  /** Every published guide in step order (this one included). */
  guides: Guide[];
}

const { guide, guides } = Astro.props;
const { title, description, lead, minutes, updatedDate, ctaLine } = guide.data;
const others = guides.filter((g) => g.id !== guide.id);
const next = nextGuide(guides.map((g) => ({ id: g.id, step: g.data.step, group: g.data.group, g })), guide.id)?.g;
const updated = updatedDate?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${title} — Free AI guides`} description={description} chromePath={guidePath(guide.id)} chrome="letterhead">
  <div class="ai-shell" data-guide={guide.id}>
    <header class="mb-10">
      <div class="ai-kicker" data-rise style="--i:0">
        <a href="/ai-guides/" class="guide-kicker-link">Free AI guides</a> · {minutes} min read
      </div>
      <h1 class="ai-title ai-title--page" data-rise style="--i:1">{title}</h1>
      <p class="ai-lead" data-rise style="--i:2">{lead}</p>
      {updated && <p class="ai-label mt-4" data-rise style="--i:2">Updated <time datetime={updatedDate!.toISOString().slice(0, 10)}>{updated}</time></p>}
    </header>

    <article class="post-prose cohort-prose" data-rise style="--i:3">
      <slot />
    </article>

    <div class="guide-share" data-guide-share hidden>
      <button type="button" class="guide-share__btn" data-share-button data-share-title={title} data-share-line={description}>Share this guide</button>
      <span class="guide-share__status" data-share-status role="status"></span>
    </div>

    <GuideCta line={ctaLine} guideId={guide.id} />

    <nav class="guide-more" aria-labelledby="guide-more-title" data-more-guides>
      {next && (
        <p class="guide-next" data-next-guide>
          <span class="ai-label">Next guide</span>
          <a href={guidePath(next.id)}>{next.data.title}</a>
          <span class="ai-label">{next.data.minutes} min</span>
        </p>
      )}
      <h2 id="guide-more-title" class="ai-label">More free guides</h2>
      {others.length > 0 && (
        <ol>
          {others.map((g) => (
            <li>
              <a href={guidePath(g.id)}>{g.data.title}</a>
              <span class="ai-label">{g.data.minutes} min</span>
            </li>
          ))}
        </ol>
      )}
      <a class="ai-link" href="/ai-guides/">All free guides →</a>
    </nav>
  </div>
  <CopyButton />
</BaseLayout>

<script>
  import { guideStore } from '../utils/guideStore';

  const id = document.querySelector<HTMLElement>('[data-guide]')?.dataset.guide;
  if (id) guideStore.markVisited(id);

  // Share: the browser's share sheet where there is one, otherwise copy
  // "title — one line — link". The link is the canonical URL with nothing
  // appended, and nothing is sent anywhere.
  import { shareText, canonicalShareUrl } from '../utils/startHere';

  const box = document.querySelector<HTMLElement>('[data-guide-share]');
  const btn = box?.querySelector<HTMLButtonElement>('[data-share-button]');
  const note = box?.querySelector<HTMLElement>('[data-share-status]');
  if (box && btn && note) {
    box.hidden = false;
    btn.addEventListener('click', async () => {
      const title = btn.dataset.shareTitle ?? document.title;
      const line = btn.dataset.shareLine ?? '';
      const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href ?? location.origin + location.pathname;
      const url = canonicalShareUrl(canonical);
      try {
        if (typeof navigator.share === 'function') {
          await navigator.share({ title, text: line, url });
          return;
        }
      } catch (e) {
        if ((e as Error)?.name === 'AbortError') return; // the reader closed the sheet
      }
      const text = shareText(title, line, url);
      try {
        await navigator.clipboard.writeText(text);
        note.textContent = 'Copied. Paste it into a message.';
      } catch {
        note.textContent = text; // clipboard blocked: show it so it can be copied by hand
      }
    });
  }
</script>

<style>
  .guide-next { display: grid; gap: .25rem; margin: 0 0 2rem; }
  .guide-next a { font-family: var(--font-serif); font-size: 1.375rem; line-height: 1.2; }
  .guide-kicker-link { color: inherit; text-decoration: none; }
  .guide-kicker-link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .guide-share { margin-top: 2.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: .75rem; }
  .guide-share[hidden] { display: none; }
  .guide-share__btn {
    font-family: var(--font-mono); font-size: 14px; color: var(--color-ink); background: var(--color-surface);
    border: 1px solid var(--color-line); border-radius: 6px; padding: .6rem 1rem; min-height: 44px; cursor: pointer;
  }
  .guide-share__btn:hover { border-color: var(--color-accent); }
  .guide-share__btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .guide-share__status { font-family: var(--font-serif); color: var(--color-mute); min-width: 0; overflow-wrap: anywhere; }
  .guide-more { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-line-soft); }
  .guide-more h2 { margin: 0 0 1rem; }
  .guide-more ol { list-style: none; margin: 0 0 1.25rem; padding: 0; }
  .guide-more li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1rem;
    padding: .75rem 0; border-bottom: 1px solid var(--color-line-soft);
  }
  .guide-more li a {
    font-family: var(--font-serif); font-size: 1.15rem; color: var(--color-ink); text-decoration: none;
    min-width: 0; overflow-wrap: anywhere;
  }
  .guide-more li a:hover { color: var(--color-accent); }
  .guide-more li .ai-label { flex-shrink: 0; }
</style>
