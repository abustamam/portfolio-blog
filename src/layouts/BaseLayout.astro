---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import TerminalChrome from '../components/TerminalChrome.astro';
import TerminalModeShell from '../components/terminal/TerminalModeShell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Letterhead from '../components/ai/Letterhead.astro';

interface Props {
  title: string;
  description: string;
  chromePath?: string;
  /** Open Graph / Twitter preview image (per-page); omit for canonical wordmark fallback */
  image?: ImageMetadata;
  /** Unlisted page: adds a robots noindex meta. Off by default. */
  noindex?: boolean;
  /** 'letterhead' is for the AI training pages: no terminal bar, a plainer footer. */
  chrome?: 'terminal' | 'letterhead';
}

const { title, description, chromePath = '/writing', image, noindex = false, chrome = 'terminal' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} noindex={noindex} />
  </head>
  <body>
    {chrome === 'letterhead' ? <Letterhead /> : <TerminalChrome path={chromePath} />}
    <div id="terminal-inert-siblings">
      <SiteHeader />
      <slot />
      <SiteFooter plain={chrome === 'letterhead'} />
    </div>
    <TerminalModeShell initialPath={chromePath} />
  </body>
</html>
