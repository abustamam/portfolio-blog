---
// Layout for the unlisted /ai-cohort/ pages (noindex; astro.config.mjs keeps
// /ai-cohort/ out of the sitemap). Used directly by .astro pages and as the
// `layout:` of the Markdown handouts, which pass their frontmatter.
// `listed` pages (the public sign-up pages) drop the participant nav and the
// noindex, and take their own description.
import BaseLayout from './BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import TaskLists from '../components/guides/TaskLists.astro';
import { COHORT_LINKS } from '../consts/aiCohort';
import '../styles/ai.css';

interface Props {
  title?: string;
  kicker?: string;
  lead?: string;
  /** Public sign-up page: indexed, no participant nav. */
  listed?: boolean;
  description?: string;
  frontmatter?: { title: string; kicker?: string; lead?: string };
}

const fm = Astro.props.frontmatter ?? Astro.props;
const title = fm.title ?? 'Hands-on AI cohort';
const kicker = fm.kicker ?? 'cohort 1';
const lead = fm.lead;
const listed = Astro.props.listed ?? false;
const description = Astro.props.description ?? 'For participants in the hands-on AI cohort.';

const here = Astro.url.pathname.replace(/\/?$/, '/');
const nav = [
  { label: 'Cohort home', href: COHORT_LINKS.home },
  { label: 'Prompt', href: COHORT_LINKS.prompt },
  { label: 'Never paste', href: COHORT_LINKS.neverPaste },
  { label: 'Hand-off', href: COHORT_LINKS.handoff },
  { label: 'Intake form', href: COHORT_LINKS.intake },
];
---

<BaseLayout
  title={`${title} — Hands-on AI cohort`}
  description={description}
  chromePath={here}
  noindex={!listed}
  chrome="letterhead"
>
  <div class="ai-shell">
    {!listed && <nav class="cohort-nav" aria-label="Cohort pages">
      {nav.map((l) => (
        <a href={l.href} aria-current={here === l.href ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>}

    <header class="mb-10">
      <div class="ai-kicker" data-rise style="--i:0">{kicker}</div>
      <h1 class="ai-title ai-title--page" data-rise style="--i:1">{title}</h1>
      {lead && <p class="ai-lead" data-rise style="--i:2">{lead}</p>}
    </header>

    <article class="post-prose cohort-prose" data-rise style="--i:3">
      <slot />
    </article>
    <TaskLists />
  </div>
  <CopyButton />
</BaseLayout>
