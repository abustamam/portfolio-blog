---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';

interface SeriesInfo {
  id: string;
  title: string;
}

interface PrevNextPost {
  id: string;
  title: string;
}

type Props = Omit<CollectionEntry<'blog'>['data'], 'series'> & {
  slug: string;
  series?: SeriesInfo;
  prevPost?: PrevNextPost | null;
  nextPost?: PrevNextPost | null;
  headings?: Array<{ depth: number; slug: string; text: string }>;
};

const {
  title, description, pubDate, updatedDate,
  dek, tag, kind, readMin, words, heroImage,
  slug, series, prevPost, nextPost,
  headings = [],
} = Astro.props;

// Related posts: 3 most recent, excluding current
const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(p => p.id !== slug)
  .slice(0, 3);

function fmtDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = new Date(date);
  return `${months[d.getMonth()]} ${String(d.getDate()).padStart(2,'0')} ${d.getFullYear()}`;
}

// TOC: depth-2 headings only (h2)
const toc = headings.filter(h => h.depth === 2);
const readMinNum = readMin ?? 0;
---

<BaseLayout title={title} description={dek ?? description} chromePath={`/writing/${slug}`} image={heroImage}>

  <!-- Title block -->
  <div class="post-title-block">
    <div class="page-shell">
      <!-- Breadcrumb row -->
      <div style="display:flex; gap:14px; font-family:var(--font-mono); font-size:11px; color:var(--mute); letter-spacing:.04em; margin-bottom:28px; align-items:center; flex-wrap:wrap;">
        <a href="/writing" style="color:var(--mute); text-decoration:none;">← /writing</a>
        {tag && (
          <>
            <span style="color:var(--faint);">/</span>
            <span style="color:var(--accent-ink); background:var(--accent-bg); padding:2px 8px; border-radius:2px;">{tag.toLowerCase()}</span>
          </>
        )}
        <span style="color:var(--faint);">/</span>
        <span>{fmtDate(pubDate)}</span>
        {readMin && (
          <>
            <span style="color:var(--faint);">/</span>
            <span>{readMin} min read{words ? ` · ${words.toLocaleString()} words` : ''}</span>
          </>
        )}
      </div>

      <!-- Display title -->
      <h1 class="display-post-title" style="font-family:var(--font-serif); font-weight:500; margin:0; letter-spacing:-.025em; color:var(--ink); max-width:900px;">
        {title}.
      </h1>

      <!-- Dek -->
      <p style="font-family:var(--font-serif); font-size:22px; line-height:1.4; color:var(--mute); margin:24px 0 0; max-width:760px;">
        {dek ?? description}
      </p>

      <!-- Author strip -->
      <div class="post-title__author" style="margin-top:40px; display:flex; align-items:center; gap:14px; padding-top:24px; border-top:1px solid var(--line-soft); flex-wrap:wrap;">
        <div style="width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--ink)); display:flex; align-items:center; justify-content:center; color:var(--bg); font-family:var(--font-mono); font-weight:600; font-size:14px; flex-shrink:0;">
          RB
        </div>
        <div style="flex:1; min-width:0;">
          <div style="font-family:var(--font-mono); font-size:12px; color:var(--ink); font-weight:500;">Rasheed Bustamam</div>
          <div style="font-family:var(--font-mono); font-size:11px; color:var(--faint); margin-top:2px;">independent consultant · writing since 2019</div>
        </div>
        <div style="display:flex; gap:10px; font-family:var(--font-mono); font-size:11px; flex-shrink:0;">
          <button type="button" onclick={`navigator.share?.({title:'${title}',url:location.href})`} style="background:transparent; border:1px solid var(--line); color:var(--ink); padding:6px 12px; border-radius:2px; cursor:pointer; font-family:var(--font-mono); font-size:11px;">↗ share</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Three-column body -->
  <div class="page-shell post-body-shell">
    <div class="post-body-grid">

      <!-- Left sidebar: TOC + progress (collapsible below lg) -->
      <details class="post-toc-details">
        <!-- Sync during parse: desktop TOC visible before paint (deferred module runs too late). -->
        <script is:inline>
          (function () {
            var s = document.currentScript;
            var root = s && s.parentElement;
            if (root && root.tagName === 'DETAILS' && typeof window !== 'undefined') {
              root.open = window.innerWidth >= 1024;
            }
          })();
        </script>
        <summary class="post-toc-details__summary">§ contents</summary>
        <aside class="post-aside-left">
          <div class="post-toc-eyebrow" style="font-family:var(--font-mono); font-size:10px; color:var(--faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:14px;">
            § contents
          </div>
          {toc.length > 0 ? (
            <nav style="display:flex; flex-direction:column; gap:8px; font-family:var(--font-mono); font-size:12px;">
              {toc.map(h => (
                <a href={`#${h.slug}`} class="toc-link" style="padding:2px 0 2px 10px; border-left:2px solid transparent; color:var(--mute); text-decoration:none; line-height:1.4; transition:color 0.1s, border-color 0.1s;">
                  {h.text}
                </a>
              ))}
            </nav>
          ) : (
            <p style="font-family:var(--font-mono); font-size:11px; color:var(--faint); margin:0;">no headings</p>
          )}
          <div style="margin-top:32px; padding:14px; border:1px solid var(--line); border-radius:3px; background:var(--surface);">
            <div style="font-family:var(--font-mono); font-size:10px; color:var(--faint); letter-spacing:.1em; text-transform:uppercase; margin-bottom:8px;">progress</div>
            <div style="height:3px; background:var(--line-soft); border-radius:2px; overflow:hidden;">
              <div id="progress-bar" style="width:0%; height:100%; background:var(--accent); transition:width 0.1s;"></div>
            </div>
            <div id="progress-label" style="font-family:var(--font-mono); font-size:10px; color:var(--mute); margin-top:8px;">
              {readMin ? `${readMin} min` : ''}
            </div>
          </div>
        </aside>
      </details>

      <!-- Article prose -->
      <article class="post-prose" style="font-family:var(--font-serif); font-size:18px; line-height:1.65; color:var(--ink); min-width:0;">
        {series && (prevPost || nextPost) && (
          <nav class="series-nav" style="display:flex; justify-content:space-between; gap:1rem; margin-bottom:2rem; padding-bottom:1.5rem; border-bottom:1px solid var(--line-soft); font-family:var(--font-mono); font-size:12px;">
            {prevPost ? (
              <a href={`/blog/${prevPost.id}/`} style="color:var(--accent); text-decoration:none;">← {prevPost.title}</a>
            ) : <span />}
            {nextPost ? (
              <a href={`/blog/${nextPost.id}/`} style="color:var(--accent); text-decoration:none; text-align:right;">{nextPost.title} →</a>
            ) : <span />}
          </nav>
        )}
        <slot />
        {series && (prevPost || nextPost) && (
          <nav class="series-nav" style="display:flex; justify-content:space-between; gap:1rem; margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--line-soft); font-family:var(--font-mono); font-size:12px;">
            {prevPost ? (
              <a href={`/blog/${prevPost.id}/`} style="color:var(--accent); text-decoration:none;">← {prevPost.title}</a>
            ) : <span />}
            {nextPost ? (
              <a href={`/blog/${nextPost.id}/`} style="color:var(--accent); text-decoration:none; text-align:right;">{nextPost.title} →</a>
            ) : <span />}
          </nav>
        )}
      </article>

      <!-- Right sidebar: margin notes -->
      <aside class="post-aside-right" style="font-family:var(--font-mono); font-size:11px; color:var(--mute);">
        <div style="padding:14px; background:var(--surface); border:1px solid var(--line); border-radius:3px; margin-bottom:14px;">
          <div style="font-size:10px; color:var(--faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px;">§ about this post</div>
          {kind && <div style="margin-bottom:4px; color:var(--ink);">{kind}</div>}
          {words && <div style="color:var(--faint);">{words.toLocaleString()} words</div>}
          {updatedDate && (
            <div style="margin-top:8px; font-size:10px; color:var(--faint);">
              updated {fmtDate(updatedDate)}
            </div>
          )}
        </div>
        {series && (
          <div style="padding:14px; background:var(--surface); border:1px solid var(--line); border-radius:3px;">
            <div style="font-size:10px; color:var(--faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px;">§ series</div>
            <a href={`/series/${series.id}/`} style="color:var(--accent-ink); text-decoration:none; line-height:1.55;">{series.title}</a>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Related posts -->
  {allPosts.length > 0 && (
    <div style="padding:48px 0; border-top:1px solid var(--line); background:var(--surface);">
      <div class="page-shell">
        <div style="font-family:var(--font-mono); font-size:10px; color:var(--faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:20px;">
          ↳ related writing
        </div>
        <div class="related-grid" style="gap:24px;">
          {allPosts.map(p => (
            <a href={`/blog/${p.id}/`} style="display:block; padding:20px 20px 22px; border:1px solid var(--line); border-radius:3px; background:var(--bg); text-decoration:none; color:inherit;">
              <div style="display:flex; justify-content:space-between; font-family:var(--font-mono); font-size:10px; color:var(--faint); letter-spacing:.08em; text-transform:uppercase; margin-bottom:14px;">
                <span>{p.data.tag?.toLowerCase() ?? ''}</span>
                {p.data.readMin && <span>{p.data.readMin} min</span>}
              </div>
              <div style="font-family:var(--font-serif); font-size:20px; font-weight:500; color:var(--ink); letter-spacing:-.01em; line-height:1.2; margin-bottom:10px;">
                {p.data.title}
              </div>
              <div style="font-family:var(--font-serif); font-size:14px; color:var(--mute); line-height:1.5;">
                {(p.data.dek ?? p.data.description ?? '').slice(0, 110)}…
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <CopyButton />

</BaseLayout>

<style is:global>
  /* Post prose typography */
  .post-prose p { margin: 0 0 20px; }

  .post-prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-size: 72px;
    line-height: .85;
    font-weight: 500;
    padding: 6px 10px 0 0;
    color: var(--accent);
  }
  @media (max-width: 767px) {
    .post-prose > p:first-of-type::first-letter {
      font-size: 3rem;
      padding: 4px 8px 0 0;
    }
  }

  .post-prose h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    margin: 44px 0 14px;
    letter-spacing: -.015em;
    line-height: 1.15;
    color: var(--ink);
  }

  .post-prose h3 {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 500;
    margin: 36px 0 12px;
    letter-spacing: -.015em;
    line-height: 1.2;
    color: var(--ink);
  }
  @media (max-width: 767px) {
    .post-prose h2 {
      font-size: 1.65rem;
      margin-top: 2rem;
    }
    .post-prose h3 {
      font-size: 1.4rem;
    }
  }

  .post-prose a { color: var(--accent); }

  .post-prose code {
    font-family: var(--font-mono);
    font-size: .85em;
    background: var(--code);
    padding: 1px 6px;
    border-radius: 2px;
    color: var(--accent-ink);
  }

  .post-prose pre {
    margin: 28px 0;
    background: var(--code);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 16px 18px;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    line-height: 1.65;
  }

  .post-prose > table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    border-collapse: collapse;
  }

  .post-prose pre code {
    background: none;
    padding: 0;
    color: var(--ink);
    font-size: 13px;
  }

  .post-prose blockquote {
    margin: 28px 0;
    padding: 16px 22px;
    border-left: 2px solid var(--accent);
    font-family: var(--font-serif);
    font-size: 19px;
    font-style: italic;
    color: var(--ink);
    background: var(--surface);
  }

  .post-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 3px;
    margin: 24px 0;
  }

  /* TOC active state */
  .toc-link.active {
    color: var(--ink) !important;
    border-left-color: var(--accent) !important;
  }
</style>

<script is:inline define:vars={{ readMinNum }}>
  const tocDetails = document.querySelector('.post-toc-details');
  if (tocDetails instanceof HTMLDetailsElement) {
    const mq = window.matchMedia('(min-width: 1024px)');
    mq.addEventListener('change', () => {
      tocDetails.open = mq.matches;
    });
  }

  // Reading progress bar
  const progressBar = document.getElementById('progress-bar');
  const progressLabel = document.getElementById('progress-label');
  const article = document.querySelector('.post-prose');

  if (progressBar && article) {
    window.addEventListener('scroll', () => {
      const articleEl = article;
      const total = articleEl.clientHeight - window.innerHeight;
      const scrolled = Math.max(0, -articleEl.getBoundingClientRect().top);
      const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
      progressBar.style.width = pct + '%';
      if (progressLabel && readMinNum > 0) {
        const remaining = Math.max(0, Math.round(readMinNum * (1 - pct / 100)));
        progressLabel.textContent = remaining > 0 ? remaining + ' min remaining' : 'done';
      }
    }, { passive: true });
  }

  // TOC active link highlighting
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
  if (tocLinks.length > 0) {
    const headingEls = tocLinks.map(link => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    });

    window.addEventListener('scroll', () => {
      let activeIdx = 0;
      headingEls.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top < 120) activeIdx = i;
      });
      tocLinks.forEach((link, i) => {
        link.classList.toggle('active', i === activeIdx);
      });
    }, { passive: true });
  }
</script>
