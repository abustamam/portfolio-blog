---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import CopyButton from '../components/CopyButton.astro';
import profilePic from '../assets/profile-pic.jpeg';

interface SeriesInfo {
  id: string;
  title: string;
}

interface PrevNextPost {
  id: string;
  title: string;
}

type Props = Omit<CollectionEntry<'writing'>['data'], 'series'> & {
  slug: string;
  series?: SeriesInfo;
  prevPost?: PrevNextPost | null;
  nextPost?: PrevNextPost | null;
  headings?: Array<{ depth: number; slug: string; text: string }>;
};

const {
  title, description, pubDate, updatedDate,
  dek, tag, kind, readMin, words, heroImage,
  slug, series, prevPost, nextPost,
  headings = [],
} = Astro.props;

// Related posts: 3 most recent, excluding current
const allPosts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .filter(p => p.id !== slug)
  .slice(0, 3);

function fmtDate(date: Date): string {
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const d = new Date(date);
  return `${months[d.getMonth()]} ${String(d.getDate()).padStart(2,'0')} ${d.getFullYear()}`;
}

// TOC: depth-2 headings only (h2)
const toc = headings.filter(h => h.depth === 2);
const readMinNum = readMin ?? 0;
---

<BaseLayout title={title} description={dek ?? description} chromePath={`/writing/${slug}`} image={heroImage}>

  <!-- Title block -->
  <div class="border-b border-line">
    <div class="page-shell">
      <div style="padding-top: clamp(2.5rem, 6vw, 4.5rem); padding-bottom: clamp(2rem, 4vw, 2.75rem);">
        <!-- Breadcrumb row -->
        <div class="flex gap-3.5 font-mono text-11 text-mute tracking-snug mb-7 items-center flex-wrap">
          <a href="/writing" class="text-mute no-underline">← /writing</a>
          {tag && (
            <>
              <span class="text-faint">/</span>
              <span class="text-accent-ink bg-accent-bg py-0.5 px-2 rounded-sm">{tag.toLowerCase()}</span>
            </>
          )}
          <span class="text-faint">/</span>
          <span>{fmtDate(pubDate)}</span>
          {readMin && (
            <>
              <span class="text-faint">/</span>
              <span>{readMin} min read{words ? ` · ${words.toLocaleString()} words` : ''}</span>
            </>
          )}
        </div>

        <!-- Display title -->
        <h1 class="display-post-title font-serif font-medium m-0 tracking-tight text-ink max-w-4xl">
          {title}.
        </h1>

        <!-- Dek -->
        <p class="font-serif text-2xl leading-snug text-mute mt-6 mb-0 max-w-3xl">
          {dek ?? description}
        </p>

        <!-- Author strip -->
        <div class="post-title__author mt-10 flex items-center gap-3.5 pt-6 border-t border-line-soft flex-wrap max-xs:flex-col max-xs:items-start">
          <img src={profilePic.src} alt="Rasheed Bustamam" class="w-10 h-10 rounded-full object-cover shrink-0" />
          <div class="flex-1 min-w-0">
            <div class="font-mono text-xs text-ink font-medium">Rasheed Bustamam</div>
            <div class="font-mono text-11 text-faint mt-0.5">independent consultant · writing since 2019</div>
          </div>
          <div class="flex gap-2.5 font-mono text-11 shrink-0">
            <button type="button" id="share-btn" data-title={title} class="bg-transparent border border-line text-ink py-1.5 px-3 rounded-sm cursor-pointer font-mono text-11">↗ share</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Three-column body -->
  <div class="page-shell py-0">
    <div class="post-body-grid">

      <!-- Left sidebar: TOC + progress (collapsible below lg) -->
      <details class="post-toc-details">
        <!-- Sync during parse: desktop TOC visible before paint (deferred module runs too late). -->
        <script is:inline>
          (function () {
            var s = document.currentScript;
            var root = s && s.parentElement;
            if (root && root.tagName === 'DETAILS' && typeof window !== 'undefined') {
              root.open = window.innerWidth >= 1024;
            }
          })();
        </script>
        <summary class="post-toc-details__summary">§ contents</summary>
        <aside class="post-aside-left">
          <div class="post-toc-eyebrow font-mono text-10 text-faint tracking-caps uppercase mb-3.5">
            § contents
          </div>
          {toc.length > 0 ? (
            <nav class="flex flex-col gap-2 font-mono text-xs">
              {toc.map(h => (
                <a href={`#${h.slug}`} class="toc-link py-0.5 pl-2.5 border-l-2 border-transparent text-mute no-underline leading-snug transition-colors">
                  {h.text}
                </a>
              ))}
            </nav>
          ) : (
            <p class="font-mono text-11 text-faint m-0">no headings</p>
          )}
          <div class="mt-8 p-3.5 border border-line rounded bg-surface">
            <div class="font-mono text-10 text-faint tracking-caps uppercase mb-2">progress</div>
            <div class="h-0.75 bg-line-soft rounded overflow-hidden">
              <div id="progress-bar" class="w-0 h-full bg-accent transition-all duration-100"></div>
            </div>
            <div id="progress-label" class="font-mono text-10 text-mute mt-2">
              {readMin ? `${readMin} min` : ''}
            </div>
          </div>
        </aside>
      </details>

      <!-- Article prose -->
      <article class="post-prose" style="font-family:var(--font-serif); font-size:18px; line-height:1.65; color:var(--color-ink); min-width:0;">
        {series && (prevPost || nextPost) && (
          <nav class="flex justify-between gap-4 mb-8 pb-6 border-b border-line-soft font-mono text-xs">
            {prevPost ? (
              <a href={`/writing/${prevPost.id}/`} class="text-accent no-underline overflow-hidden text-ellipsis whitespace-nowrap max-w-[42vw] md:max-w-none md:whitespace-normal">← {prevPost.title}</a>
            ) : <span />}
            {nextPost ? (
              <a href={`/writing/${nextPost.id}/`} class="text-accent no-underline text-right overflow-hidden text-ellipsis whitespace-nowrap max-w-[42vw] md:max-w-none md:whitespace-normal">{nextPost.title} →</a>
            ) : <span />}
          </nav>
        )}
        <slot />
        {series && (prevPost || nextPost) && (
          <nav class="flex justify-between gap-4 mt-8 pt-6 border-t border-line-soft font-mono text-xs">
            {prevPost ? (
              <a href={`/writing/${prevPost.id}/`} class="text-accent no-underline overflow-hidden text-ellipsis whitespace-nowrap max-w-[42vw] md:max-w-none md:whitespace-normal">← {prevPost.title}</a>
            ) : <span />}
            {nextPost ? (
              <a href={`/writing/${nextPost.id}/`} class="text-accent no-underline text-right overflow-hidden text-ellipsis whitespace-nowrap max-w-[42vw] md:max-w-none md:whitespace-normal">{nextPost.title} →</a>
            ) : <span />}
          </nav>
        )}
      </article>

      <!-- Right sidebar: margin notes -->
      <aside class="post-aside-right" style="font-family:var(--font-mono); font-size:11px; color:var(--color-mute);">
        <div style="padding:14px; background:var(--color-surface); border:1px solid var(--color-line); border-radius:3px; margin-bottom:14px;">
          <div style="font-size:10px; color:var(--color-faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px;">§ about this post</div>
          {kind && <div style="margin-bottom:4px; color:var(--color-ink);">{kind}</div>}
          {words && <div style="color:var(--color-faint);">{words.toLocaleString()} words</div>}
          {updatedDate && (
            <div style="margin-top:8px; font-size:10px; color:var(--color-faint);">
              updated {fmtDate(updatedDate)}
            </div>
          )}
        </div>
        {series && (
          <div style="padding:14px; background:var(--color-surface); border:1px solid var(--color-line); border-radius:3px;">
            <div style="font-size:10px; color:var(--color-faint); letter-spacing:.12em; text-transform:uppercase; margin-bottom:10px;">§ series</div>
            <a href={`/series/${series.id}/`} style="color:var(--color-accent-ink); text-decoration:none; line-height:1.55;">{series.title}</a>
          </div>
        )}
      </aside>
    </div>
  </div>

  <!-- Related posts -->
  {allPosts.length > 0 && (
    <div class="py-12 border-t border-line bg-surface">
      <div class="page-shell">
        <div class="font-mono text-10 text-faint tracking-caps uppercase mb-5">
          ↳ related writing
        </div>
        <div class="grid gap-6 grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
          {allPosts.map(p => (
            <a href={`/writing/${p.id}/`} class="block p-5 pb-5.5 border border-line rounded bg-bg no-underline text-inherit">
              <div class="flex justify-between font-mono text-10 text-faint tracking-loose uppercase mb-3.5">
                <span>{p.data.tag?.toLowerCase() ?? ''}</span>
                {p.data.readMin && <span>{p.data.readMin} min</span>}
              </div>
              <div class="font-serif text-[20px] font-medium text-ink tracking-tight leading-tight mb-2.5">
                {p.data.title}
              </div>
              <div class="font-serif text-sm text-mute leading-normal">
                {(p.data.dek ?? p.data.description ?? '').slice(0, 110)}…
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <CopyButton />

</BaseLayout>

<style is:global>
  /* Post prose typography */
  .post-prose p { margin: 0 0 20px; }

  .post-prose > p:first-of-type::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-size: 72px;
    line-height: .85;
    font-weight: 500;
    padding: 6px 10px 0 0;
    color: var(--color-accent);
  }
  @media (max-width: 767px) {
    .post-prose > p:first-of-type::first-letter {
      font-size: 3rem;
      padding: 4px 8px 0 0;
    }
  }

  .post-prose h2 {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    margin: 44px 0 14px;
    letter-spacing: -.015em;
    line-height: 1.15;
    color: var(--color-ink);
  }

  .post-prose h3 {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 500;
    margin: 36px 0 12px;
    letter-spacing: -.015em;
    line-height: 1.2;
    color: var(--color-ink);
  }
  @media (max-width: 767px) {
    .post-prose h2 {
      font-size: 1.65rem;
      margin-top: 2rem;
    }
    .post-prose h3 {
      font-size: 1.4rem;
    }
  }

  .post-prose a { color: var(--color-accent); }

  .post-prose code {
    font-family: var(--font-mono);
    font-size: .85em;
    background: var(--color-code);
    padding: 1px 6px;
    border-radius: 2px;
    color: var(--color-accent-ink);
  }

  .post-prose pre {
    margin: 28px 0;
    background: var(--color-code);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 16px 18px;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    line-height: 1.65;
  }

  .post-prose > table {
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    border-collapse: collapse;
  }

  .post-prose pre code {
    background: none;
    padding: 0;
    color: var(--color-ink);
    font-size: 13px;
  }

  .post-prose blockquote {
    margin: 28px 0;
    padding: 16px 22px;
    border-left: 2px solid var(--color-accent);
    font-family: var(--font-serif);
    font-size: 19px;
    font-style: italic;
    color: var(--color-ink);
    background: var(--color-surface);
  }

  .post-prose img {
    max-width: 100%;
    height: auto;
    border-radius: 3px;
    margin: 24px 0;
  }

  /* TOC active state */
  .toc-link.active {
    color: var(--color-ink) !important;
    border-left-color: var(--color-accent) !important;
  }
</style>

<script is:inline define:vars={{ readMinNum }}>
  const tocDetails = document.querySelector('.post-toc-details');
  if (tocDetails instanceof HTMLDetailsElement) {
    const mq = window.matchMedia('(min-width: 1024px)');
    mq.addEventListener('change', () => {
      tocDetails.open = mq.matches;
    });
  }

  // Reading progress bar
  const progressBar = document.getElementById('progress-bar');
  const progressLabel = document.getElementById('progress-label');
  const article = document.querySelector('.post-prose');

  if (progressBar && article) {
    window.addEventListener('scroll', () => {
      const articleEl = article;
      const total = articleEl.clientHeight - window.innerHeight;
      const scrolled = Math.max(0, -articleEl.getBoundingClientRect().top);
      const pct = total > 0 ? Math.min(100, (scrolled / total) * 100) : 0;
      progressBar.style.width = pct + '%';
      if (progressLabel && readMinNum > 0) {
        const remaining = Math.max(0, Math.round(readMinNum * (1 - pct / 100)));
        progressLabel.textContent = remaining > 0 ? remaining + ' min remaining' : 'done';
      }
    }, { passive: true });
  }

  // TOC active link highlighting
  const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
  if (tocLinks.length > 0) {
    const headingEls = tocLinks.map(link => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    });

    window.addEventListener('scroll', () => {
      let activeIdx = 0;
      headingEls.forEach((el, i) => {
        if (el && el.getBoundingClientRect().top < 120) activeIdx = i;
      });
      tocLinks.forEach((link, i) => {
        link.classList.toggle('active', i === activeIdx);
      });
    }, { passive: true });
  }

  // Share button: native share API with clipboard fallback
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      const shareData = {
        title: shareBtn.dataset.title || document.title,
        url: location.href,
      };
      if (navigator.share) {
        try {
          await navigator.share(shareData);
          return;
        } catch (err) {
          // User cancelled or share failed — fall through to clipboard
        }
      }
      // Fallback: copy URL to clipboard
      try {
        await navigator.clipboard.writeText(shareData.url);
        const originalText = shareBtn.textContent;
        shareBtn.textContent = 'copied!';
        setTimeout(() => {
          shareBtn.textContent = originalText;
        }, 2000);
      } catch {
        // Clipboard API also unavailable — do nothing
      }
    });
  }
</script>
