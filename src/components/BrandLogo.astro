---
// Outlined wordmark: letters are vector paths generated by
// scripts/build-wordmark.ts, so it looks the same on every device.
import {
  WORDMARK_VIEWBOX,
  WORDMARK_WIDTH,
  WORDMARK_HEIGHT,
  WORDMARK_TOP,
  WORDMARK_SUB
} from './wordmark-data';

interface Props {
  alt?: string;
  class?: string;
}

const { alt = 'Bustamam Technology logo', class: className } = Astro.props;
---

<span class:list={['brand-logo-wrap', className]} role="img" aria-label={alt}>
  <svg
    class="brand-logo-svg"
    xmlns="http://www.w3.org/2000/svg"
    viewBox={WORDMARK_VIEWBOX}
    width={WORDMARK_WIDTH / 10}
    height={WORDMARK_HEIGHT / 10}
    fill="currentColor"
    aria-hidden="true"
  >
    <g class="wordmark-top">{WORDMARK_TOP.map((l) => <path d={l.d} />)}</g>
    <g class="wordmark-sub">{WORDMARK_SUB.map((l) => <path d={l.d} />)}</g>
  </svg>
</span>

<style>
  .brand-logo-wrap {
    display: block;
    color: var(--color-ink);
    inline-size: clamp(120px, 16vw, 170px);
    max-inline-size: 170px;
  }

  .brand-logo-svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
</style>
