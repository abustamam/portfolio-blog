---
// Outlined wordmark: letters are vector paths generated by
// scripts/build-wordmark.ts, so it looks the same on every device.
//
// With `animate`, the outline of each letter is drawn, then filled. It plays
// once per browser session, never under prefers-reduced-motion, and without
// JS the static filled mark shows.
import {
  WORDMARK_VIEWBOX,
  WORDMARK_WIDTH,
  WORDMARK_HEIGHT,
  WORDMARK_TOP,
  WORDMARK_SUB
} from './wordmark-data';

interface Props {
  alt?: string;
  class?: string;
  animate?: boolean;
}

const { alt = 'Bustamam Technology logo', class: className, animate = false } = Astro.props;
---

<span
  class:list={['brand-logo-wrap', className]}
  role="img"
  aria-label={alt}
  data-wordmark-animate={animate ? '' : undefined}
>
  <svg
    class="brand-logo-svg"
    xmlns="http://www.w3.org/2000/svg"
    viewBox={WORDMARK_VIEWBOX}
    width={WORDMARK_WIDTH / 10}
    height={WORDMARK_HEIGHT / 10}
    fill="currentColor"
    aria-hidden="true"
  >
    <g class="wordmark-top">
      {WORDMARK_TOP.map((l, i) => <path d={l.d} pathLength="1" style={`--i:${i}`} />)}
    </g>
    <g class="wordmark-sub">
      {WORDMARK_SUB.map((l, i) => <path d={l.d} pathLength="1" style={`--i:${i}`} />)}
    </g>
  </svg>
</span>

{
  animate && (
    <script is:inline>
      // Runs during parse, before first paint, so the filled mark never flashes.
      (function () {
        var el = document.currentScript && document.currentScript.previousElementSibling;
        if (!el || !el.hasAttribute('data-wordmark-animate')) return;
        if (!window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (sessionStorage.getItem('wordmark-drawn')) return;
          sessionStorage.setItem('wordmark-drawn', '1');
        } catch (e) {
          return;
        }
        el.classList.add('is-drawing');
      })();
    </script>
  )
}

<style>
  .brand-logo-wrap {
    display: block;
    color: var(--color-ink);
    inline-size: clamp(120px, 16vw, 170px);
    max-inline-size: 170px;
  }

  .brand-logo-svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
  }

  /* Outline draw: each letter's stroke traces in (staggered), then the fill
     fades up and the stroke fades out. Total about 2.2s. */
  .is-drawing path {
    stroke: currentColor;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    fill-opacity: 0;
    animation:
      wordmark-trace var(--trace) cubic-bezier(0.55, 0.1, 0.35, 1) forwards,
      wordmark-fill 0.45s ease-out forwards;
    animation-delay:
      calc(var(--start) + var(--i) * var(--stagger)),
      calc(var(--start) + var(--i) * var(--stagger) + var(--trace) - 0.2s);
  }

  .is-drawing .wordmark-top path {
    --start: 0s;
    --stagger: 0.09s;
    --trace: 1s;
    stroke-width: 14;
  }

  .is-drawing .wordmark-sub path {
    --start: 0.7s;
    --stagger: 0.06s;
    --trace: 0.7s;
    stroke-width: 6;
  }

  @keyframes wordmark-trace {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes wordmark-fill {
    to {
      fill-opacity: 1;
      stroke-opacity: 0;
    }
  }
</style>
