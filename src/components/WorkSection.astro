---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  title: string;
  entries: CollectionEntry<'work'>[];
  indexOffset?: number;
}

const { title, entries, indexOffset = 0 } = Astro.props;
---

<section class="mb-12">
  <h2 class="font-mono text-11 font-normal text-faint tracking-caps uppercase m-0 mb-5 pb-2 border-b border-line">
    {title}
  </h2>
  <div class="grid grid-cols-1 gap-4 sm:[grid-template-columns:repeat(auto-fill,minmax(300px,1fr))]">
    {entries.map((entry, i) => (
      <WorkCard
        entry={entry}
        index={indexOffset + i}
      />
    ))}
  </div>
</section>
