---
// The hero piece on /ai-training/: one real task from the session 1 handout
// (/ai-cohort/prompt/), shown in the three steps every cohort teaches: the
// task, the prompt, the check. It plays through once by itself, stops for
// good the moment someone touches it, and stays still for reduced motion.
const prompt = [
  ['Situation', 'I run a monthly food drive with 12 volunteers. Most read email on their phones.'],
  ['Task', "Draft the reminder for Saturday's shift."],
  ['Input', 'The two shifts below. We meet at the side entrance.'],
  ['Format', 'Under 80 words, friendly, one line per shift.'],
  ['Check', "List anything you had to guess. Don't add details I didn't give you."],
];
const shifts = [
  ['8–10am', 'PERSON-1, PERSON-2, PERSON-3'],
  ['10am–12pm', 'PERSON-4, PERSON-5'],
];
const checks = ['Every name matches your sheet', 'Nothing added that you didn\'t give it', 'You read it before anything is sent'];
const tabs = ['The task', 'The prompt', 'The check'];
---
<figure class="wx ai-card" data-wx data-stage="0">
  <figcaption class="wx-head">
    <span class="ai-label">A worked example · session 1</span>
    <div class="wx-tabs" role="tablist" aria-label="Steps of the example">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`wx-tab-${i}`} aria-controls={`wx-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-wx-tab={i}>
          <span class="wx-n">{i + 1}</span>{t}
        </button>
      ))}
    </div>
  </figcaption>

  <div class="wx-stage">
    <div class="wx-panel" role="tabpanel" id="wx-panel-0" aria-labelledby="wx-tab-0" data-wx-panel="0">
      <p class="wx-big" style="--i:0">Every month, the reminder for Saturday's food-drive shift gets written by hand.</p>
      <table class="wx-sheet" style="--i:1">
        <thead><tr><th>Shift</th><th>Volunteers</th></tr></thead>
        <tbody>{shifts.map(([a, b]) => <tr><td>{a}</td><td>{b}</td></tr>)}</tbody>
      </table>
      <p class="wx-note" style="--i:2">Real names are swapped out before anything is pasted. That's the first habit you learn.</p>
    </div>

    <div class="wx-panel" role="tabpanel" id="wx-panel-1" aria-labelledby="wx-tab-1" data-wx-panel="1" hidden>
      <dl class="wx-prompt">
        {prompt.map(([k, v], i) => (
          <div style={`--i:${i}`}><dt>{k}</dt><dd>{v}</dd></div>
        ))}
      </dl>
    </div>

    <div class="wx-panel" role="tabpanel" id="wx-panel-2" aria-labelledby="wx-tab-2" data-wx-panel="2" hidden>
      <blockquote class="wx-draft" style="--i:0">
        Reminder for Saturday's food drive. 8–10am: PERSON‑1, PERSON‑2, PERSON‑3. 10am–12pm: PERSON‑4, PERSON‑5.
        We meet at the side entrance. Thank you for giving your morning.
      </blockquote>
      <ul class="wx-checks">
        {checks.map((c, i) => (
          <li style={`--i:${i + 1}`}>
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" pathLength="1" /><path d="M5.5 10.5l3 3 6-7" pathLength="1" /></svg>
            {c}
          </li>
        ))}
      </ul>
    </div>
  </div>
</figure>

<script>
  const root = document.querySelector<HTMLElement>('[data-wx]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-wx-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-wx-panel]'));
    let timer: number | undefined;
    const go = (i: number) => {
      root.dataset.stage = String(i);
      tabs.forEach((t, j) => { t.setAttribute('aria-selected', String(j === i)); t.tabIndex = j === i ? 0 : -1; });
      panels.forEach((p, j) => (p.hidden = j !== i));
    };
    const stop = () => { window.clearInterval(timer); timer = undefined; root.removeAttribute('data-playing'); };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => { stop(); go(i); });
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault(); stop();
        const n = (i + d + tabs.length) % tabs.length;
        go(n); tabs[n].focus();
      });
    });
    root.addEventListener('pointerdown', stop);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.setAttribute('data-playing', '');
      // Plays through once and rests on the last step.
      timer = window.setInterval(() => {
        const n = Number(root.dataset.stage) + 1;
        go(n);
        if (n >= tabs.length - 1) stop();
      }, 5200);
    } else {
      go(tabs.length - 1);
    }
  }
</script>

<style>
  .wx { margin: 0; padding: 0; overflow: hidden; }
  .wx-head { display: flex; flex-direction: column; gap: .875rem; padding: 1.125rem 1.25rem 0; }
  .wx-tabs { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--color-line); }
  .wx-tabs button {
    position: relative; display: flex; align-items: center; gap: .5rem; padding: .75rem .25rem; background: none; border: 0;
    font-family: var(--font-mono); font-size: var(--text-13); color: var(--color-faint); cursor: pointer; text-align: left;
    transition: color .2s ease;
  }
  .wx-tabs button:hover { color: var(--color-ink); }
  .wx-tabs button[aria-selected='true'] { color: var(--color-ink); }
  .wx-tabs button::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--color-accent);
    transform: scaleX(0); transform-origin: left; transition: transform .35s cubic-bezier(.2, .7, .2, 1);
  }
  .wx-tabs button[aria-selected='true']::after { transform: scaleX(1); }
  /* While it plays by itself the underline is also the timer. */
  @keyframes wx-timer { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .wx[data-playing] .wx-tabs button[aria-selected='true']::after { animation: wx-timer 5.2s linear both; transition: none; }
  .wx-n {
    display: inline-grid; place-items: center; width: 1.375rem; height: 1.375rem; border-radius: 50%; flex: none;
    border: 1px solid var(--color-line); font-size: 11px; color: var(--color-mute); transition: all .2s ease;
  }
  .wx-tabs button[aria-selected='true'] .wx-n { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); }

  .wx-stage { display: grid; padding: 1.375rem 1.25rem 1.5rem; min-height: 19.5rem; }
  .wx-panel { grid-area: 1 / 1; font-family: var(--font-serif); color: var(--color-ink); }
  .wx-panel[hidden] { display: none; }
  @keyframes wx-in { from { opacity: 0; transform: translateY(.5rem); } to { opacity: 1; transform: none; } }
  @media screen and (prefers-reduced-motion: no-preference) {
    .wx-panel > *, .wx-prompt > div, .wx-checks > li { animation: wx-in .5s cubic-bezier(.2, .7, .2, 1) both; animation-delay: calc(var(--i, 0) * 140ms + 60ms); }
    .wx-panel > .wx-prompt, .wx-panel > .wx-checks { animation: none; }
  }
  .wx-big { font-size: 1.25rem; line-height: 1.4; margin: 0 0 1rem; letter-spacing: -.01em; }
  .wx-sheet { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: var(--text-13); margin: 0 0 1rem; }
  .wx-sheet th, .wx-sheet td { border: 1px solid var(--color-line); padding: .5rem .625rem; text-align: left; }
  .wx-sheet th { font-weight: 500; color: var(--color-faint); background: var(--color-code); letter-spacing: .06em; text-transform: uppercase; font-size: 11px; }
  .wx-note { font-size: 1rem; line-height: 1.5; color: var(--color-mute); margin: 0; }
  .wx-prompt { margin: 0; display: grid; gap: .625rem; }
  .wx-prompt > div { display: grid; grid-template-columns: 5.25rem 1fr; gap: .75rem; align-items: baseline; }
  .wx-prompt dt { font-family: var(--font-mono); font-size: var(--text-12); letter-spacing: .06em; text-transform: uppercase; color: var(--color-accent); }
  .wx-prompt dd { margin: 0; font-size: 1.0625rem; line-height: 1.45; }
  .wx-draft {
    margin: 0 0 1.125rem; padding: .875rem 1rem; border-left: 2px solid var(--color-accent); background: var(--color-code);
    font-size: 1.0625rem; line-height: 1.5; border-radius: 0 6px 6px 0;
  }
  .wx-checks { list-style: none; margin: 0; padding: 0; display: grid; gap: .5rem; }
  .wx-checks li { display: flex; align-items: center; gap: .625rem; font-size: 1.0625rem; line-height: 1.35; }
  .wx-checks svg { width: 1.25rem; height: 1.25rem; flex: none; fill: none; stroke: var(--color-accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @keyframes wx-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @media screen and (prefers-reduced-motion: no-preference) {
    .wx-checks svg > * { stroke-dasharray: 1; stroke-dashoffset: 1; animation: wx-draw .5s ease forwards; animation-delay: calc(var(--i, 0) * 140ms + 260ms); }
  }
  @media (max-width: 480px) {
    .wx-tabs button { font-size: 12px; gap: .375rem; white-space: nowrap; }
    .wx-n { width: 1.2rem; height: 1.2rem; }
  }
  @media (max-width: 359px) { .wx-n { display: none; } }
  @media (max-width: 400px) {
    .wx-prompt > div { grid-template-columns: 1fr; gap: 0; }
  }
</style>
