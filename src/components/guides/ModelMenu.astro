---
// "Read my menu": tap your app, see its menu translated into sizes, then say
// what you are doing and one option is highlighted with the reason.
// The rule lives in src/utils/modelMenu.ts. Nothing is typed, saved or sent:
// the data ships with the page and the script only shows and hides it.
import { AI_MODELS, VENDORS } from '../../consts/guides/aiModels';
import { ACCOUNTS, TASKS, SIZE_LABELS, FREE_LABELS, menuFor } from '../../utils/modelMenu';
---

<section class="model-menu" data-model-menu aria-labelledby="model-menu-title">
  <h2 id="model-menu-title" class="model-menu__title">Read my menu</h2>
  <form class="quiz" data-mm-form>
    <fieldset class="quiz-group">
      <legend class="quiz-sublabel">1. Which app are you using?</legend>
      <div class="model-menu__grid">
        {VENDORS.map((v) => (
          <label class="quiz-option"><input type="radio" name="vendor" value={v} />{v}</label>
        ))}
      </div>
    </fieldset>

    <fieldset class="quiz-group">
      <legend class="quiz-sublabel">2. Which account?</legend>
      <div class="quiz-options">
        {ACCOUNTS.map((a) => (
          <label class="quiz-option"><input type="radio" name="account" value={a.id} />{a.label}</label>
        ))}
      </div>
    </fieldset>

    {VENDORS.map((v) => (
      <div class="model-menu__menu" data-mm-vendor={v} hidden>
        <p class="quiz-sublabel">What {v}'s menu means</p>
        <ul>
          {menuFor(AI_MODELS, v).map((m) => (
            <li data-mm-option={m.name}>
              <span class="model-menu__name">{m.name}</span>
              <span class="ai-label">{SIZE_LABELS[m.size]}{m.thinking ? ' · thinking' : ''} · free plan: {FREE_LABELS[m.freePlan]}</span>
              <span class="model-menu__when">{m.pickWhen}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <fieldset class="quiz-group">
      <legend class="quiz-sublabel">3. What are you doing?</legend>
      <div class="quiz-options">
        {TASKS.map((t) => (
          <label class="quiz-option"><input type="radio" name="task" value={t.id} />{t.label}</label>
        ))}
      </div>
    </fieldset>

    <div class="model-menu__result" data-mm-result aria-live="polite" hidden></div>
    <button type="reset" class="quiz-btn quiz-btn-ghost" data-mm-reset>Start again</button>
  </form>
  <noscript><p>The table below lists every option.</p></noscript>
</section>

<script>
  import { AI_MODELS, type Vendor } from '../../consts/guides/aiModels';
  import { recommend, type Account, type Task } from '../../utils/modelMenu';

  const root = document.querySelector<HTMLElement>('[data-model-menu]');
  const form = root?.querySelector<HTMLFormElement>('[data-mm-form]');
  const result = root?.querySelector<HTMLElement>('[data-mm-result]');

  function update() {
    if (!root || !form || !result) return;
    const data = new FormData(form);
    const vendor = data.get('vendor') as Vendor | null;
    const account = data.get('account') as Account | null;
    const task = data.get('task') as Task | null;

    root.querySelectorAll<HTMLElement>('[data-mm-vendor]').forEach((el) => {
      el.hidden = el.dataset.mmVendor !== vendor;
    });
    root.querySelectorAll<HTMLElement>('[data-mm-option]').forEach((el) => el.removeAttribute('data-picked'));

    if (!vendor || !account || !task) {
      result.hidden = true;
      result.replaceChildren();
      return;
    }
    const rec = recommend(AI_MODELS, vendor, account, task);
    root
      .querySelector<HTMLElement>(`[data-mm-vendor="${vendor}"] [data-mm-option="${CSS.escape(rec.pick.name)}"]`)
      ?.setAttribute('data-picked', '');
    result.replaceChildren(
      ...rec.lines.map((line) => {
        const p = document.createElement('p');
        p.textContent = line;
        return p;
      }),
    );
    result.hidden = false;
  }

  form?.addEventListener('change', update);
  form?.addEventListener('submit', (e) => e.preventDefault());
  form?.addEventListener('reset', () => setTimeout(update));
</script>

<style>
  .model-menu {
    margin: 2rem 0 2.5rem; padding: 1.25rem; border: 1px solid var(--color-line); border-radius: 10px;
    background: var(--color-bg);
  }
  .model-menu__title { margin-top: 0 !important; }
  .model-menu fieldset { border: 0; margin: 0 0 1.5rem; padding: 0; min-width: 0; }
  .model-menu__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; }
  .model-menu__menu { margin: 0 0 1.5rem; }
  .model-menu__menu ul { list-style: none; margin: 0; padding: 0; }
  .model-menu__menu li {
    display: grid; gap: .15rem; padding: .75rem .875rem; margin: 0 0 .5rem;
    border: 1px solid var(--color-line-soft); border-radius: 8px;
  }
  .model-menu__menu li[data-picked] {
    border-color: var(--color-accent); background: var(--color-accent-bg); box-shadow: inset 0 0 0 1px var(--color-accent);
  }
  .model-menu__name { font-family: var(--font-serif); font-size: 1.1rem; color: var(--color-ink); overflow-wrap: anywhere; }
  .model-menu__when { font-size: 1rem; line-height: 1.45; }
  .model-menu__result {
    margin: 0 0 1rem; padding: 1rem; border-left: 2px solid var(--color-accent); background: var(--color-surface);
    border-radius: 0 6px 6px 0;
  }
  .model-menu__result :global(p) { margin: 0 0 .5rem; }
  .model-menu__result :global(p:first-child) { font-weight: 600; }
  .model-menu__result :global(p:last-child) { margin-bottom: 0; }
  .model-menu__result[hidden], .model-menu__menu[hidden] { display: none; }
</style>
