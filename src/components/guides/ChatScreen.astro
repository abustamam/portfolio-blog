---
// "Labelled screen": a neutral schematic of a chat app with six numbered parts.
// Pick a number (tap, click, or Tab then Enter or Space) and the part is
// highlighted and its one line shows. The numbers on the drawing sit in drawing
// order (6, 4, 5, 3, 1, 2), so they are clickable but skipped by Tab; the list
// under the drawing carries keyboard focus in order 1 to 6. With JavaScript off, the schematic keeps
// its numbers and the legend under it shows all six lines.
// The drawing is plain boxes in the site's own colors: no vendor logo, color or
// wording, so it does not age with each app redesign. Copy lives in
// src/consts/guides/chatScreen.ts.
import { SCREEN_PARTS, type PartId } from '../../consts/guides/chatScreen';

const part = (id: PartId) => SCREEN_PARTS.find((p) => p.id === id)!;
const PAST_CHATS = ['Weeknight dinners', 'Birthday party list', 'Letter to the landlord'];
---

<section class="chat-screen" data-chat-screen aria-label="Labelled chat screen">
  <div class="cs-frame">
    <div class="cs-top">
      <span class="cs-menu-icon" aria-hidden="true"></span>
      <span class="cs-model cs-part" data-part="6">
        Model
        <span class="cs-caret" aria-hidden="true"></span>
        <button type="button" class="cs-badge" tabindex="-1" data-badge="6" aria-pressed="false" aria-label={`6, ${part(6).name}`}><span aria-hidden="true">6</span></button>
      </span>
    </div>

    <div class="cs-side">
      <p class="cs-menu-title" aria-hidden="true"><span class="cs-menu-icon"></span>Menu</p>
      <div class="cs-newchat cs-part" data-part="4">
        <span aria-hidden="true" class="cs-plus">+</span> New chat
        <button type="button" class="cs-badge" tabindex="-1" data-badge="4" aria-pressed="false" aria-label={`4, ${part(4).name}`}><span aria-hidden="true">4</span></button>
      </div>
      <div class="cs-past cs-part" data-part="5">
        <p class="cs-small">Past chats</p>
        <ul>
          {PAST_CHATS.map((c, i) => <li data-current={i === 0 ? '' : undefined}>{c}</li>)}
        </ul>
        <button type="button" class="cs-badge" tabindex="-1" data-badge="5" aria-pressed="false" aria-label={`5, ${part(5).name}`}><span aria-hidden="true">5</span></button>
      </div>
    </div>

    <div class="cs-main">
      <p class="cs-you">Plan five weeknight dinners for four people. Nothing that takes more than 30 minutes.</p>
      <div class="cs-answer cs-part" data-part="3">
        <p>Here are five dinners, each 30 minutes or less.</p>
        <p>1. Sheet-pan chicken with potatoes<br />2. Pasta with garlic and spinach<span class="cs-cursor" aria-hidden="true"></span></p>
        <button type="button" class="cs-badge" tabindex="-1" data-badge="3" aria-pressed="false" aria-label={`3, ${part(3).name}`}><span aria-hidden="true">3</span></button>
      </div>
    </div>

    <div class="cs-composer">
      <div class="cs-box cs-part" data-part="1">
        <span class="cs-placeholder">Type a message</span>
        <button type="button" class="cs-badge" tabindex="-1" data-badge="1" aria-pressed="false" aria-label={`1, ${part(1).name}`}><span aria-hidden="true">1</span></button>
      </div>
      <div class="cs-send cs-part" data-part="2">
        <span class="cs-arrow" aria-hidden="true"></span>
        <button type="button" class="cs-badge" tabindex="-1" data-badge="2" aria-pressed="false" aria-label={`2, ${part(2).name}`}><span aria-hidden="true">2</span></button>
      </div>
    </div>
  </div>

  <p class="cs-readout" data-cs-readout aria-live="polite" hidden>Pick a number to see what that part does.</p>

  <ol class="cs-legend" data-cs-legend>
    {SCREEN_PARTS.map((p) => (
      <li data-legend={p.id} value={p.id}>
        <button type="button" class="cs-legend-btn" data-legend-btn={p.id} aria-pressed="false" tabindex="-1" disabled>
          <strong>{p.name}.</strong>
        </button>
        <span class="cs-legend-line">{p.line}</span>
      </li>
    ))}
  </ol>
  <noscript><p class="cs-note">With JavaScript off, the numbers on the drawing match the list under it.</p></noscript>
</section>

<script>
  import { SCREEN_PARTS } from '../../consts/guides/chatScreen';

  const root = document.querySelector<HTMLElement>('[data-chat-screen]');
  if (root) {
    const readout = root.querySelector<HTMLElement>('[data-cs-readout]')!;
    let active: number | null = null;
    root.setAttribute('data-enhanced', '');
    readout.hidden = false;

    const select = (id: number | null) => {
      active = id;
      root.querySelectorAll<HTMLElement>('[data-part]').forEach((el) => {
        if (Number(el.dataset.part) === id) el.setAttribute('data-active', '');
        else el.removeAttribute('data-active');
      });
      root.querySelectorAll<HTMLElement>('[data-badge], [data-legend-btn]').forEach((el) => {
        const n = Number(el.dataset.badge ?? el.dataset.legendBtn);
        el.setAttribute('aria-pressed', String(n === id));
      });
      root.querySelectorAll<HTMLElement>('[data-legend]').forEach((li) => {
        if (Number(li.dataset.legend) === id) li.setAttribute('data-active', '');
        else li.removeAttribute('data-active');
      });
      const part = SCREEN_PARTS.find((p) => p.id === id);
      readout.replaceChildren();
      if (!part) {
        readout.textContent = 'Pick a number to see what that part does.';
        return;
      }
      const b = document.createElement('strong');
      b.textContent = `${part.id}. ${part.name}. `;
      readout.append(b, part.line);
    };

    root.querySelectorAll<HTMLButtonElement>('[data-legend-btn]').forEach((b) => {
      b.disabled = false;
      b.removeAttribute('tabindex');
    });
    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-badge], [data-legend-btn]');
      if (!el) return;
      const n = Number(el.dataset.badge ?? el.dataset.legendBtn);
      select(active === n ? null : n);
    });
  }
</script>

<style>
  .chat-screen { margin: 2rem 0 2.5rem; }
  .cs-frame {
    --cs-gap: .75rem;
    display: grid; gap: var(--cs-gap); padding: var(--cs-gap);
    grid-template-columns: minmax(10rem, 13rem) minmax(0, 1fr);
    grid-template-areas: 'side top' 'side main' 'side comp';
    grid-template-rows: auto 1fr auto;
    border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-bg);
    font-size: 15px; line-height: 1.4; color: var(--color-ink);
  }
  .cs-top { grid-area: top; display: flex; justify-content: flex-end; align-items: center; padding: .25rem .5rem 1rem; }
  .cs-side { grid-area: side; display: flex; flex-direction: column; gap: var(--cs-gap); }
  .cs-main { grid-area: main; display: flex; flex-direction: column; gap: 1.25rem; padding: .5rem; min-width: 0; }
  .cs-composer { grid-area: comp; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .5rem; align-items: stretch; margin-top: 1rem; }

  .cs-part {
    position: relative; border: 1px solid var(--color-line); border-radius: 8px; background: var(--color-surface);
    padding: .625rem .75rem; transition: box-shadow .15s ease, background-color .15s ease;
  }
  .cs-part[data-active] { border-color: var(--color-accent); background: var(--color-accent-bg); box-shadow: 0 0 0 2px var(--color-accent); }

  .cs-model { display: inline-flex; align-items: center; gap: .5rem; padding-right: .75rem; margin-right: .75rem; }
  .cs-caret { width: .5rem; height: .5rem; border-right: 2px solid var(--color-mute); border-bottom: 2px solid var(--color-mute); transform: rotate(45deg) translate(-2px, -2px); }
  .cs-menu-icon { display: none; width: 1.1rem; height: .8rem; border-top: 2px solid var(--color-mute); border-bottom: 2px solid var(--color-mute); position: relative; flex: none; }
  .cs-menu-icon::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 2px solid var(--color-mute); transform: translateY(-1px); }
  .cs-menu-title { display: none; margin: 0; align-items: center; gap: .6rem; font-family: var(--font-mono); font-size: 12px; letter-spacing: var(--tracking-loose); text-transform: uppercase; color: var(--color-faint); }

  .cs-newchat { display: flex; align-items: center; gap: .5rem; font-weight: 600; }
  .cs-plus { font-family: var(--font-mono); color: var(--color-mute); }
  .cs-small { margin: 0 0 .4rem; font-family: var(--font-mono); font-size: 12px; letter-spacing: var(--tracking-loose); text-transform: uppercase; color: var(--color-faint); }
  .cs-past ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .25rem; }
  .cs-past li { padding: .3rem .4rem; border-radius: 5px; color: var(--color-mute); overflow-wrap: anywhere; }
  .cs-past li[data-current] { background: var(--color-code); color: var(--color-ink); }

  .cs-you {
    align-self: flex-end; max-width: 85%; margin: 0; padding: .625rem .875rem; border-radius: 12px 12px 2px 12px;
    background: var(--color-code); border: 1px solid var(--color-line-soft);
  }
  .cs-answer { border-style: dashed; }
  .cs-answer p { margin: 0 0 .5rem; }
  .cs-answer p:last-of-type { margin-bottom: 0; }
  .cs-cursor { display: inline-block; width: .5rem; height: 1em; margin-left: .25rem; vertical-align: text-bottom; background: var(--color-mute); }

  .cs-box { min-height: 3rem; display: flex; align-items: center; }
  .cs-placeholder { color: var(--color-faint); }
  .cs-send { width: 3rem; display: flex; align-items: center; justify-content: center; padding: 0; }
  .cs-arrow { width: .7rem; height: .7rem; border-top: 2px solid var(--color-ink); border-right: 2px solid var(--color-ink); transform: rotate(-45deg); }

  .cs-badge {
    position: absolute; top: -.7rem; right: -.45rem; z-index: 1;
    width: 1.75rem; height: 1.75rem; padding: 0; border-radius: 50%;
    border: 2px solid var(--color-bg); background: var(--color-ink); color: var(--color-bg);
    font-family: var(--font-mono); font-size: 13px; font-weight: 600; line-height: 1; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .cs-badge::after { content: ''; position: absolute; inset: -.5rem; }
  .cs-badge[aria-pressed='true'] { background: var(--color-accent); color: var(--color-bg); }
  .cs-send .cs-badge { right: -.45rem; }

  .cs-readout {
    margin: 1rem 0 0; padding: 1rem; border-left: 2px solid var(--color-accent); background: var(--color-surface);
    border-radius: 0 6px 6px 0; min-height: 3.5rem;
  }
  .cs-readout[hidden] { display: none; }

  .cs-legend { list-style: none; margin: 1rem 0 0; padding: 0; counter-reset: cs; display: grid; gap: .5rem; }
  .cs-legend li {
    position: relative; padding: .5rem .75rem .5rem 2.5rem; border: 1px solid var(--color-line-soft); border-radius: 8px;
    counter-increment: cs;
  }
  .cs-legend li::before {
    content: counter(cs); position: absolute; left: .6rem; top: .55rem; width: 1.5rem; height: 1.5rem; border-radius: 50%;
    background: var(--color-ink); color: var(--color-bg); font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .cs-legend li[data-active] { border-color: var(--color-accent); background: var(--color-accent-bg); }
  .cs-legend li[data-active]::before { background: var(--color-accent); }
  .cs-legend-btn { all: unset; cursor: default; color: var(--color-ink); }
  .cs-legend-btn:focus-visible, .cs-badge:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  .cs-legend-line { margin-left: .25rem; }
  .cs-note { font-size: 14px; color: var(--color-mute); }

  /* With JS the readout carries the line; the legend shrinks to a row of names. */
  [data-enhanced] .cs-legend-line { display: none; }
  [data-enhanced] .cs-legend { grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); }
  [data-enhanced] .cs-legend-btn { cursor: pointer; display: block; }

  /* A phone: the side list is the menu it collapses into, drawn open above the conversation. */
  @media (max-width: 47.99rem) {
    .cs-frame { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'top' 'side' 'main' 'comp'; grid-template-rows: auto; padding: .625rem; }
    .cs-top { justify-content: space-between; padding: .25rem .25rem .5rem; }
    .cs-top .cs-menu-icon { display: block; }
    .cs-side { border: 1px solid var(--color-line); border-radius: 8px; padding: .625rem; background: var(--color-code); }
    .cs-menu-title { display: flex; }
    .cs-model { margin-right: .5rem; }
    .cs-you { max-width: 95%; }
  }
</style>
