---
interface Props {
  size?: string;
  class?: string;
}
const { size = '14px', class: className } = Astro.props;
---

<span
  class:list={['wordmark', className]}
  role="img"
  aria-label="Rasheed Bustamam"
>
  <!-- ><  no whitespace between spans — prevents gap in inline text rendering -->
  <span class="wordmark__first">Rasheed</span
  ><span class="wordmark__dot"> · </span
  ><span class="wordmark__last">Bustamam</span>
</span>

<style define:vars={{ size }}>
  .wordmark {
    font-size: var(--size);
    font-family: var(--font-sans);
    line-height: 1;
    white-space: nowrap;
    display: inline-block;
  }
  .wordmark__first {
    font-weight: 400;
    color: var(--ink);
  }
  .wordmark__dot {
    font-weight: 400;
    color: var(--accent);
  }
  .wordmark__last {
    font-weight: 700;
    color: var(--ink);
  }
</style>
