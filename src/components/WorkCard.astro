---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  animated?: boolean;
  index?: number;
}

const { entry, animated = false, index = 0 } = Astro.props;
const { company, projectName, role, period, skills, badges, logo, darkLogo, location } = entry.data;
const delay = 300 + index * 80;

const badgeLabels: Record<string, string> = {
  acquired: 'acquired',
  zeroToOne: '0→1',
};
---

<a
  href={`/work/${entry.id}/`}
  class:list={['work-card', animated && 'animate-fade-up']}
  style={animated ? `--delay:${delay}` : undefined}
>
  <div class="work-card__header">
    <div class="work-card__logo-wrap">
      {logo ? (
        <Image
          src={logo}
          alt={`${company} logo`}
          width={40}
          height={40}
          class:list={['work-logo', darkLogo && 'is-dark']}
        />
      ) : (
        <div class="work-card__logo-placeholder">
          {company.slice(0, 2).toUpperCase()}
        </div>
      )}
    </div>
    <div class="work-card__meta">
      <div class="work-card__company">
        {company}{projectName && <span class="work-card__project"> · {projectName}</span>}
      </div>
      <div class="work-card__role">{role}</div>
    </div>
  </div>

  <div class="work-card__period">
    {period}{location && <span class="work-card__location"> · {location}</span>}
  </div>

  {badges.length > 0 && (
    <div class="work-card__badges">
      {badges.map((b) => (
        <span class="work-card__badge">{badgeLabels[b] ?? b}</span>
      ))}
    </div>
  )}

  {skills.length > 0 && (
    <div class="work-card__skills">
      {skills.map((s) => (
        <span class="work-card__skill">{s}</span>
      ))}
    </div>
  )}
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 20px 24px;
    background: var(--surface);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .work-card:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
  }
  .work-card__header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 10px;
  }
  .work-card__logo-wrap {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .work-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 4px;
  }
  .work-card__logo-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    background: var(--accent-bg);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .work-card__meta {
    flex: 1;
    min-width: 0;
  }
  .work-card__company {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .work-card__project {
    font-weight: 400;
    color: var(--mute);
  }
  .work-card__role {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    margin-top: 2px;
    letter-spacing: 0.02em;
  }
  .work-card__period {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.02em;
    margin-bottom: 12px;
  }
  .work-card__location {
    color: var(--faint);
  }
  .work-card__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
  }
  .work-card__badge {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: 2px;
    background: var(--accent-bg);
    color: var(--accent-ink);
    border: 1px solid var(--accent);
  }
  .work-card__skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .work-card__skill {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--mute);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 7px;
    letter-spacing: 0.02em;
  }
</style>
