---
import { getCollection } from 'astro:content';
import { isPublished, readingStats } from '../utils/content';
import type { SiteTerminalData } from './terminal/terminal-types';
import { runCommandLine } from './terminal/terminal-commands';

interface Props {
  /**
   * Commands replayed as a scripted session. Rendered at build time so the
   * session shows with JavaScript off and under prefers-reduced-motion; with
   * motion allowed, the client types it out over the same reserved box.
   */
  script?: string[];
  /** Height class for the output area. The box is fixed so nothing shifts. */
  outputClass?: string;
  /** Accessible name for the whole widget. */
  label?: string;
}
const { script = [], outputClass = 'h-48', label = 'Interactive terminal' } = Astro.props;

const blogRaw = await getCollection('writing', ({ data }) => isPublished(data));
const blog: SiteTerminalData['blog'] = blogRaw.map((p) => ({
  id: p.id,
  title: p.data.title,
  body: typeof p.body === 'string' ? p.body : '',
  pubDate: p.data.pubDate.toISOString().slice(0, 10),
  tag: p.data.tag,
  ...readingStats(p),
}));

const seriesRaw = await getCollection('series', ({ data }) => isPublished(data));
const series: SiteTerminalData['series'] = seriesRaw.map((s) => ({
  id: s.id,
  title: s.data.title,
}));

const workRaw = await getCollection('work', ({ data }) => isPublished(data));
const work: SiteTerminalData['work'] = workRaw.map((w) => ({
  id: w.id,
  company: w.data.company,
  role: w.data.role,
  period: w.data.period,
}));

const terminalData: SiteTerminalData = { blog, series, work };
const terminalJson = JSON.stringify(terminalData).replace(/</g, '\\u003c');

// Turn a scripted line into a link when it names a site path or the email.
function hrefFor(text: string): string | undefined {
  const email = text.match(/[\w.+-]+@[\w-]+\.[\w.]+/);
  if (email) return `mailto:${email[0]}`;
  const path = text.match(/(?:^|\s)(\/[a-z0-9/-]+)$/);
  if (path) return path[1].endsWith('/') ? path[1] : `${path[1]}/`;
  return undefined;
}

type Row = { kind: 'echo'; cwd: string; cmd: string } | { kind: 'out'; text: string; href?: string };
const rows: Row[] = [];
let scriptState = { cwd: '~' };
for (const cmd of script) {
  rows.push({ kind: 'echo', cwd: scriptState.cwd, cmd });
  const result = runCommandLine(cmd, scriptState, terminalData);
  scriptState = result.next;
  for (const text of result.lines) {
    if (text === '__CLEAR__') continue;
    rows.push({ kind: 'out', text, href: hrefFor(text) });
  }
}
const hasScript = rows.length > 0;
---

<div
  id="terminal-widget"
  role="group"
  aria-label={label}
  data-scripted={hasScript ? '' : undefined}
  class="bg-code border border-line rounded font-mono text-xs overflow-hidden flex flex-col"
>
  <!-- Chrome bar (matches TerminalModeShell) -->
  <div class="h-9 border-b border-line bg-surface flex items-center justify-between px-3.5 text-13 text-mute shrink-0">
    <div class="group flex items-center gap-1.5">
      <button
        id="widget-dot-1-btn"
        type="button"
        disabled
        aria-label="Close (unavailable)"
        class="w-2 h-2 rounded-full border border-line bg-faint flex items-center justify-center opacity-60 cursor-not-allowed"
      >
        <span class="traffic-light-glyph font-mono leading-none select-none pointer-events-none" style="font-size:6px; opacity:0">×</span>
      </button>
      <button
        id="widget-dot-2-btn"
        type="button"
        disabled
        aria-label="Minimize (unavailable)"
        class="w-2 h-2 rounded-full border border-line bg-faint flex items-center justify-center opacity-60 cursor-not-allowed"
      >
        <span class="traffic-light-glyph font-mono leading-none select-none pointer-events-none" style="font-size:6px; opacity:0">─</span>
      </button>
      <button
        id="widget-expand-btn"
        type="button"
        aria-label="Open terminal in full-screen mode"
        class="w-2 h-2 rounded-full border border-line bg-faint flex items-center justify-center"
      >
        <span class="traffic-light-glyph font-mono leading-none select-none pointer-events-none" style="font-size:6px; opacity:0">+</span>
      </button>
    </div>
    <div class="font-mono tracking-tight text-ink min-w-0 px-3 overflow-hidden text-ellipsis whitespace-nowrap">
      terminal <span class="text-faint">·</span> <span id="widget-top-path">~</span>
    </div>
    <div class="font-mono text-12 uppercase tracking-snug text-faint">simulated</div>
  </div>

  <!-- Scrollable output area. A scripted session is server-rendered here. -->
  <div
    id="widget-output"
    class:list={[outputClass, 'overflow-y-auto p-3.5 sm:p-4 leading-normal transition-opacity duration-150']}
    aria-live="polite"
    aria-label="Terminal output"
  >{rows.map((row) => row.kind === 'echo' ? (
    <div class="mb-0.5 font-mono text-xs text-ink whitespace-pre-wrap" data-script-row="echo"><span class="text-accent">{row.cwd} $ </span><span data-cmd={row.cmd}>{row.cmd}</span></div>
  ) : (
    <div class="mb-0.5 font-mono text-xs text-mute whitespace-pre-wrap" data-script-row="out">{row.href
      ? <a href={row.href} class="text-mute underline decoration-line underline-offset-2 hover:text-ink">{row.text}</a>
      : row.text}</div>
  ))}</div>

  <!-- Prompt row -->
  <form
    id="widget-form"
    method="post"
    aria-label="Terminal"
    class="border-t border-line shrink-0 flex items-center gap-2 h-10 px-4"
  >
    <span id="widget-cwd" aria-hidden="true" class="shrink-0 text-accent text-xs">~ $</span>
    <div class="flex items-center flex-1 min-w-0 relative">
      <!-- Typewriter display span (visible during intro, hidden after) -->
      <span id="widget-typewriter-display" class="text-ink text-xs"></span>
      <!-- Real input (hidden during intro, shown after) -->
      <input
        id="widget-input"
        type="text"
        class="flex-1 min-w-0 border-none bg-transparent text-base sm:text-xs text-ink outline-none placeholder:text-faint focus:placeholder:text-transparent hidden"
        style="caret-color: transparent"
        autocomplete="off"
        autocapitalize="off"
        autocorrect="off"
        enterkeyhint="go"
        spellcheck="false"
        placeholder={hasScript ? 'type help' : undefined}
        aria-label="Terminal command input"
      />
      <!-- Blocky blinking cursor -->
      <span
        id="widget-cursor"
        class="absolute left-0 top-1/2 -translate-y-1/2 w-1.75 h-3.25 bg-accent animate-[termBlink_1s_step-end_infinite]"
        aria-hidden="true"
      ></span>
    </div>
  </form>
</div>

<!-- Embedded site data -->
<script
  type="application/json"
  id="widget-site-data"
  is:inline
  set:html={terminalJson}
></script>

<script>
  import { runCommandLine } from './terminal/terminal-commands';
  import { getCompletion } from './terminal/terminal-completion';
  import type { SiteTerminalData, TerminalState, TerminalWidgetBridge } from './terminal/terminal-types';

  (function () {
    const widgetEl  = document.getElementById('terminal-widget') as HTMLElement | null;
    const outputEl  = document.getElementById('widget-output') as HTMLElement | null;
    const formEl    = document.getElementById('widget-form') as HTMLFormElement | null;
    const inputEl   = document.getElementById('widget-input') as HTMLInputElement | null;
    const cwdEl     = document.getElementById('widget-cwd') as HTMLElement | null;
    const expandBtn = document.getElementById('widget-expand-btn') as HTMLButtonElement | null;
    const topPathEl = document.getElementById('widget-top-path') as HTMLElement | null;

    if (!widgetEl || !outputEl || !formEl || !inputEl || !cwdEl) return;

    const widget = widgetEl;
    const output = outputEl;
    const form = formEl;
    const input = inputEl;
    const cwd = cwdEl;

    // Read siteData from embedded JSON tag
    const rawJson = document.getElementById('widget-site-data')?.textContent ?? '';
    let siteData: SiteTerminalData;
    try { siteData = JSON.parse(rawJson) as SiteTerminalData; }
    catch { return; }

    // State
    let state: TerminalState = { cwd: '~' };
    let historyBuffer: string[] = [];
    let historyIndex = -1;
    let historyDraft = '';
    // Output buffer for serialization on expand (Task 4)
    const outputBuffer: { text: string; cls: string }[] = [];

    // localStorage helpers
    function lsGet(key: string): string | null {
      try { return localStorage.getItem(key); } catch { return null; }
    }
    function lsSet(key: string, value: string): void {
      try { localStorage.setItem(key, value); } catch { /* private browsing */ }
    }

    // Output
    function appendLine(text: string, cls = 'text-mute') {
      const row = document.createElement('div');
      row.className = `mb-0.5 font-mono text-xs whitespace-pre-wrap ${cls}`;
      row.textContent = text;
      output.appendChild(row);
      output.scrollTop = output.scrollHeight;
      outputBuffer.push({ text, cls });
    }

    function appendEcho(line: string) {
      appendLine(`${state.cwd} $ ${line}`, 'text-ink');
    }

    function renderCwd() {
      cwd.textContent = `${state.cwd} $`;
      if (topPathEl) topPathEl.textContent = state.cwd;
    }

    // Cursor tracking — position the block cursor after the current text up to caret
    const cursorEl = document.getElementById('widget-cursor') as HTMLElement | null;
    const twDisplayEl = document.getElementById('widget-typewriter-display') as HTMLElement | null;
    let _measureSpan: HTMLSpanElement | null = null;
    function syncCursor(text: string, pos?: number) {
      if (!cursorEl) return;
      const slice = pos !== undefined ? text.slice(0, pos) : text;
      if (!slice) { cursorEl.style.left = '0px'; return; }
      if (!_measureSpan) {
        _measureSpan = document.createElement('span');
        _measureSpan.style.visibility = 'hidden';
        _measureSpan.style.position = 'absolute';
        _measureSpan.style.whiteSpace = 'pre';
        _measureSpan.style.font = getComputedStyle(input!).font;
        form.appendChild(_measureSpan);
      }
      _measureSpan.textContent = slice;
      cursorEl.style.left = `${_measureSpan.offsetWidth}px`;
    }

    // Run a command — no pager (stream all lines into scrollable output)
    function runLine(raw: string) {
      const line = raw.trim();
      if (!line) return;
      appendEcho(line);
      const prevCwd = state.cwd;
      const result = runCommandLine(line, state, siteData);
      state = result.next;
      renderCwd();

      if (state.cwd !== prevCwd) lsSet('terminal:cwd', state.cwd);
      if (result.setBrightness) {
        const applyBrightness = (window as any).__applyBrightness;
        if (applyBrightness) applyBrightness(result.setBrightness);
      }
      if (result.setColor) {
        const applyColor = (window as any).__applyColorTheme;
        if (applyColor) applyColor(result.setColor);
        if (result.setColor === 'inherit') {
          widget.removeAttribute('data-theme');
        } else {
          widget.setAttribute('data-theme', result.setColor);
        }
        lsSet('terminal:theme', result.setColor);
      }
      if (result.navigateTo) { window.location.href = result.navigateTo; return; }
      // In the widget, ignore closeTerminal — just print the lines
      const cleared = result.lines.includes('__CLEAR__');
      if (cleared) {
        output.textContent = '';
        outputBuffer.length = 0;
      }
      for (const ln of result.lines) {
        if (ln !== '__CLEAR__') appendLine(ln, 'text-ink');
      }
      queueMicrotask(() => input.focus());
    }

    // Track typing in real-time for cursor position
    input.addEventListener('input', () => syncCursor(input.value, input.selectionStart ?? undefined));

    // Form submit
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const line = input.value;
      if (line.trim()) {
        historyBuffer.push(line.trim());
        historyIndex = -1;
        historyDraft = '';
      }
      input.value = '';
      syncCursor('');
      runLine(line);
    });

    // Keydown: Tab, ArrowUp/Down, Ctrl+C, ArrowLeft/Right
    input.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const result = getCompletion(input.value, state.cwd, siteData);
        input.value = result.completed;
        queueMicrotask(() => { input.selectionStart = input.selectionEnd = input.value.length; syncCursor(input.value); });
        if (result.matches.length > 1) appendLine(result.matches.join('  '), 'text-mute');
        return;
      }
      if (e.ctrlKey && !e.shiftKey && e.key === 'c') {
        e.preventDefault();
        input.value = '';
        syncCursor('');
        historyIndex = -1;
        historyDraft = '';
        return;
      }
      if (e.key === 'ArrowUp' && historyBuffer.length > 0) {
        e.preventDefault();
        if (historyIndex === -1) historyDraft = input.value;
        historyIndex = Math.min(historyIndex + 1, historyBuffer.length - 1);
        input.value = historyBuffer[historyBuffer.length - 1 - historyIndex];
        queueMicrotask(() => { input.selectionStart = input.selectionEnd = input.value.length; syncCursor(input.value); });
      }
      if (e.key === 'ArrowDown' && historyIndex >= 0) {
        e.preventDefault();
        historyIndex--;
        input.value = historyIndex === -1 ? historyDraft : historyBuffer[historyBuffer.length - 1 - historyIndex];
        queueMicrotask(() => { input.selectionStart = input.selectionEnd = input.value.length; syncCursor(input.value); });
      }
    });

    // Cursor tracking: arrow keys, Home/End, Ctrl+A/E
    input.addEventListener('keyup', (e: KeyboardEvent) => {
      const movers = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
      if (movers.includes(e.key) || ((e.ctrlKey || e.metaKey) && (e.key === 'a' || e.key === 'e'))) {
        syncCursor(input.value, input.selectionStart ?? undefined);
      }
    });
    input.addEventListener('click', () => {
      syncCursor(input.value, input.selectionStart ?? undefined);
    });

    // Click output area → focus input (links keep their own behavior; the
    // intro script handles clicks while the session is still typing)
    output.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      if (widget.hasAttribute('data-intro')) return;
      input.focus();
    });

    // Focus indicator: border + traffic lights
    const dot1 = document.getElementById('widget-dot-1-btn') as HTMLElement | null;
    const dot2 = document.getElementById('widget-dot-2-btn') as HTMLElement | null;
    const dot3 = document.getElementById('widget-expand-btn') as HTMLElement | null;
    function setFocused(on: boolean) {
      widget.style.transition = 'border-color 0.2s ease';
      widget.style.borderColor = on ? 'var(--color-accent)' : '';
      const colors = on
        ? ['var(--color-danger)', 'var(--color-mute)', 'var(--color-accent)']
        : ['', '', ''];
      [dot1, dot2, dot3].forEach((d, i) => {
        if (d) d.style.backgroundColor = colors[i];
      });
    }

    // Focus/blur: toggle cursor visibility
    input.addEventListener('focus', () => {
      if (cursorEl) cursorEl.style.display = '';
      setFocused(true);
      syncCursor(input.value, input.selectionStart ?? undefined);
    });
    input.addEventListener('blur', () => {
      if (cursorEl) cursorEl.style.display = 'none';
      setFocused(false);
    });

    // Start hidden — shown on first focus (typewriter will show it temporarily)
    if (cursorEl) cursorEl.style.display = 'none';
    // Show cursor during typewriter intro
    function showCursorDuringIntro() {
      if (cursorEl) cursorEl.style.display = '';
    }
    function hideCursorDuringIntro() {
      if (cursorEl) cursorEl.style.display = 'none';
    }

    // Restore persisted state on load
    const savedCwd = lsGet('terminal:cwd');
    const savedColor = lsGet('terminal:theme');
    // A scripted session always starts at ~ so the replay reads true.
    const scripted = widget.hasAttribute('data-scripted');
    if (savedCwd && !scripted) state = { cwd: savedCwd };

    // Seed the buffers from the server-rendered session so the full-screen
    // shell (and ArrowUp) pick it up.
    if (scripted) {
      output.querySelectorAll<HTMLElement>('[data-script-row]').forEach((row) => {
        const isEcho = row.dataset.scriptRow === 'echo';
        outputBuffer.push({ text: row.textContent ?? '', cls: isEcho ? 'text-ink' : 'text-mute' });
        const cmd = row.querySelector<HTMLElement>('[data-cmd]')?.dataset.cmd;
        if (isEcho && cmd) historyBuffer.push(cmd);
      });
    }
    // Restore color theme on widget element
    if (savedColor && savedColor !== 'inherit') {
      widget.setAttribute('data-theme', savedColor);
    } else {
      widget.removeAttribute('data-theme');
    }
    renderCwd();

    // Expose internals on the DOM element for the typewriter script and TerminalModeShell
    (widget as HTMLElement & { __terminal: TerminalWidgetBridge }).__terminal = {
      runLine,
      syncCursor,
      showCursor: showCursorDuringIntro,
      hideCursor: hideCursorDuringIntro,
      setFocused,
      get state() { return state; },
      outputBuffer,
      historyBuffer,
      input,
    };

    // Expand: open full-screen shell (session transferred via __terminal bridge, not localStorage)
    expandBtn?.addEventListener('click', () => {
      output.style.opacity = '0';
      setTimeout(() => {
        window.dispatchEvent(new CustomEvent('terminal:open'));
      }, 150);
    });

    // Fade back in when full-screen shell closes; restore cwd/theme
    window.addEventListener('terminal:closed', () => {
      output.style.opacity = '1';
      const savedCwd = lsGet('terminal:cwd');
      const savedColor = lsGet('terminal:theme');
      if (savedCwd) state = { cwd: savedCwd };
      // Restore color theme on widget element
      if (savedColor && savedColor !== 'inherit') {
        widget.setAttribute('data-theme', savedColor);
      } else {
        widget.removeAttribute('data-theme');
      }
      renderCwd();
    });
  })();
</script>

<script is:inline>
  // Runs during parse, before first paint: hide the static session only when
  // it is about to be typed out. No JS or reduced motion → it stays visible.
  (function () {
    var w = document.getElementById('terminal-widget');
    if (!w || !w.hasAttribute('data-scripted')) return;
    try { if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return; } catch (e) { return; }
    w.setAttribute('data-intro', 'pending');
    // Typing would otherwise be announced one character at a time.
    var o = document.getElementById('widget-output');
    if (o) o.setAttribute('aria-live', 'off');
  })();
</script>

<script>
  (function () {
    const widget = document.getElementById('terminal-widget') as HTMLElement | null;
    const output = document.getElementById('widget-output') as HTMLElement | null;
    const input = document.getElementById('widget-input') as HTMLInputElement | null;
    const twDisplay = document.getElementById('widget-typewriter-display') as HTMLElement | null;
    if (!widget || !output || !input) return;
    if (!widget.hasAttribute('data-scripted')) {
      // Unscripted widget: no replay, hand over the prompt straight away.
      twDisplay?.classList.add('hidden');
      input.classList.remove('hidden');
      return;
    }

    const rows = Array.from(output.querySelectorAll<HTMLElement>('[data-script-row]'));
    const timers: number[] = [];
    let done = false;

    function later(fn: () => void, ms: number) {
      timers.push(window.setTimeout(fn, ms));
    }

    // Hand control to the visitor. Never focuses: that would steal focus and
    // could scroll the page. Focus comes from the visitor's own click or tap.
    function finish() {
      if (done) return;
      done = true;
      timers.forEach((t) => clearTimeout(t));
      rows.forEach((row) => {
        row.style.visibility = '';
        row.querySelector('[data-type-cursor]')?.remove();
        const cmdEl = row.querySelector<HTMLElement>('[data-cmd]');
        if (cmdEl) cmdEl.textContent = cmdEl.dataset.cmd ?? '';
      });
      widget!.removeAttribute('data-intro');
      output!.setAttribute('aria-live', 'polite');
      widget!.setAttribute('data-intro-done', '');
      twDisplay?.classList.add('hidden');
      input!.classList.remove('hidden');
    }

    if (!widget.hasAttribute('data-intro')) {
      finish(); // reduced motion: final state immediately
      return;
    }

    function reveal(row: HTMLElement) {
      row.style.visibility = 'visible';
      // Keep the newest line in view inside the terminal only (not the page).
      const bottom = row.offsetTop + row.offsetHeight - output!.offsetTop;
      if (bottom > output!.scrollTop + output!.clientHeight) {
        output!.scrollTop = bottom - output!.clientHeight + 16;
      }
    }

    function play(i: number) {
      if (done) return;
      if (i >= rows.length) { later(finish, 250); return; }
      const row = rows[i];
      const cmdEl = row.querySelector<HTMLElement>('[data-cmd]');
      if (row.dataset.scriptRow !== 'echo' || !cmdEl) {
        reveal(row);
        later(() => play(i + 1), 45);
        return;
      }
      const cmd = cmdEl.dataset.cmd ?? '';
      cmdEl.textContent = '';
      const cursor = document.createElement('span');
      cursor.setAttribute('data-type-cursor', '');
      cursor.setAttribute('aria-hidden', 'true');
      cursor.className = 'inline-block align-middle w-1.75 h-3.25 bg-accent animate-[termBlink_1s_step-end_infinite]';
      row.appendChild(cursor);
      reveal(row);
      let n = 0;
      const type = () => {
        if (done) return;
        n++;
        cmdEl.textContent = cmd.slice(0, n);
        if (n < cmd.length) later(type, 45);
        else later(() => { cursor.remove(); play(i + 1); }, 260);
      };
      later(type, i === 0 ? 350 : 380);
    }

    // Skip to the end if the visitor reaches for the terminal mid-intro.
    widget.addEventListener('pointerdown', (e) => {
      if (done) return;
      const onLink = (e.target as HTMLElement).closest('a');
      finish();
      if (!onLink) queueMicrotask(() => input.focus());
    });

    // Start when the terminal is on screen (it may sit below the fold on phones).
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((en) => en.isIntersecting)) {
        observer.disconnect();
        play(0);
      }
    }, { threshold: 0.25 });
    observer.observe(widget);
  })();
</script>

<style is:global>
  #terminal-widget[data-intro] [data-script-row] { visibility: hidden; }
  #terminal-widget .group:hover .traffic-light-glyph { opacity: 1 !important; }
  /* Terminal widget — immersive palette. Text tokens (ink/mute/faint) all clear
     WCAG AA 4.5:1 on bg, surface and code; line/line-soft stay dim for borders. */
  #terminal-widget[data-theme="green"] {
    --color-bg: #0a0a0a; --color-surface: #111111; --color-code: #050505;
    --color-ink: #33ff33; --color-mute: #18aa18; --color-faint: #159315;
    --color-accent: #00ff88; --color-line: #1a661a; --color-line-soft: #0f2a0f;
  }
  #terminal-widget[data-theme="amber"] {
    --color-bg: #0d0800; --color-surface: #1a1000; --color-code: #080400;
    --color-ink: #ffb000; --color-mute: #bb8a1b; --color-faint: #a37817;
    --color-accent: #ffcc44; --color-line: #664a00; --color-line-soft: #3d2c00;
  }
  #terminal-widget[data-theme="ice"] {
    --color-bg: #060d14; --color-surface: #0d1a26; --color-code: #030a10;
    --color-ink: #7dd3fc; --color-mute: #26a1db; --color-faint: #1f8bbe;
    --color-accent: #38bdf8; --color-line: #1e3a4f; --color-line-soft: #102030;
  }
  /* Light-mode overrides for terminal widget color themes */
  html:not(.dark) #terminal-widget[data-theme="green"] {
    --color-bg: #f0fdf4; --color-surface: #ffffff; --color-code: #e8fdf0;
    --color-ink: #175332; --color-mute: #296b47; --color-faint: #377e57;
    --color-accent: #1f6f43; --color-line: #bbdece; --color-line-soft: #d5eed9;
  }
  html:not(.dark) #terminal-widget[data-theme="amber"] {
    --color-bg: #fffbf0; --color-surface: #ffffff; --color-code: #fff8e6;
    --color-ink: #674000; --color-mute: #83560f; --color-faint: #97671b;
    --color-accent: #9a5f00; --color-line: #e8d5a3; --color-line-soft: #f0e4c0;
