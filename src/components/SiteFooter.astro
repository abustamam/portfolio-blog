---
// SiteFooter.astro. `plain` drops the developer in-jokes for the AI training pages.
interface Props { plain?: boolean }
const { plain = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="px-gutter py-7 border-t border-line bg-surface font-mono text-13 text-mute flex flex-col items-start gap-4 lg:flex-row lg:justify-between lg:items-center lg:flex-nowrap">
  <div class="flex gap-5 items-center flex-wrap">
    <span>© {year} bustamam.tech</span>
    <a href="/ai-training/" class="text-mute no-underline">ai training</a>
    <a href="/rss.xml" class="text-mute no-underline">rss</a>
    <a href="/feed.json" class="text-mute no-underline">json feed</a>
    <a href="/colophon" class="text-mute no-underline">colophon</a>
    <span class="text-faint" data-counting-line>no cookies or trackers · page counts come from server logs</span>
  </div>
  {plain ? (
    <div class="flex gap-5 items-center flex-wrap">
      <span class="text-faint">taught by Rasheed Bustamam</span>
      <a href="/about" class="text-mute no-underline">about me</a>
      <a href="/contact" class="text-mute no-underline">contact</a>
    </div>
  ) : (
  <div class="flex gap-5 items-center flex-wrap max-lg:flex-col max-lg:items-start">
    <span class="text-faint">built with astro · one-person practice</span>
    <span class="inline-flex items-center gap-1.5">
      <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
      all systems nominal
    </span>
  </div>
  )}
</footer>
