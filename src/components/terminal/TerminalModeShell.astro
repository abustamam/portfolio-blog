---
import { getCollection } from 'astro:content';
import { isPublished } from '../../utils/content';
import type { SiteTerminalData } from './terminal-types';

interface Props {
  initialPath?: string;
}
const { initialPath = '/writing' } = Astro.props;

const blogRaw = await getCollection('blog', ({ data }) => isPublished(data));
const blog: SiteTerminalData['blog'] = blogRaw.map((p) => ({
	id: p.id,
	title: p.data.title,
	body: typeof p.body === 'string' ? p.body : '',
	pubDate: p.data.pubDate.toISOString().slice(0, 10),
	tag: p.data.tag,
	readMin: p.data.readMin,
	words: p.data.words,
}));

const seriesRaw = await getCollection('series', ({ data }) => isPublished(data));
const series: SiteTerminalData['series'] = seriesRaw.map((s) => ({
	id: s.id,
	title: s.data.title,
}));

const workRaw = await getCollection('work', ({ data }) => isPublished(data));
const work: SiteTerminalData['work'] = workRaw.map((w) => ({
	id: w.id,
	company: w.data.company,
	role: w.data.role,
	period: w.data.period,
}));

const terminalData: SiteTerminalData = { blog, series, work };
const terminalJson = JSON.stringify(terminalData).replace(/</g, '\\u003c');
---

<section
  id="terminal-mode-shell"
  class="fixed inset-x-0 top-0 z-50 hidden flex flex-col bg-bg text-ink font-mono"
  style="height: 100dvh"
  aria-hidden="true"
  aria-label="Simulated terminal"
  data-initial-path={initialPath}
>
  <div id="terminal-live" class="sr-only" aria-live="polite"></div>
  <div class="h-9 border-b border-line bg-surface flex items-center justify-between px-3.5 text-11 text-mute">
    <div class="flex items-center gap-1.5">
      <button
        id="terminal-minimize-btn"
        type="button"
        class="p-3 -m-3 flex items-center justify-center"
        aria-label="Minimize terminal mode"
      >
        <span id="terminal-dot-1" class="w-2 h-2 rounded-full border border-line pointer-events-none bg-faint"></span>
      </button>
      <span id="terminal-dot-2" class="w-2 h-2 rounded-full border border-line bg-faint"></span>
      <span id="terminal-dot-3" class="w-2 h-2 rounded-full border border-line bg-faint"></span>
    </div>
    <div class="font-mono tracking-tight text-ink min-w-0 px-3 overflow-hidden text-ellipsis whitespace-nowrap">
      terminal <span class="text-faint">·</span> <span id="terminal-top-path">~</span>
    </div>
    <div class="font-mono text-10 uppercase tracking-snug text-faint">simulated</div>
  </div>
  <div
    id="terminal-output"
    class="min-h-0 flex-1 overflow-auto border-b border-line p-4 text-xs leading-relaxed whitespace-pre-wrap"
  ></div>
  <div
    id="terminal-pager"
    class="hidden min-h-0 shrink-0 flex-col border-b border-line bg-bg"
    role="document"
    aria-label="Output pager"
  >
    <pre
      id="terminal-pager-body"
      class="flex-1 overflow-auto p-4 font-mono text-xs leading-relaxed text-ink whitespace-pre-wrap"
    ></pre>
    <div
      id="terminal-pager-meta"
      class="border-t border-line px-4 font-mono text-[10px] text-mute flex items-center justify-between gap-2"
    >
      <button
        id="terminal-pager-prev"
        type="button"
        class="min-h-[44px] px-4 text-mute hover:text-ink disabled:opacity-40 disabled:cursor-default"
        aria-label="Previous page"
      >‹ prev</button>
      <span id="terminal-pager-hint" class="text-center flex-1"></span>
      <button
        id="terminal-pager-next"
        type="button"
        class="min-h-[44px] px-4 text-mute hover:text-ink disabled:opacity-40 disabled:cursor-default"
        aria-label="Next page"
      >next ›</button>
    </div>
  </div>
  <form id="terminal-prompt-form" class="shrink-0 flex h-12 items-center gap-2 border-t border-line px-4">
    <span id="terminal-cwd" class="shrink-0 text-accent"></span>
    <div class="flex items-center flex-1 min-w-0 relative">
      <input
        id="terminal-input"
        type="text"
        class="flex-1 border-none bg-transparent text-xs text-ink outline-none"
        style="caret-color: transparent"
        autocomplete="off"
        spellcheck="false"
        aria-label="Terminal command line"
      />
      <span
        id="terminal-cursor"
        class="absolute left-0 top-1/2 -translate-y-1/2 w-1.75 h-3.25 bg-accent animate-[termBlink_1s_step-end_infinite]"
        aria-hidden="true"
      ></span>
    </div>
  </form>
</section>

<script
  type="application/json"
  id="terminal-site-data"
  is:inline
  set:html={terminalJson}
></script>

<script>
  import { runCommandLine } from './terminal-commands';
  import { getCompletion } from './terminal-completion';
  import {
	handlePagerKey,
	pageUp,
	pageDown,
	shouldUsePager,
	sliceVisible,
	type PagerState,
  } from './terminal-pager';
  import type { SiteTerminalData, TerminalState } from './terminal-types';

  function chromePathToCwd(path: string): string {
	const p = (path || '/').replace(/\/+$/, '') || '/';
	if (p === '/') return '~';
	const segs = p.split('/').filter(Boolean);
	return `~/${segs.join('/')}`;
  }

  function readSiteData(): SiteTerminalData | null {
	const el = document.getElementById('terminal-site-data');
	if (!el?.textContent) return null;
	try {
		return JSON.parse(el.textContent) as SiteTerminalData;
	} catch {
		return null;
	}
  }

  function pagerPageSize(): number {
	const h = window.visualViewport?.height ?? window.innerHeight;
	const approx = Math.floor((h * 0.75) / 18);
	return Math.max(12, Math.min(approx, 80));
  }

  (function () {
	const shellEl = document.getElementById('terminal-mode-shell');
	const liveEl = document.getElementById('terminal-live');
	const cwdEl = document.getElementById('terminal-cwd');
	const inputEl = document.getElementById('terminal-input');
	const outputEl = document.getElementById('terminal-output');
	const topPathEl = document.getElementById('terminal-top-path');
	const minimizeBtn = document.getElementById('terminal-minimize-btn');
	const formEl = document.getElementById('terminal-prompt-form');
	const expandBtn = document.getElementById('terminal-expand-btn');
	const inertSiblings = document.getElementById('terminal-inert-siblings');
	const pagerWrap = document.getElementById('terminal-pager');
	const pagerBody = document.getElementById('terminal-pager-body');
	const pagerMeta = document.getElementById('terminal-pager-meta');
	const pagerPrev = document.getElementById('terminal-pager-prev') as HTMLButtonElement | null;
	const pagerNext = document.getElementById('terminal-pager-next') as HTMLButtonElement | null;
  const pagerHint = document.getElementById('terminal-pager-hint') as HTMLElement | null;
  const cursorEl = document.getElementById('terminal-cursor') as HTMLElement | null;

  if (!shellEl || !liveEl || !cwdEl || !inputEl || !outputEl || !topPathEl || !formEl || !pagerWrap || !pagerBody || !pagerMeta) return;

	const shell = shellEl as HTMLElement;
	const live = liveEl as HTMLElement;
	const cwd = cwdEl as HTMLElement;
	const input = inputEl as HTMLInputElement;
	const output = outputEl as HTMLElement;
	const topPath = topPathEl as HTMLElement;
	const form = formEl as HTMLFormElement;
	const pager = pagerWrap as HTMLElement;
	const pBody = pagerBody as HTMLElement;
	const pMeta = pagerMeta as HTMLElement;

	const chromePath = shell.dataset.initialPath || '/writing';
	const rawSite = readSiteData();
	if (rawSite === null) return;
	const siteData: SiteTerminalData = rawSite;

	let state: TerminalState = { cwd: chromePathToCwd(chromePath) };
	let pagerState: PagerState | null = null;
	let historyBuffer: string[] = [];
	let historyIndex = -1;
	let historyDraft = '';
	let isOpen = false;
	let lastFocus: Element | null = null;

	function lsGet(key: string): string | null {
		try { return localStorage.getItem(key); } catch { return null; }
	}
	function lsSet(key: string, value: string): void {
		try { localStorage.setItem(key, value); } catch { /* private browsing */ }
	}

	function announce(msg: string) {
		live.textContent = '';
		requestAnimationFrame(() => {
			live.textContent = msg;
		});
	}

	function setExpandButtonState(open: boolean) {
		if (!expandBtn) return;
		expandBtn.setAttribute('aria-pressed', open ? 'true' : 'false');
		expandBtn.setAttribute('aria-label', open ? 'Exit terminal mode' : 'Enter terminal mode');
		const label = expandBtn.querySelector('[data-terminal-expand-label]');
		if (label) label.textContent = 'Terminal';
	}

	function renderCwd() {
		cwd.textContent = `${state.cwd} $`;
		topPath.textContent = state.cwd;
	}

	// Cursor tracking — position block cursor at caret
	let _measureSpan: HTMLSpanElement | null = null;
	function syncCursor(text: string, pos?: number) {
		if (!cursorEl) return;
		const slice = pos !== undefined ? text.slice(0, pos) : text;
		if (!slice) { cursorEl.style.left = '0px'; return; }
		if (!_measureSpan) {
			_measureSpan = document.createElement('span');
			_measureSpan.style.visibility = 'hidden';
			_measureSpan.style.position = 'absolute';
			_measureSpan.style.whiteSpace = 'pre';
			_measureSpan.style.font = getComputedStyle(input).font;
			form.appendChild(_measureSpan);
		}
		_measureSpan.textContent = slice;
		cursorEl.style.left = `${_measureSpan.offsetWidth}px`;
	}

	function appendLine(text: string, className = 'text-mute') {
		const row = document.createElement('div');
		row.className = `mb-0.5 font-mono text-xs ${className}`;
		row.textContent = text;
		output.appendChild(row);
		output.scrollTop = output.scrollHeight;
	}

	function appendEcho(line: string) {
		appendLine(`${state.cwd} $ ${line}`, 'text-ink');
	}

	function clearOutput() {
		output.textContent = '';
	}

	function renderPagerView() {
		if (!pagerState) return;
		const visible = sliceVisible(pagerState);
		pBody.textContent = visible.join('\n');
		const end = Math.min(pagerState.offset + visible.length, pagerState.lines.length);
		const hint = `${pagerState.offset + 1}–${end} of ${pagerState.lines.length} · arrows hjkl · q quit`;
		if (pagerHint) pagerHint.textContent = hint;
		pMeta.setAttribute('aria-label', hint);
		if (pagerPrev) pagerPrev.disabled = pagerState.offset === 0;
		if (pagerNext) pagerNext.disabled = end >= pagerState.lines.length;
	}

	function openPager(lines: string[]) {
		output.classList.add('hidden');
		pager.classList.remove('hidden');
		pager.classList.remove('shrink-0');
		pager.classList.add('flex-1', 'flex');
		input.disabled = true;
		pagerState = { lines, offset: 0, pageSize: pagerPageSize() };
		renderPagerView();
		announce('Pager open. Use arrows or hjkl. Press q to close.');
	}

	function closePager() {
		pagerState = null;
		pager.classList.add('hidden', 'shrink-0');
		pager.classList.remove('flex-1', 'flex');
		pBody.textContent = '';
		if (pagerHint) pagerHint.textContent = '';
		if (pagerPrev) pagerPrev.disabled = false;
		if (pagerNext) pagerNext.disabled = false;
		pMeta.removeAttribute('aria-label');
		output.classList.remove('hidden');
		input.disabled = false;
		queueMicrotask(() => input.focus());
		announce('Pager closed');
	}

	function syncViewportHeight() {
		if (!isOpen) return;
		const h = window.visualViewport?.height ?? window.innerHeight;
		shell.style.height = `${h}px`;
	}

	function applyTheme(name: string) {
		if (name === 'inherit') {
			shell.removeAttribute('data-theme');
		} else {
			shell.setAttribute('data-theme', name);
		}
	}

	function openMode() {
    if (isOpen) return;
    lastFocus = document.activeElement;
    isOpen = true;
    // Start off-screen + transparent for slide-up animation
    shell.style.transform = 'translateY(20px)';
    shell.style.opacity = '0';
    shell.classList.remove('hidden');
    // Force reflow so the transition triggers
    shell.offsetHeight;
    shell.style.transition = 'transform 0.25s ease-out, opacity 0.25s ease-out';
    shell.style.transform = 'translateY(0)';
    shell.style.opacity = '1';
    shell.setAttribute('aria-hidden', 'false');
    shell.setAttribute('aria-modal', 'true');
    inertSiblings?.setAttribute('inert', '');
    document.documentElement.classList.add('terminal-mode');
    // Consume widget session lines (one-shot handoff from TerminalWidget)
    // Try direct widget element first (for hotkey/programmatic opens), then fallback to localStorage
    let sessionLines: { text: string; cls: string }[] | null = null;
    const widgetEl = document.getElementById('terminal-widget') as any;
    if (widgetEl?.__terminal?.outputBuffer) {
      sessionLines = widgetEl.__terminal.outputBuffer;
      // Do NOT clear — widget may still be used after closing full-screen
    }
    if (!sessionLines) {
      const lsLines = lsGet('terminal:session-lines');
      if (lsLines) {
        try {
          sessionLines = JSON.parse(lsLines) as { text: string; cls: string }[];
        } catch { /* malformed — skip */ }
        try { localStorage.removeItem('terminal:session-lines'); } catch { /* private browsing */ }
      }
    }
    if (sessionLines) {
      for (const { text, cls } of sessionLines) appendLine(text, cls);
    }
    // Pre-populate history from widget session (persists — not deleted)
    if (widgetEl?.__terminal?.historyBuffer?.length) {
      historyBuffer = [...widgetEl.__terminal.historyBuffer];
    }
    if (historyBuffer.length === 0) {
      const sessionHistoryRaw = lsGet('terminal:history');
      if (sessionHistoryRaw) {
        try {
          const hist = JSON.parse(sessionHistoryRaw) as string[];
          if (hist.length > 0) historyBuffer = hist;
        } catch { /* malformed JSON — skip */ }
      }
    }
    // Restore cwd/theme from widget state if present
    if (widgetEl?.__terminal?.state) {
      const ws = widgetEl.__terminal.state;
      if (ws.cwd !== state.cwd) {
        state.cwd = ws.cwd;
      }
      if (widgetEl?.getAttribute('data-theme')) {
        applyTheme(widgetEl.getAttribute('data-theme')!);
      }
    }
    renderCwd();
    announce('Terminal mode on');
    setExpandButtonState(true);
    queueMicrotask(() => input.focus());
    syncViewportHeight();
    lsSet('terminal:open', '1');
  }

  function closeMode() {
    if (!isOpen) return;
    if (pagerState) closePager();
    historyIndex = -1;
    historyDraft = '';
    isOpen = false;
    lsSet('terminal:open', '0');
    // Fade out before hiding
    shell.style.transition = 'transform 0.15s ease-in, opacity 0.15s ease-in';
    shell.style.transform = 'translateY(10px)';
    shell.style.opacity = '0';
    setTimeout(() => {
      // Sync state back to widget before it fades back in
      const widgetEl = document.getElementById('terminal-widget') as any;
      if (widgetEl?.__terminal) {
        widgetEl.__terminal.historyBuffer = [...historyBuffer];
        lsSet('terminal:cwd', state.cwd);
        const currentTheme = shell.getAttribute('data-theme');
        if (currentTheme) {
          widgetEl.setAttribute('data-theme', currentTheme);
          lsSet('terminal:theme', currentTheme);
        } else {
          widgetEl.removeAttribute('data-theme');
          lsSet('terminal:theme', 'inherit');
        }
      }
      shell.style.height = '100dvh';
      shell.classList.add('hidden');
      shell.style.boxShadow = '';
      shell.setAttribute('aria-hidden', 'true');
      shell.removeAttribute('aria-modal');
      shell.removeAttribute('style');
      inertSiblings?.removeAttribute('inert');
      document.documentElement.classList.remove('terminal-mode');
      announce('Terminal mode off');
      setExpandButtonState(false);
      window.dispatchEvent(new CustomEvent('terminal:closed'));
      const prev = lastFocus;
      if (prev instanceof HTMLElement) {
        queueMicrotask(() => prev.focus());
      }
      lastFocus = null;
    }, 160);
  }

	function toggleMode() {
		if (isOpen) closeMode();
		else openMode();
	}

	function flushLines(lines: string[]) {
		for (const ln of lines) {
			if (ln === '__CLEAR__') clearOutput();
			else appendLine(ln, 'text-ink');
		}
	}

	function runLine(raw: string) {
		const line = raw.trim();
		if (!line) return;
		appendEcho(line);
		const prevCwd = state.cwd;
		const result = runCommandLine(line, state, siteData);
		state = result.next;
		renderCwd();

		if (state.cwd !== prevCwd) {
			lsSet('terminal:cwd', state.cwd);
		}

		if (result.setTheme) {
			applyTheme(result.setTheme);
			lsSet('terminal:theme', result.setTheme);
		}

		if (result.navigateTo) {
			window.location.href = result.navigateTo;
			return;
		}
		if (result.closeTerminal) {
			flushLines(result.lines.filter((l) => l !== '__CLEAR__'));
			closeMode();
			return;
		}

		const cleared = result.lines.includes('__CLEAR__');
		if (cleared) clearOutput();
		const bodyLines = result.lines.filter((l) => l !== '__CLEAR__');

		if (bodyLines.length > 0 && shouldUsePager(bodyLines)) {
			openPager(bodyLines);
			return;
		}

		flushLines(result.lines);
		queueMicrotask(() => input.focus());
	}

	// Track typing for cursor position
	input.addEventListener('input', () => syncCursor(input.value, input.selectionStart ?? undefined));

	// Arrow left/right for cursor tracking
	input.addEventListener('keyup', (e: KeyboardEvent) => {
		if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
			syncCursor(input.value, input.selectionStart ?? undefined);
		}
	});
	input.addEventListener('click', () => {
		syncCursor(input.value, input.selectionStart ?? undefined);
	});

	// Click output area → focus input
	output.addEventListener('click', () => {
		input.focus();
	});

	// Focus indicator: border + traffic lights
	const dot1 = document.getElementById('terminal-dot-1') as HTMLElement | null;
	const dot2 = document.getElementById('terminal-dot-2') as HTMLElement | null;
	const dot3 = document.getElementById('terminal-dot-3') as HTMLElement | null;
	function setFocused(on: boolean) {
		shell.style.transition = 'box-shadow 0.2s ease';
		shell.style.boxShadow = on ? 'inset 0 0 0 2px var(--color-accent)' : '';
		if (dot1) dot1.className = on
			? 'w-2 h-2 rounded-full border border-line pointer-events-none bg-danger'
			: 'w-2 h-2 rounded-full border border-line pointer-events-none bg-faint';
		if (dot2) dot2.className = on
			? 'w-2 h-2 rounded-full border border-line bg-mute'
			: 'w-2 h-2 rounded-full border border-line bg-faint';
		if (dot3) dot3.className = on
			? 'w-2 h-2 rounded-full border border-line bg-accent'
			: 'w-2 h-2 rounded-full border border-line bg-faint';
	}

	// Focus/blur: toggle cursor visibility
	input.addEventListener('focus', () => {
		if (cursorEl) cursorEl.style.display = '';
		setFocused(true);
		syncCursor(input.value, input.selectionStart ?? undefined);
	});
	input.addEventListener('blur', () => {
		if (cursorEl) cursorEl.style.display = 'none';
		setFocused(false);
	});

	// Start hidden — shown on first focus
	if (cursorEl) cursorEl.style.display = 'none';
	// Show focused state immediately on open
	setFocused(true);

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		const mod = e.metaKey || e.ctrlKey;
		if (mod && e.shiftKey && e.key.toLowerCase() === 't') {
			e.preventDefault();
			if (isOpen && pagerState) closePager();
			toggleMode();
			return;
		}
		if (!isOpen) return;
		if (pagerState) {
			const next = handlePagerKey(e, pagerState);
			if (next === null) {
				closePager();
				queueMicrotask(() => input.focus());
			} else {
				pagerState = next;
				renderPagerView();
			}
			return;
		}
		// Ctrl+L — clear output
		if (e.ctrlKey && !e.shiftKey && e.key === 'l') {
			e.preventDefault();
			clearOutput();
			syncCursor('');
			queueMicrotask(() => input.focus());
			return;
		}
		// Ctrl+C — cancel current input line
		if (e.ctrlKey && !e.shiftKey && e.key === 'c') {
			e.preventDefault();
			input.value = '';
			syncCursor('');
			historyIndex = -1;
			historyDraft = '';
			return;
		}
		// Tab — command/path completion
		if (e.key === 'Tab') {
			e.preventDefault();
			const result = getCompletion(input.value, state.cwd, siteData);
			input.value = result.completed;
			if (result.matches.length > 1) {
				appendLine(result.matches.join('  '), 'text-mute');
			}
			queueMicrotask(() => {
				input.selectionStart = input.selectionEnd = input.value.length;
				syncCursor(input.value);
			});
			return;
		}
		// Command history traversal (only when terminal is open and pager is not active)
		if (e.key === 'ArrowUp' && historyBuffer.length > 0) {
			e.preventDefault();
			if (historyIndex === -1) historyDraft = input.value;
			historyIndex = Math.min(historyIndex + 1, historyBuffer.length - 1);
			input.value = historyBuffer[historyBuffer.length - 1 - historyIndex];
			queueMicrotask(() => { input.selectionStart = input.selectionEnd = input.value.length; syncCursor(input.value); });
		}
		if (e.key === 'ArrowDown' && historyIndex >= 0) {
			e.preventDefault();
			historyIndex--;
			input.value = historyIndex === -1 ? historyDraft : historyBuffer[historyBuffer.length - 1 - historyIndex];
			queueMicrotask(() => { input.selectionStart = input.selectionEnd = input.value.length; syncCursor(input.value); });
		}
	});

	// Reset cursor on submit
	form.addEventListener('submit', () => {
		syncCursor('');
	});

	window.addEventListener('terminal:toggle', () => {
		toggleMode();
	});

	window.addEventListener('terminal:open', () => {
		if (!isOpen) openMode();
	});

	expandBtn?.addEventListener('click', () => {
		window.dispatchEvent(new CustomEvent('terminal:toggle'));
	});
	minimizeBtn?.addEventListener('click', () => closeMode());
	pagerPrev?.addEventListener('click', () => {
		if (!pagerState) return;
		pagerState = pageUp(pagerState);
		renderPagerView();
	});
	pagerNext?.addEventListener('click', () => {
		if (!pagerState) return;
		pagerState = pageDown(pagerState);
		renderPagerView();
	});

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		if (pagerState) return;
		const line = input.value;
		if (line.trim()) {
			historyBuffer.push(line.trim());
			historyIndex = -1;
			historyDraft = '';
		}
		input.value = '';
		runLine(line);
	});

	const savedCwd = lsGet('terminal:cwd');
	const savedTheme = lsGet('terminal:theme');
	const savedOpen = lsGet('terminal:open');
	if (savedCwd) state = { cwd: savedCwd };
	if (savedTheme) applyTheme(savedTheme);
	if (savedOpen === '1') openMode();

	setExpandButtonState(false);
	renderCwd();

	if (window.visualViewport) {
		window.visualViewport.addEventListener('resize', syncViewportHeight);
		window.visualViewport.addEventListener('scroll', syncViewportHeight);
	}
  })();
</script>

<style is:global>
  html.terminal-mode {
    overflow: hidden;
  }
  #terminal-input {
    font-size: 16px;
  }

  /* Green (CRT) theme */
  #terminal-mode-shell[data-theme="green"] {
    --color-bg: #0a0a0a;
    --color-surface: #111111;
    --color-code: #050505;
    --color-ink: #33ff33;
    --color-mute: #1a661a;
