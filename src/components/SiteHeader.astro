---
// SiteHeader.astro — responsive primary nav + drawer below lg
import BrandLogo from './BrandLogo.astro';
---

<header class="border-b border-line bg-bg">
  <div class="px-gutter py-5.5 flex items-center justify-between gap-4 min-w-0">
    <!-- Brand -->
    <div class="flex items-center gap-3.5 min-w-0">
      <a href="/" class="flex items-center no-underline min-w-0 py-2">
        <BrandLogo />
      </a>
      <div class="h-3.5 w-px bg-line mx-1 shrink-0"></div>
      <div class="hidden sm:block font-mono text-11 text-mute shrink-0">/journal</div>
    </div>

    <button
      type="button"
      class="lg:hidden shrink-0"
      id="site-nav-open"
      aria-expanded="false"
      aria-controls="site-nav-panel"
      aria-label="Open menu"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round"/>
      </svg>
    </button>

    <nav class="hidden lg:flex items-center gap-7 font-mono text-xs" aria-label="Primary">
      <a href="/writing" class="text-ink no-underline">writing</a>
      <a href="/work" class="text-mute no-underline">work</a>
      <a href="/about" class="text-mute no-underline">about</a>
      <a href="/contact" class="text-mute no-underline">contact</a>
      <div class="flex items-center gap-1.5 py-1.25 px-2.5 border border-line rounded-sm text-faint text-11 cursor-default">
        <svg width="10" height="10" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10.5 10.5l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>search</span>
        <span class="text-10 py-px px-1.25 bg-kbd rounded-sm text-mute">⌘K</span>
      </div>
    </nav>
  </div>
</header>

<button type="button" id="site-nav-backdrop" class="site-nav-backdrop" hidden aria-label="Close menu"></button>

<div
  id="site-nav-panel"
  class="site-nav-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="site-nav-title"
  hidden
>
  <p id="site-nav-title" class="sr-only">Site navigation</p>
  <div class="flex items-center justify-between gap-4 mb-2">
    <span class="font-mono text-xs text-faint tracking-loose uppercase">menu</span>
    <button type="button" class="site-nav-panel__close font-mono text-xs py-2 px-3 border border-line rounded-sm bg-surface text-ink cursor-pointer" aria-label="Close menu">
      close
    </button>
  </div>
  <nav class="flex flex-col gap-1 font-mono text-sm" aria-label="Mobile primary">
    <a href="/writing" class="text-ink no-underline py-3 border-b border-line-soft">writing</a>
    <a href="/work" class="text-ink no-underline py-3 border-b border-line-soft">work</a>
    <a href="/about" class="text-ink no-underline py-3 border-b border-line-soft">about</a>
    <a href="/contact" class="text-ink no-underline py-3 border-b border-line-soft">contact</a>
  </nav>
  <div class="mt-5">
    <label for="nav-search-input" class="font-mono text-10 text-faint tracking-caps uppercase block mb-2">search posts</label>
    <input
      id="nav-search-input"
      type="search"
      enterkeyhint="search"
      placeholder="grep titles, tags…"
      autocomplete="off"
      class="w-full box-border py-2.5 px-3 border border-line rounded-sm bg-surface font-mono text-13 text-ink"
    />
  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById('site-nav-open');
    const panel = document.getElementById('site-nav-panel');
    const backdrop = document.getElementById('site-nav-backdrop');
    const closeBtn = document.querySelector('.site-nav-panel__close');
    const navInput = document.getElementById('nav-search-input');
    const mainSearch = document.getElementById('search-input');
    if (!btn || !panel || !backdrop) return;

    function focusables() {
      return Array.from(
        panel.querySelectorAll(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function openNav() {
      btn.setAttribute('aria-expanded', 'true');
      backdrop.removeAttribute('hidden');
      panel.removeAttribute('hidden');
      document.documentElement.classList.add('nav-open');
      const first = focusables()[0];
      if (first) first.focus();
    }

    function closeNav() {
      btn.setAttribute('aria-expanded', 'false');
      backdrop.setAttribute('hidden', '');
      panel.setAttribute('hidden', '');
      document.documentElement.classList.remove('nav-open');
      btn.focus();
    }

    function isOpen() {
      return btn.getAttribute('aria-expanded') === 'true';
    }

    btn.addEventListener('click', () => {
      if (isOpen()) closeNav();
      else openNav();
    });
    closeBtn?.addEventListener('click', closeNav);
    backdrop.addEventListener('click', closeNav);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        e.preventDefault();
        closeNav();
      }
      if (!isOpen() || e.key !== 'Tab') return;
      const list = focusables();
      if (list.length === 0) return;
      const first = list[0];
      const last = list[list.length - 1];
      const active = document.activeElement;
      if (e.shiftKey) {
        if (active === first) {
          e.preventDefault();
          last.focus();
        }
      } else {
        if (active === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });

    if (navInput && mainSearch) {
      const syncToMain = () => {
        mainSearch.value = navInput.value;
        mainSearch.dispatchEvent(new Event('input', { bubbles: true }));
      };
      const syncToNav = () => {
        navInput.value = mainSearch.value;
      };
      navInput.addEventListener('input', syncToMain);
      mainSearch.addEventListener('input', syncToNav);
    }

    navInput?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const path = window.location.pathname;
      const onWritingIndex = path === '/' || path === '' || path === '/writing' || path === '/writing/';
      if (onWritingIndex && mainSearch) {
        mainSearch.focus();
        closeNav();
        return;
      }
      try {
        sessionStorage.setItem('journal:focus-search', '1');
      } catch {
        /* ignore */
      }
      window.location.href = '/writing';
    });
  })();
</script>

<style>
  .site-header a[href="/"]:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>
