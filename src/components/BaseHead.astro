---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { CANONICAL_FAVICON_SVG, SOCIAL_FALLBACK_IMAGE } from '../consts/brand';
import { aiCardImage } from '../consts/aiCards';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	/** Ask search engines not to index this page (unlisted pages). Off by default. */
	noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Build-time card for writing/work/series detail pages (see src/pages/og/).
// Platforms need a PNG/JPEG at 1200x630, so this wins over a per-page `image`
// prop (hero covers and company logos are not social-card sized).
const cardMatch = Astro.url.pathname.match(/^\/(writing|work|series)\/([^/]+)\/?$/);
// The AI training pages have their own cards (src/consts/aiCards.ts).
const generated = cardMatch
	? `/og/${cardMatch[1]}/${cardMatch[2]}.png`
	: aiCardImage(Astro.url.pathname);

const { title, description, image = SOCIAL_FALLBACK_IMAGE, noindex = false } = Astro.props;
const imageUrl = generated ?? (typeof image === 'string' ? image : image.src);
const ogImage = new URL(imageUrl, Astro.site);
const isPng = ogImage.pathname.endsWith('.png');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href={CANONICAL_FAVICON_SVG} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1f2328" media="(prefers-color-scheme: dark)" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{isPng && <meta property="og:image:width" content="1200" />}
{isPng && <meta property="og:image:height" content="630" />}
{isPng && <meta property="og:image:type" content="image/png" />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- View transitions between pages: the browser's native cross-document
     transition, so no router script joins the critical path (Astro's
     <ClientRouter /> measured as an LCP regression on throttled loads; see
     the PR for #33). Opted in only when motion is welcome; with reduced
     motion, or in a browser without support, links are plain page loads.
     Inline, not in global.css: the new page must have the opt-in when it is
     first revealed, and an external stylesheet may still be loading then. -->
<style is:inline>
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
  }
</style>

<!-- Pre-paint: prevent brightness + color theme flash -->
<script is:inline>
  (function () {
    var brightness = localStorage.getItem('theme') || 'light';
    var color = localStorage.getItem('terminal:theme') || 'inherit';
    document.documentElement.classList.toggle('dark', brightness === 'dark');
    if (color !== 'inherit') {
      document.documentElement.setAttribute('data-color-theme', color);
    } else {
      document.documentElement.removeAttribute('data-color-theme');
    }
  })();
</script>
