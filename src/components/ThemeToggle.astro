---
// ThemeToggle.astro — no props
---

<button
  id="theme-toggle"
  aria-label="Toggle theme"
  style="background:transparent; border:1px solid var(--line); color:var(--ink); cursor:pointer; font-family:var(--font-mono); font-size:10px; padding:3px 8px; border-radius:2px; letter-spacing:.05em; text-transform:uppercase;"
>
  <span class="theme-label-light">☾ dark</span>
  <span class="theme-label-dark" style="display:none">☀ light</span>
</button>

<!-- Pre-paint: runs before CSS, prevents flash -->
<script is:inline>
  (function() {
    var saved = localStorage.getItem('theme');
    var theme = saved === 'dark' ? 'dark' : 'light';
    document.documentElement.classList.toggle('dark', theme === 'dark');
  })();
</script>

<script>
  function initThemeToggle() {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var labelLight = btn.querySelector('.theme-label-light');
    var labelDark = btn.querySelector('.theme-label-dark');

    function applyTheme(theme) {
      document.documentElement.classList.toggle('dark', theme === 'dark');
      localStorage.setItem('theme', theme);
      var isDark = theme === 'dark';
      if (labelLight) labelLight.style.display = isDark ? 'none' : 'inline';
      if (labelDark) labelDark.style.display = isDark ? 'inline' : 'none';
    }

    // Sync initial state with whatever the inline script set
    var current = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
    applyTheme(current);

    btn.addEventListener('click', function() {
      var next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      applyTheme(next);
    });
  }

  initThemeToggle();
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
