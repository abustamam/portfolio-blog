---
interface Props {
	draft?: boolean;
}

const { draft } = Astro.props;
---

{draft && (
	<span class="inline-block py-0.5 px-2 mr-2 text-xs font-semibold text-amber-700 bg-amber-50 border border-amber-400 rounded align-middle uppercase tracking-wider dark:text-amber-400 dark:bg-amber-400/12 dark:border-amber-400/40">
		Draft
	</span>
)}
